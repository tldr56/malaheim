---
// Les trois marches de l'offre PME : le kit, la relecture, l'accompagnement à l'heure au réel.
import { SITE } from '../config';
interface Props {
  kitLabel?: string;
  kitHref?: string;
  kitCta?: string;
  kitItems?: string[];
}
const {
  kitLabel = 'Le kit de consultation',
  kitHref = '/kits/',
  kitCta = 'Choisir mon kit',
  kitItems = ['Cahier des charges complet, prêt à envoyer', 'Scénarios de démonstration et grille de dépouillement', 'Check-list contractuelle et plan de recette', 'Satisfait ou remboursé 14 jours'],
} = Astro.props;
const check = '<svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="5 12.5 10 17 19 7.5"></polyline></svg>';
const contact = '/accompagnement/#contact';
const steps = [
  {
    n: '1', k: 'Vous avancez seul', t: kitLabel, price: SITE.kitPrice, unit: 'paiement unique',
    d: "Tout ce qu'il faut pour consulter les éditeurs sans service achats : le document fait le travail d'une équipe.",
    items: kitItems, cta: kitCta, href: kitHref, hi: true,
  },
  {
    n: '2', k: 'Un regard expert', t: 'La relecture', price: SITE.reviewPrice, unit: 'par cahier des charges',
    d: "Vous remplissez le kit, je le relis et je l'annote : exigences floues, volumétrie manquante, priorités mal placées, pièges contractuels.",
    items: ['Annotations sous 5 jours ouvrés', 'Une heure de visio pour corriger le tir', 'Prix du kit déduit de la relecture'], cta: 'Demander une relecture', href: contact, hi: false,
  },
  {
    n: '3', k: 'Quand vous en avez besoin', t: "L'accompagnement à l'heure", price: SITE.hourlyRate, unit: "de l'heure, au temps réellement passé",
    d: "Préparer les démonstrations, analyser les offres, négocier, piloter le démarrage : vous m'appelez pour ce qui compte et ne payez que le temps passé.",
    items: ['Décompte au quart d’heure, relevé détaillé chaque mois', 'Estimation écrite avant de commencer', 'Aucun dépassement sans votre accord', 'Sans engagement ni forfait minimum'], cta: 'En parler', href: contact, hi: false,
  },
];
const lags = ['', 'lag1', 'lag2'];
---
<div class="ladder">
  {steps.map((s, i) => (
    <div class={`card step sr-up ${lags[i]} ${s.hi ? 'card-hi step-hi' : ''}`}>
      <div class="row" style="gap: 10px; align-items: center">
        <span class="step-n">{s.n}</span>
        <span class="step-k">{s.k}</span>
      </div>
      <h3 class="step-t">{s.t}</h3>
      <div class="stack" style="gap: 2px">
        <span class="step-price">{s.price}</span>
        <span class="step-unit">{s.unit}</span>
      </div>
      <p class="step-d">{s.d}</p>
      <ul class="step-list">
        {s.items.map((it) => <li><Fragment set:html={check} /><span>{it}</span></li>)}
      </ul>
      <a class={`btn ${s.hi ? 'btn-gold' : 'btn-line'}`} href={s.href}>{s.cta}</a>
    </div>
  ))}
</div>

<style>
  .ladder { display: flex; flex-wrap: wrap; gap: 22px; align-items: stretch; }
  .step { position: relative; flex: 1 1 290px; padding: 30px 28px; display: flex; flex-direction: column; gap: 14px; }
  .step-hi { transform: translateY(-8px); }
  .step-n { width: 32px; height: 32px; border-radius: 50%; background: var(--ink); color: #fff; display: inline-flex; align-items: center; justify-content: center; font-family: var(--display); font-weight: 600; font-size: 15px; }
  .step-k { font-size: 12px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--gold-soft); }
  .step-t { font-size: 24px; }
  .step-price { font-size: 36px; font-weight: 600; color: var(--gold-soft); line-height: 1; }
  .step-unit { color: var(--dim); font-size: 14px; }
  .step-d { margin: 0; color: var(--muted); font-size: 15px; }
  .step-list { list-style: none; margin: 2px 0 8px; padding: 0; display: flex; flex-direction: column; gap: 9px; font-size: 15px; }
  .step-list li { display: flex; gap: 10px; align-items: flex-start; }
  .step-list li :global(svg) { flex: none; margin-top: 3px; color: var(--good); }
  .step .btn { margin-top: auto; align-self: flex-start; }
  @media (max-width: 520px) { .step-hi { transform: none; } }
</style>
