---
// Moteur commun des simulateurs : rendu des questions côté serveur, calcul et graphique côté navigateur.
import { SIMS, SIM_LIST, defaults, simulate, analyse, money } from '../lib/sims.js';
import { SITE, KITS } from '../config';
import Logo from './Logo.astro';
import ConsentDialog from './ConsentDialog.astro';

interface Props { slug: string }
const { slug } = Astro.props;
const model = SIMS[slug];
const kit = KITS.find((k) => k.sw === model.sw)!;
const groups = [...new Set(model.fields.map((f) => f.group))];
const bookHref = SITE.bookingUrl || '/accompagnement/#contact';
const kitHref = `/kits/${kit.page}/`;
const others = SIM_LIST.filter((m) => m.slug !== slug);
const preview = (m) => { const d = defaults(m); return simulate(m, d.i, d.a); };
const pos = (f) => (f.log ? Math.round((1000 * Math.log(f.value / f.min)) / Math.log(f.max / f.min)) : f.value);
const v3 = model.version === 3;
// Aperçu du résultat complet, calculé par le moteur sur l'exemple par défaut, affiché dès l'arrivée
const EX = (() => {
  if (!v3) return null;
  const d = defaults(model); const A: any = analyse(model, d.i, d.a); const r = A.r; const mc = r.mc;
  const rng = (lo: number, hi: number) => { const a = money(lo), b = money(hi); return a.endsWith(' k€') && b.endsWith(' k€') ? `${a.replace(' k€', '')} à ${b}` : `${a} à ${b}`; };
  const W = 150, Hh = 46;
  const bins = mc.hist.bins as number[]; const bmax = Math.max(...bins, 1);
  const cut = Math.floor(((r.initial - mc.hist.lo) / (mc.hist.hi - mc.hist.lo || 1)) * bins.length);
  const hist = bins.map((v, k) => ({ x: k * (W / bins.length), h: Math.max(1.5, (v / bmax) * Hh), over: k >= cut }));
  const step = Math.max(1, Math.round(r.cumCost.length / 40));
  const ser = (arr: number[]) => arr.filter((_, k) => k % step === 0 || k === arr.length - 1);
  const cc = ser(r.cumCost), cg = ser(r.cumGain); const cmax = Math.max(...cc, ...cg, 1);
  const line = (arr: number[]) => arr.map((v, k) => `${((k / (arr.length - 1)) * W).toFixed(1)},${(Hh - (v / cmax) * Hh).toFixed(1)}`).join(' ');
  const beX = r.breakEven ? (r.breakEven / r.cumCost.length) * W : null;
  const dom = [mc.hist.lo, mc.hist.hi]; const px = (v: number) => Math.max(0, Math.min(100, ((v - dom[0]) / (dom[1] - dom[0] || 1)) * 100));
  const b0 = (A.bench || [])[0];
  let mkt = null as any;
  if (b0 && b0.bands && b0.bands.length) {
    const lo = Math.min(...b0.bands.map((x: any) => x.lo)), hi = Math.max(...b0.bands.map((x: any) => x.hi));
    const f = (v: number) => b0.log ? (Math.log(Math.max(v, lo)) - Math.log(lo)) / (Math.log(hi) - Math.log(lo)) : (v - lo) / (hi - lo || 1);
    const mine = b0.bands.find((x: any) => x.mine) || b0.bands[0];
    const val = b0.fmt === 'money' ? money(b0.value) : b0.fmt === 'pct' ? `${(Math.round(b0.value * 10) / 10).toLocaleString('fr-FR')} %` : String(Math.round(b0.value));
    mkt = { label: b0.label, val, mine: mine.label, bands: b0.bands.map((x: any) => ({ l: f(x.lo) * 100, w: Math.max(2, (f(x.hi) - f(x.lo)) * 100), on: x === mine })), dot: Math.max(0, Math.min(100, f(b0.value) * 100)) };
  }
  const ex = model.fields.filter((f: any) => f.type === 'range').slice(0, 3).map((f: any) => `${Number(f.value).toLocaleString('fr-FR')} ${f.unit}`).join(', ');
  const wm = A.inaction.monthly;
  return {
    verdict: A.verdict, pWithin: Math.round(mc.pWithin * 100),
    budget: rng(mc.budget.p10, mc.budget.p90), central: money(r.initial), p90: money(mc.budget.p90), bl: px(mc.budget.p10), bw: px(mc.budget.p90) - px(mc.budget.p10), bc: px(r.initial),
    over: Math.round(mc.pOver * 100), hist, W, Hh,
    be: r.breakEven, net: money(r.net), netNeg: r.net < 0, costLine: line(cc), gainLine: line(cg), beX,
    mkt, wait: money(wm), waitYear: money(A.inaction.year), waitBars: Array.from({ length: 12 }, (_, k) => (k + 1) / 12),
    ex, factor: A.sens && A.sens[0] ? A.sens[0].label : '',
  };
})();
const H = model.horizon;
---
<ConsentDialog />
<div class="simx" data-slug={slug}>
  <nav class="sx-nav" aria-label="Sections du simulateur">
    <div class="wrap sx-nav-in">
      <span class="sx-nav-k">Simulateur {model.code}</span>
      <div class="sx-nav-l" id="sx-nav-l">
        <a href="#estimation" data-s="estimation">Estimation</a>
        {v3 && <a href="#verdict" data-s="verdict">Verdict</a>}
        {v3 && <a href="#dossier" data-s="dossier">Dossier</a>}
        {v3 && <a href="#risque" data-s="risque">Risque</a>}
        {v3 && <a href="#marche" data-s="marche">Marché</a>}
        {v3 && <a href="#scenarios" data-s="scenarios">Scénarios</a>}
        <a href="#vigilance" data-s="vigilance">Vigilance</a>
        <a href="#methode" data-s="methode">Méthode</a>
      </div>
    </div>
    <span class="sx-nav-p" id="sx-nav-p" aria-hidden="true"></span>
  </nav>
  <aside class="sx-inv" id="sx-inv" hidden aria-live="polite">
    <button type="button" class="sx-invx" id="sx-invx" aria-label="Fermer"></button>
    <strong>Présenter ce résultat à votre direction&#8239;?</strong>
    <p>Votre dossier de décision de 10 pages est prêt : synthèse, budget, risque, questions aux éditeurs et modèle Excel. {SITE.creditPrice}, avec un exemple complet à consulter avant.</p>
    <div><button type="button" class="sx-btn" id="sx-invgo">Voir mon dossier</button><a href={`/dossier/?exemple=${slug}`}>Voir un exemple</a></div>
  </aside>
  <button type="button" class="sx-cue" id="sx-cue" hidden><span>La suite de votre analyse</span><small>{v3 ? 'Verdict, risque, marché et scénarios' : 'Points de vigilance et méthode'}</small><i aria-hidden="true"></i></button>
  <header class="sx-hero wrap">
    <p class="sx-k rise">Simulateur {model.code} gratuit, aperçu immédiat</p>
    <h1 class="sx-title rise d1">{model.title}</h1>
    <p class="sx-lead rise d2">{model.lead}</p>
  </header>

  {EX && (
    <section class="wrap sx-show rise d3" aria-labelledby="sx-show-t">
      <div class="sx-show-h">
        <h2 id="sx-show-t">Ce que vous obtenez, en un coup d’œil</h2>
        <p>Exemple réel calculé par le simulateur pour {EX.ex}. <a href="#estimation" class="sx-show-go">Faire ma simulation</a></p>
      </div>
      <div class="sx-tiles">
        <a class="sx-tile" href="#verdict">
          <span class="sx-tk">Verdict</span>
          <span class={`sx-tdot ${EX.verdict.level}`} aria-hidden="true"></span>
          <b class="sx-tv sm">{EX.verdict.title}</b>
          <span class="sx-ts">Rentabilisé dans {EX.pWithin}&#8239;% des 1&#8239;000 scénarios simulés</span>
        </a>
        <a class="sx-tile" href="#estimation">
          <span class="sx-tk">Budget probable</span>
          <b class="sx-tv">{EX.budget}</b>
          <span class="sx-tbar" aria-hidden="true"><i style={`left: ${EX.bl}%; width: ${EX.bw}%`}></i><em style={`left: ${EX.bc}%`}></em></span>
          <span class="sx-ts">8 chances sur 10, poste par poste. Central : {EX.central}</span>
        </a>
        <a class="sx-tile" href="#risque">
          <span class="sx-tk">Risque de dépassement</span>
          <b class="sx-tv">{EX.over} %</b>
          <svg class="sx-tsvg" viewBox={`0 0 ${EX.W} ${EX.Hh}`} preserveAspectRatio="none" aria-hidden="true">{EX.hist.map((h) => <rect x={h.x} y={EX.Hh - h.h} width={EX.W / EX.hist.length - 1} height={h.h} rx="1" class={h.over ? 'ov' : ''} />)}</svg>
          <span class="sx-ts">Des 1&#8239;000 tirages dépassent le budget central. Pour être couvert 9 fois sur 10 : {EX.p90}</span>
        </a>
        <a class="sx-tile" href="#estimation">
          <span class="sx-tk">Retour sur investissement</span>
          <b class="sx-tv">{EX.be ? `${EX.be} mois` : 'Non atteint'}</b>
          <svg class="sx-tsvg" viewBox={`0 0 ${EX.W} ${EX.Hh}`} preserveAspectRatio="none" aria-hidden="true"><polyline points={EX.costLine} class="c" /><polyline points={EX.gainLine} class="g" />{EX.beX && <line x1={EX.beX} x2={EX.beX} y1="0" y2={EX.Hh} class="be" />}</svg>
          <span class="sx-ts">Point mort après le lancement. Valeur nette à {H} ans : {EX.net}</span>
        </a>
        {EX.mkt && (
          <a class="sx-tile" href="#marche">
            <span class="sx-tk">Face au marché</span>
            <b class="sx-tv">{EX.mkt.val}</b>
            <span class="sx-tband" aria-hidden="true">{EX.mkt.bands.map((x) => <i class={x.on ? 'on' : ''} style={`left: ${x.l}%; width: ${x.w}%`}></i>)}<em style={`left: ${EX.mkt.dot}%`}></em></span>
            <span class="sx-ts">{EX.mkt.label}, segment « {EX.mkt.mine} », sources citées</span>
          </a>
        )}
        <a class="sx-tile" href="#verdict">
          <span class="sx-tk">Coût de l’attente</span>
          <b class="sx-tv">{EX.wait}</b>
          <span class="sx-twait" aria-hidden="true">{EX.waitBars.map((v) => <i style={`height: ${Math.round(v * 100)}%`}></i>)}</span>
          <span class="sx-ts">Perdus chaque mois de report, {EX.waitYear} sur un an</span>
        </a>
      </div>
      <p class="sx-show-f">Et aussi : les {EX.factor ? '7 facteurs qui font bouger la rentabilité' : 'facteurs clés'}, le comparateur de scénarios, les points de vigilance et le dossier de décision de 10 pages.</p>
    </section>
  )}

  <div class="wrap sx-grid" id="estimation">
    <form class="sx-form rise d3" aria-label="Vos données" onsubmit="return false">
      {groups.map((g) => (
        <fieldset class="sx-group">
          <legend>{g}</legend>
          {model.fields.filter((f) => f.group === g).map((f) => f.type === 'range' ? (
            <div class="sx-field">
              <div class="sx-fh"><label for={`f-${f.id}`}>{f.label}</label><output id={`o-${f.id}`} for={`f-${f.id}`}></output></div>
              <input type="range" id={`f-${f.id}`} data-id={f.id}
                min={f.log ? 0 : f.min} max={f.log ? 1000 : f.max} step={f.log ? 1 : f.step} value={pos(f)} />
            </div>
          ) : (
            <div class="sx-field" role="radiogroup" aria-label={f.label}>
              <span class="sx-lab">{f.label}</span>
              <div class={`sx-opts ${f.options.length > 3 ? 'sx-opts-4' : ''}`}>
                {f.options.map((o, n) => (
                  <label><input type="radio" name={`f-${f.id}`} data-id={f.id} value={n} checked={n === f.value} /><span>{o}</span></label>
                ))}
              </div>
            </div>
          ))}
        </fieldset>
      ))}
      <details class="sx-adv">
        <summary>Hypothèses de calcul, modifiables</summary>
        <div class="sx-adv-grid">
          {model.assumptions.map((h) => (
            <div class="sx-af">
              <label for={`a-${h.id}`}>{h.label}</label>
              <div class="sx-ai"><input type="number" id={`a-${h.id}`} data-a={h.id} min={h.min} max={h.max} step={h.step} value={h.value} /><span>{h.unit}</span></div>
            </div>
          ))}
        </div>
        <button type="button" class="sx-reset" id="sx-reset">Revenir aux valeurs par défaut</button>
      </details>
    </form>

    <section class="sx-res" aria-label="Votre estimation" aria-live="polite">
      {v3 && (
        <a class="sx-vd" id="r-vd" href="#t-verdict">
          <span class="sx-vdot" aria-hidden="true"></span>
          <span class="sx-vtxt"><span class="sx-vlab" id="r-vlab"></span><strong id="r-vtitle"></strong></span>
        </a>
      )}
      <div class="sx-tier">
        <span class="sx-rk">Solution adaptée</span>
        <strong id="r-tier"></strong>
        <span id="r-tierdesc" class="sx-tdesc"></span>
      </div>
      <div class="sx-budget">
        <span class="sx-rk">Budget de mise en place</span>
        <span class="sx-big" id="r-budget"></span>
        <span class="sx-small" id="r-central"></span>
      </div>
      <div class="sx-gate" id="gate" data-step="sign">
        <strong class="sx-gt" id="gate-t">Votre première simulation complète est offerte</strong>
        <ul class="sx-gl" id="gate-list">
          <li>Le budget poste par poste et le coût total sur {H} ans</li>
          <li>Le verdict détaillé et le coût de chaque mois d’attente</li>
          <li>Le risque chiffré sur 1 000 simulations</li>
          <li>Les facteurs qui font bouger votre rentabilité</li>
          <li>Votre position face au marché, sources à l’appui</li>
          <li>Le comparateur de scénarios</li>
          <li>Le rapport PDF et le lien partageable</li>
          <li>Votre espace client et l’historique de vos simulations</li>
        </ul>
        <form id="gate-form" class="sx-gf sx-gf1" data-pane="sign" novalidate>
          <p class="sx-gsub">Créez votre compte gratuit : votre simulation est enregistrée, vous la retrouvez et l’ajustez quand vous voulez.</p>
          <div class="sx-gfi"><label for="g-email">Votre e-mail</label>
            <div class="sx-gin"><input id="g-email" name="email" type="email" autocomplete="email" required maxlength="120" placeholder="vous@entreprise.fr" /><button type="submit" class="sx-btn sx-gbtn" id="g-btn">Recevoir mon code</button></div>
          </div>
          <div class="sx-hp" aria-hidden="true"><label for="g-web">Site web</label><input id="g-web" name="website" tabindex="-1" autocomplete="off" /></div>
          <ul class="sx-gtrust">
            <li>Ni nom d’entreprise ni téléphone demandés</li>
            <li>Vos réponses restent privées, jamais transmises aux éditeurs</li>
            <li>Pas de mot de passe : un code à 6 chiffres par e-mail</li>
          </ul>
          <label class="sx-gopt"><input id="g-optin" type="checkbox" /><span>Recevoir les nouveaux guides et simulateurs, une à deux fois par mois</span></label>
          <p class="sx-gn">Adresse professionnelle conseillée, sans obligation. Vos données ne sont ni vendues ni cédées ; nous pouvons vous écrire au sujet de votre simulation, un mot suffit pour l’arrêter. <a href="/confidentialite/">Confidentialité</a></p>
          <p class="sx-gmsg" id="gate-msg" role="status"></p>
        </form>
        <form id="gate-code" class="sx-gf sx-gf1" data-pane="code" novalidate hidden>
          <p class="sx-gsent">Un code à 6 chiffres vient de partir à <b id="g-sent"></b>. Il est valable 15 minutes.</p>
          <div class="sx-gfi"><label for="g-code">Code reçu par e-mail</label><input id="g-code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]*" class="sx-gcode" /></div>
          <button type="submit" class="sx-btn sx-gbtn">Ouvrir mon analyse</button>
          <p class="sx-gsw"><button type="button" class="sx-glink" id="g-resend">Renvoyer le code</button> <button type="button" class="sx-glink" data-go="sign">Changer d’adresse</button></p>
          <p class="sx-gmsg" id="code-msg" role="status"></p>
        </form>
        <div class="sx-gpay" data-pane="pay" hidden>
          <p class="sx-gsent" id="g-paytxt"></p>
          <button type="button" class="sx-btn sx-gbtn" id="g-use" hidden></button>
          <div class="sx-gpb">
            <button type="button" class="sx-gp" data-buy="credit"><b>1 simulation avec son dossier</b><span>{SITE.creditPrice}</span></button>
            <button type="button" class="sx-gp" data-buy="pack"><b>5 simulations avec dossiers</b><span>{SITE.packPrice}</span></button>
            <button type="button" class="sx-gp" data-buy="pro"><b>Pass Pro, illimité, à votre logo</b><span>{SITE.proPrice}</span></button>
          </div>
          <p class="sx-gsw"><a href="/compte/">Mon espace client</a></p>
          <p class="sx-gmsg" id="pay-msg" role="status"></p>
        </div>
      </div>
      <div class="sx-bar" id="r-bar" role="img" aria-label="Répartition du budget"></div>
      <dl class="sx-legend" id="r-legend"></dl>
      <div class="sx-kpis">
        <div class="sx-kpi"><span class="sx-rk">Coût annuel</span><span class="sx-v" id="r-rec"></span><span class="sx-s" id="r-recs"></span></div>
        <div class="sx-kpi"><span class="sx-rk" id="r-totk"></span><span class="sx-v" id="r-tot"></span><span class="sx-s">Projet et coûts annuels cumulés</span></div>
        <div class="sx-kpi"><span class="sx-rk">Délai de mise en service</span><span class="sx-v" id="r-delay"></span><span class="sx-s">Du cadrage au démarrage</span></div>
        <div class="sx-kpi"><span class="sx-rk">Gains annuels mesurables</span><span class="sx-v" id="r-gain"></span><span class="sx-s" id="r-gains"></span></div>
        <div class="sx-kpi sx-kpi-x" id="r-x" hidden><span class="sx-rk" id="r-xk"></span><span class="sx-v" id="r-xv"></span><span class="sx-s" id="r-xs"></span></div>
        <div class="sx-kpi sx-kpi-x" id="r-o" hidden><span class="sx-rk" id="r-ok"></span><span class="sx-v" id="r-ov"></span><span class="sx-s">Gain ponctuel, non compté dans le retour sur investissement</span></div>
        {v3 && <div class="sx-kpi"><span class="sx-rk">Coût du démarrage</span><span class="sx-v" id="r-dip"></span><span class="sx-s">Productivité réduite pendant 6 semaines, comptée dans le calcul</span></div>}
        {v3 && <div class="sx-kpi"><span class="sx-rk">Valeur nette sur {H} ans</span><span class="sx-v" id="r-net"></span><span class="sx-s">Gains moins coûts, valeur médiane simulée</span></div>}
      </div>
      <div class="sx-pay">
        <span class="sx-rk">Retour sur investissement</span>
        <span class="sx-payv" id="r-pay"></span>
        <span class="sx-pill" id="r-pill"></span>
      </div>
      <figure class="sx-chart">
        <svg id="r-chart" viewBox="0 0 560 200" role="img" aria-label="Coûts et gains cumulés"></svg>
        <figcaption><span class="lg lg-c"></span>Coûts cumulés <span class="lg lg-g"></span>Gains cumulés{v3 && <span class="lg-n">Scénario central</span>}</figcaption>
      </figure>
      <div class="sx-actions">
        <button type="button" class="sx-btn" id="sx-print">Imprimer ou enregistrer en PDF</button>
        <button type="button" class="sx-btn sx-btn-ghost" id="sx-link">Copier le lien de cette simulation</button>
        {v3 && <button type="button" class="sx-btn sx-btn-ghost" id="sx-pin">Garder ce scénario pour comparer</button>}
      </div>
      <p class="sx-status" id="sx-status" role="status"></p>
      <p class="sx-acc" id="sx-acc"></p>
    </section>
  </div>

  {v3 && (
    <section class="wrap sx-vsec" id="verdict" aria-labelledby="t-verdict">
      <p class="sx-lk"><span class="sx-lkt">Un chiffre en clair ici. Tout le reste s’affiche avec votre simulation offerte.</span><button type="button" class="sx-lkb">Débloquer gratuitement</button></p>
      <div class="sx-vgrid">
        <div class="sx-vcard sr-up" id="v-card">
          <span class="sx-vbadge" id="v-badge"><i aria-hidden="true"></i><span id="v-blab"></span></span>
          <h2 id="t-verdict" class="sx-vh"></h2>
          <ul class="sx-vlist" id="v-reasons"></ul>
        </div>
        <div class="sx-wait sr-up lag1">
          <span class="sx-rk">Le coût de l’attente</span>
          <span class="sx-wbig" id="w-month"></span>
          <span class="sx-ws">de gains nets perdus pour chaque mois de report, à pleine charge</span>
          <div class="sx-wrow"><span>Un an de report</span><strong id="w-year"></strong></div>
          <p class="sx-wn" id="w-note"></p>
        </div>
      </div>
    </section>

    <section class="sx-dos" id="dossier" aria-labelledby="t-dos">
      <div class="wrap sx-dgrid">
        <div class="sx-dtext">
          <p class="sx-dk">Pour décider, et faire décider</p>
          <h2 id="t-dos" class="sx-dh">Votre dossier de décision, prêt pour la direction.</h2>
          <p class="sx-dl">Dix pages à votre nom, construites sur vos réponses et sur les études internationales. Le travail qu’un cabinet facture plusieurs jours, livré en une minute.</p>
          <ul class="sx-dlist">
            <li><b>Synthèse pour la direction</b><span>Verdict, chiffres clés, valeur actuelle nette</span></li>
            <li><b>Budget détaillé</b><span>Poste par poste, échéancier sur {H} ans</span></li>
            <li><b>Risque chiffré</b><span>1 000 simulations et facteurs de rentabilité</span></li>
            <li><b>Marché et scénarios</b><span>Vos chiffres face aux références publiées</span></li>
            <li><b>Planning et prochaines étapes</b><span>Du cadrage au démarrage</span></li>
            <li><b>Les 10 questions à poser aux éditeurs</b><span>Celles qui font tomber les offres trop belles</span></li>
            <li><b>Le modèle de calcul Excel</b><span>À compléter avec les offres reçues, tout se recalcule</span></li>
          </ul>
          <div class="sx-dbuy"><span class="sx-dprice">{SITE.creditPrice}</span><span class="sx-dnote">Le prix d’un quart d’heure de consultant,<br />pour plusieurs jours de travail. Déduits du kit.</span></div>
          <p class="sx-dguar"><span aria-hidden="true"></span>Voyez avant d’acheter : l’exemple complet est en accès libre. Accès immédiat, PDF et Excel.</p>
          <p class="sx-doffers">Pack de 5 simulations avec dossiers : {SITE.packPrice}. Pass Pro, illimité et à votre logo : {SITE.proPrice}. <a href="/compte/">Voir les formules</a></p>
          <div class="sx-dact">
            <button type="button" class="sx-dbtn" id="dos-buy">Recevoir mon dossier</button>
            <a class="sx-dlink" href={`/dossier/?exemple=${slug}`}>Voir un exemple complet</a>
          </div>
          <p class="sx-dmsg" id="dos-msg" role="status"></p>
        </div>
        <div class="sx-dviz" aria-hidden="true">
          <div class="mp mp3"><div class="mp-h"></div><strong>Le risque, chiffré</strong><div class="mp-hist" id="mp-hist"></div><div class="mp-l"></div><div class="mp-l s"></div><div class="mp-l"></div></div>
          <div class="mp mp2"><div class="mp-h"></div><strong>Budget détaillé</strong><div class="mp-bar" id="mp-bar"></div><div class="mp-rows" id="mp-rows"></div></div>
          <div class="mp mp1">
            <div class="mp-logo"><Logo variant="full" /></div>
            <span class="mp-k">Dossier de décision</span>
            <strong class="mp-t">{model.name}</strong>
            <div class="mp-v" id="mp-v"><i></i><span id="mp-vt"></span></div>
            <div class="mp-k2"><div><small>Budget, 9 chances sur 10</small><b id="mp-p90"></b></div><div><small>Valeur nette sur {H} ans</small><b id="mp-net"></b></div></div>
          </div>
        </div>
      </div>
    </section>

    <section class="sx-risk" id="risque" aria-labelledby="t-risk">
      <div class="wrap">
        <h2 id="t-risk" class="sx-h2 sr-up">Le risque, chiffré</h2>
        <p class="sx-sub sr-up">Votre projet rejoué 1 000 fois, avec les dépassements, les retards et les écarts de gains observés sur le marché.</p>
        <p class="sx-lk"><span class="sx-lkt">Un chiffre en clair ici. Tout le reste s’affiche avec votre simulation offerte.</span><button type="button" class="sx-lkb">Débloquer gratuitement</button></p>
        <div class="sx-stats sr-up">
          <div class="sx-stat"><span class="sx-sk">Budget le plus probable</span><span class="sx-sv" id="s-p50"></span><span class="sx-ss" id="s-p50s"></span></div>
          <div class="sx-stat"><span class="sx-sk">Risque de dépasser le scénario central</span><span class="sx-sv" id="s-over"></span><span class="sx-ss">Part des simulations au-dessus</span></div>
          <div class="sx-stat"><span class="sx-sk">Chances d’être rentabilisé en {H} ans</span><span class="sx-sv" id="s-within"></span><span class="sx-ss" id="s-withins"></span></div>
          <div class="sx-stat"><span class="sx-sk">Valeur nette sur {H} ans</span><span class="sx-sv" id="s-net"></span><span class="sx-ss" id="s-nets"></span></div>
        </div>
        <div class="sx-rgrid">
          <figure class="sx-panel sr-up">
            <figcaption><strong>Budget de mise en place, 1 000 simulations</strong><span>Chaque barre compte les simulations tombées dans la tranche.</span></figcaption>
            <svg id="g-hist" viewBox="0 0 560 230" role="img" aria-label="Répartition du budget simulé"></svg>
            <p class="sx-glegend"><span class="li"><span class="k k-bar"></span>Simulations</span><span class="li"><span class="k k-p"></span>8 chances sur 10</span><span class="li"><span class="k k-c"></span>Scénario central</span></p>
            <table class="sx-rtab" id="g-rtab"></table>
          </figure>
          <figure class="sx-panel sr-up lag1">
            <figcaption><strong>Ce qui fait bouger votre valeur nette sur {H} ans</strong><span>Chaque facteur varie seul, les autres restent au scénario central.</span></figcaption>
            <div id="g-tornado" class="sx-tor"></div>
            <p class="sx-glegend"><span class="li"><span class="k k-down"></span>Effet défavorable</span><span class="li"><span class="k k-up"></span>Effet favorable</span></p>
          </figure>
        </div>
      </div>
    </section>

    <section class="wrap sx-mkt" id="marche" aria-labelledby="t-mkt">
      <h2 id="t-mkt" class="sx-h2 sr-up">Votre projet face au marché</h2>
      <p class="sx-sub sr-up">Vos chiffres placés sur les fourchettes publiées par les études internationales. Le point noir, c’est vous.</p>
      <p class="sx-lk"><span class="sx-lkt">Un chiffre en clair ici. Tout le reste s’affiche avec votre simulation offerte.</span><button type="button" class="sx-lkb">Débloquer gratuitement</button></p>
      <div id="g-bench" class="sx-bench sr-up"></div>
    </section>

    <section class="sx-cmp" id="scenarios" aria-labelledby="t-cmp">
      <div class="wrap">
        <h2 id="t-cmp" class="sx-h2 sr-up">Comparer les scénarios</h2>
        <p class="sx-sub sr-up">Les alternatives les plus proches, calculées avec vos réponses. Modifiez vos réponses puis gardez jusqu’à deux scénarios pour les mettre côte à côte.</p>
        <p class="sx-lk"><span class="sx-lkt">Un chiffre en clair ici. Tout le reste s’affiche avec votre simulation offerte.</span><button type="button" class="sx-lkb">Débloquer gratuitement</button></p>
        <div class="sx-scroll sx-cscroll sr-up"><table id="g-cmp"></table></div>
      </div>
    </section>
  )}

  <section class="wrap sx-watch" id="vigilance" aria-labelledby="t-watch">
    <h2 id="t-watch" class="sx-h2 sr-up">Points de vigilance pour votre profil</h2>
    <p class="sx-lk"><span class="sx-lkt">Un chiffre en clair ici. Tout le reste s’affiche avec votre simulation offerte.</span><button type="button" class="sx-lkb">Débloquer gratuitement</button></p>
    <ol id="r-watch" class="sx-wlist"></ol>
  </section>

  <section class="sx-next" aria-labelledby="t-next">
    <div class="wrap">
      <h2 id="t-next" class="sx-h2 sr-up">Passer de l’estimation au projet</h2>
      <div class="sx-cards">
        <a class="sx-card sx-card-dark sr-up" href={kitHref}>
          <span class="sx-ck">{SITE.kitPrice}</span>
          <h3>Le kit de consultation {model.code}</h3>
          <p>{kit.reqs} exigences commentées, scénarios de démonstration imposés, grille de dépouillement, check-list contractuelle et plan de recette.</p>
          <span class="sx-go">Voir le kit</span>
        </a>
        <a class="sx-card sr-up lag1" href="/accompagnement/">
          <span class="sx-ck">{SITE.reviewPrice}</span>
          <h3>La relecture experte</h3>
          <p>Votre cahier des charges annoté et une heure de visio avant l’envoi aux éditeurs.</p>
          <span class="sx-go">En savoir plus</span>
        </a>
        <a class="sx-card sr-up lag2" href={bookHref}>
          <span class="sx-ck">Gratuit</span>
          <h3>30 minutes avec un expert</h3>
          <p>Pour challenger cette estimation sur vos chiffres réels et identifier le premier chantier.</p>
          <span class="sx-go">Réserver l’appel</span>
        </a>
      </div>
    </div>
  </section>

  <section class="wrap sx-method" id="methode" aria-labelledby="t-method">
    <h2 id="t-method" class="sx-h2 sr-up">Méthode et sources</h2>
    <div class="sx-mtext sr-up">
      {model.method ? model.method.map((p) => <p>{p}</p>) : (
        <Fragment>
          <p>Le modèle détermine d’abord la gamme de solution adaptée à votre profil, puis chiffre chaque poste à partir de valeurs publiées. La fourchette va de 20 % sous à 30 % au-dessus du scénario central, parce que les dépassements sont plus fréquents que les économies.</p>
          <p>Le retour sur investissement est calculé mois par mois : le budget est réparti sur la durée du projet, les coûts annuels et les gains commencent à la mise en service, et les gains montent en charge sur {model.ramp} mois. Seuls les gains mesurables sont comptés, avec des hypothèses prudentes que vous pouvez modifier.</p>
        </Fragment>
      )}
    </div>
    <div class="sx-scroll sr-up">
      <table>
        <thead><tr><th>Paramètre</th><th>Valeur retenue</th><th>Repère publié</th><th>Source</th></tr></thead>
        <tbody>
          {model.sources.map((s) => (
            <tr><td>{s[0]}</td><td>{s[1]}</td><td>{s[2]}</td><td>{s[4] ? <a href={s[4]}>{s[3]}</a> : s[3]}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="sx-foot">Ordres de grandeur indicatifs en euros hors taxes, modèle version {model.version || 2} de novembre 2026. Les calculs se font dans votre navigateur ; une fois connecté, vos réponses sont enregistrées dans votre espace client. Un chiffrage ferme demande un cadrage de vos flux et des offres d’éditeurs.</p>
  </section>

  <section class="sx-others" aria-labelledby="t-others">
    <div class="wrap">
      <h2 id="t-others" class="sx-h2 sr-up">Les autres simulateurs</h2>
      <div class="sx-orow">
        {others.map((m, n) => { const p = preview(m); return (
          <a class={`sx-oc sr-up lag${(n % 5) + 1}`} href={`/simulateurs/${m.slug}/`}>
            <span class="sx-ocode">{m.code}</span>
            <strong>{m.name}</strong>
            <span>{m.card}</span>
            <span class="sx-oex">Exemple : {money(p.low)} à {money(p.high)}</span>
          </a>
        ); })}
      </div>
    </div>
  </section>

  <div class="sx-lockbar" id="lockbar" hidden>
    <button type="button" class="sx-lbn" id="lockbar-next" aria-label="Voir la suite de l’analyse" title="Voir la suite de l’analyse"><i aria-hidden="true"></i></button>
    <span>Votre première simulation complète est offerte : risque, marché, scénarios et PDF.</span>
    <button type="button" class="sx-btn" id="lockbar-go">Créer mon compte gratuit</button>
  </div>

  <div class="sx-report" id="sx-report" aria-hidden="true">
    <div class="rp-head"><Logo variant="full" /><div><strong>Simulation {model.code}</strong><span id="rp-date"></span></div></div>
    <div id="rp-body"></div>
  </div>
</div>

<script>
  import { SIMS, defaults, simulate, money, sensitivity, verdict, inaction, scenarios } from '../lib/sims.js';

  const root = document.querySelector<HTMLElement>('.simx')!;
  const model = SIMS[root.dataset.slug!];
  const nf = new Intl.NumberFormat('fr-FR');
  const $ = (id: string) => document.getElementById(id)!;
  const fields = model.fields;

  // Curseurs logarithmiques : une position de 0 à 1000 convertie en valeur arrondie au pas
  const fromPos = (f: any, p: number) => {
    if (!f.log) return p;
    const v = f.min * Math.pow(f.max / f.min, p / 1000);
    const mag = Math.pow(10, Math.max(0, Math.floor(Math.log10(v)) - 1));
    const st = Math.max(f.step, mag);
    return Math.min(f.max, Math.max(f.min, Math.round(v / st) * st));
  };
  const toPos = (f: any, v: number) => (f.log ? Math.round((1000 * Math.log(v / f.min)) / Math.log(f.max / f.min)) : v);

  // Lecture des paramètres d'URL pour retrouver une simulation partagée
  const params = new URLSearchParams(location.search);
  fields.forEach((f: any) => {
    const raw = params.get(f.id); if (raw === null) return;
    const n = Number(raw); if (!Number.isFinite(n)) return;
    if (f.type === 'range') { const v = Math.min(f.max, Math.max(f.min, n)); (document.getElementById(`f-${f.id}`) as HTMLInputElement).value = String(toPos(f, v)); }
    else { const el = document.querySelector<HTMLInputElement>(`input[name="f-${f.id}"][value="${Math.round(n)}"]`); if (el) el.checked = true; }
  });
  model.assumptions.forEach((h: any) => {
    const raw = params.get(`h_${h.id}`); if (raw === null) return;
    const n = Number(raw); if (Number.isFinite(n)) (document.getElementById(`a-${h.id}`) as HTMLInputElement).value = String(n);
  });

  const read = () => {
    const i: Record<string, number> = {}; const a: Record<string, number> = {};
    fields.forEach((f: any) => {
      if (f.type === 'range') {
        const v = fromPos(f, Number((document.getElementById(`f-${f.id}`) as HTMLInputElement).value));
        i[f.id] = v; $(`o-${f.id}`).textContent = `${nf.format(v)} ${f.unit}`;
      } else i[f.id] = Number(document.querySelector<HTMLInputElement>(`input[name="f-${f.id}"]:checked`)!.value);
    });
    model.assumptions.forEach((h: any) => {
      const el = document.getElementById(`a-${h.id}`) as HTMLInputElement; const n = Number(el.value);
      a[h.id] = Number.isFinite(n) ? Math.min(h.max, Math.max(h.min, n)) : h.value;
    });
    return { i, a };
  };

  const COLORS = ['#2448f5', '#6f8bff', '#a9b8ff', '#d7defd', '#8e8e93', '#48484a', '#c7c7cc'];
  const months = (n: number) => `${Math.round(n)} mois`;
  let last: any = null; let state: any = null;
  const V3 = model.version === 3;
  const HZ = model.horizon;
  const LV: Record<string, string> = { go: 'Feu vert', prep: 'À sécuriser', wait: 'À revoir' };
  const pc = (x: number) => `${Math.round(x * 100)} %`;
  const sMoney = (v: number) => (v < 0 ? `-${money(-v)}` : money(v));
  const beTxt = (be: number) => (Number.isFinite(be) ? `${be} mois` : `Au-delà de ${HZ} ans`);
  const esc = (s: string) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');
  let pinned: any[] = []; let slow: any = null; let tmr: any = 0;

  const chart = (r: any) => {
    const W = 560, H = 200, P = { l: 8, r: 8, t: 12, b: 26 };
    const n = r.cumCost.length; const max = Math.max(r.cumCost[n - 1], r.cumGain[n - 1], 1);
    const x = (m: number) => P.l + (m / (n - 1)) * (W - P.l - P.r);
    const y = (v: number) => H - P.b - (v / max) * (H - P.t - P.b);
    const line = (arr: number[]) => arr.map((v, k) => `${k ? 'L' : 'M'}${x(k).toFixed(1)} ${y(v).toFixed(1)}`).join(' ');
    let ticks = '';
    for (let yr = 1; yr <= r.horizon; yr++) { const xx = x(yr * 12 - 1); ticks += `<line x1="${xx}" x2="${xx}" y1="${H - P.b}" y2="${H - P.b + 4}" class="tk"/>`; if (r.horizon <= 5 || yr % 2 === 0) ticks += `<text x="${xx}" y="${H - 6}" class="tx" text-anchor="${yr === r.horizon ? 'end' : 'middle'}">An ${yr}</text>`; }
    const gl = x(r.goLive - 1);
    let be = '';
    if (r.breakEven) { const bx = x(r.breakEven - 1), by = y(r.cumGain[r.breakEven - 1]); be = `<circle cx="${bx}" cy="${by}" r="5" class="be"/><text x="${Math.min(bx + 8, W - 130)}" y="${by - 10}" class="bt">${V3 ? 'Point mort central' : 'Point mort'}</text>`; }
    $('r-chart').innerHTML = `<line x1="${P.l}" x2="${W - P.r}" y1="${H - P.b}" y2="${H - P.b}" class="ax"/>${ticks}
      <line x1="${gl}" x2="${gl}" y1="${P.t}" y2="${H - P.b}" class="gl"/><text x="${gl + 6}" y="${P.t + 10}" class="tx">Mise en service</text>
      <path d="${line(r.cumCost)}" class="lc"/><path d="${line(r.cumGain)}" class="lg"/>${be}`;
  };

  const render = () => {
    const { i, a } = read(); state = { i, a };
    const r = simulate(model, i, a); last = r;
    const vd = V3 ? verdict(model, i, r, null) : null;
    $('r-tier').textContent = r.tier.name;
    $('r-tierdesc').textContent = r.tier.desc;
    $('r-budget').textContent = `${money(r.low)} à ${money(r.high)}`;
    $('r-central').textContent = V3 ? `8 chances sur 10 dans cette fourchette. Scénario central : ${money(r.initial)}` : `Scénario central : ${money(r.initial)}`;
    $('r-bar').innerHTML = r.parts.filter((p: any) => p[1] > 0).map((p: any, n: number) => `<span style="width:${((p[1] / r.initial) * 100).toFixed(2)}%;background:${COLORS[n % COLORS.length]}"></span>`).join('');
    $('r-legend').innerHTML = r.parts.filter((p: any) => p[1] > 0).map((p: any, n: number) => `<dt><i style="background:${COLORS[n % COLORS.length]}"></i>${p[0]}</dt><dd>${money(p[1])}</dd>`).join('');
    $('r-rec').textContent = r.recurring > 0 ? `${money(r.recurring)} par an` : 'Aucun';
    $('r-recs').textContent = r.recurringNote;
    $('r-totk').textContent = `Coût total sur ${r.horizon} ans`;
    $('r-tot').textContent = money(r.total);
    $('r-delay').textContent = V3 ? `${r.mc.months.p10} à ${r.mc.months.p90} mois` : `${months(r.months[0])} à ${months(r.months[1])}`;
    $('r-gain').textContent = `${money(r.gainsTotal)} par an`;
    $('r-gains').textContent = r.gains.map((g: any) => `${g[0]} : ${money(g[1])}`).join(' ; ');
    const x = $('r-x'); if (r.kpi) { x.hidden = false; $('r-xk').textContent = r.kpi[0]; $('r-xv').textContent = r.kpi[1]; $('r-xs').textContent = r.kpi[2]; } else x.hidden = true;
    const o = $('r-o'); if (r.oneOff && r.oneOff[1] > 0) { o.hidden = false; $('r-ok').textContent = r.oneOff[0]; $('r-ov').textContent = money(r.oneOff[1]); } else o.hidden = true;
    const pill = $('r-pill');
    if (V3) {
      const be = r.mc.breakEven.p50;
      $('r-pay').textContent = Number.isFinite(be) ? `Rentabilisé ${be} mois après le lancement` : `Non rentabilisé en ${HZ} ans dans la plupart des simulations`;
      pill.textContent = `${pc(r.mc.pWithin)} de chances d’être rentabilisé en ${HZ} ans`;
      pill.className = `sx-pill ${vd.level === 'go' ? 'ok' : vd.level === 'prep' ? 'mid' : 'ko'}`;
      const box = $('r-vd'); box.dataset.level = vd.level;
      $('r-vlab').textContent = LV[vd.level]; $('r-vtitle').textContent = vd.title;
      $('r-dip').textContent = r.dip ? money(r.dip[1]) : 'Aucun';
      $('r-net').textContent = sMoney(r.mc.net.p50);
    } else if (r.breakEven) {
      $('r-pay').textContent = `Rentabilisé ${r.breakEven} mois après le lancement`;
      pill.textContent = `${r.roi >= 0 ? '+' : ''}${Math.round(r.roi * 100)} % sur ${r.horizon} ans, soit ${r.breakEven - r.goLive} mois après la mise en service`;
      pill.className = `sx-pill ${r.breakEven <= r.horizon * 12 * 0.6 ? 'ok' : 'mid'}`;
    } else {
      $('r-pay').textContent = r.netAnnual > 0 ? `Au-delà de ${r.horizon} ans` : 'Non rentable sur les seuls gains mesurables';
      pill.textContent = `${Math.round(r.roi * 100)} % sur ${r.horizon} ans`;
      pill.className = 'sx-pill ko';
    }
    chart(r);
    $('r-watch').innerHTML = r.watch.map((w: string) => `<li>${w}</li>`).join('');
    if (V3) { clearTimeout(tmr); tmr = setTimeout(() => renderSlow(i, a, r), 110); }
  };

  // Blocs de la version 3 : calculés juste après la carte de résultat pour garder les curseurs fluides
  const hist = (r: any) => {
    const el = $('g-hist'); const W = Math.round(Math.max(300, el.clientWidth || 560)); el.setAttribute('viewBox', `0 0 ${W} 230`);
    const h = r.mc.hist; const Hh = 230, P = { l: 10, r: 10, t: 40, b: 34 };
    const n = h.bins.length; const max = Math.max(...h.bins, 1); const span = h.hi - h.lo || 1;
    const bw = (W - P.l - P.r) / n;
    const x = (v: number) => P.l + Math.min(1, Math.max(0, (v - h.lo) / span)) * (W - P.l - P.r);
    const y = (c: number) => Hh - P.b - (c / max) * (Hh - P.t - P.b);
    const { p10, p50, p90 } = r.mc.budget;
    let bars = '';
    h.bins.forEach((c: number, k: number) => {
      if (!c) return;
      const a0 = h.lo + (k * span) / n, a1 = h.lo + ((k + 1) * span) / n;
      const inR = a1 > p10 && a0 < p90;
      const bx = P.l + k * bw + 1, by = y(c), bh = Hh - P.b - by, w = Math.max(1, bw - 2), rr = Math.min(3, w / 2, bh);
      bars += `<path class="hb${inR ? ' in' : ''}" d="M${bx} ${Hh - P.b}V${by + rr}Q${bx} ${by} ${bx + rr} ${by}H${bx + w - rr}Q${bx + w} ${by} ${bx + w} ${by + rr}V${Hh - P.b}Z"><title>${money(a0)} à ${money(a1)} : ${c} simulations</title></path>`;
    });
    const x10 = x(p10), x90 = x(p90), xc = x(r.initial), x50 = x(p50);
    const by0 = 16;
    $('g-hist').innerHTML = `${bars}
      <line x1="${P.l}" x2="${W - P.r}" y1="${Hh - P.b}" y2="${Hh - P.b}" class="ax"/>
      <path d="M${x10} ${by0 + 6}V${by0}H${x90}V${by0 + 6}" class="br"/>
      <text x="${Math.min(W - 120, Math.max(120, (x10 + x90) / 2))}" y="${by0 - 5}" text-anchor="middle" class="bt">8 chances sur 10 : ${money(p10)} à ${money(p90)}</text>
      <line x1="${xc}" x2="${xc}" y1="${P.t - 6}" y2="${Hh - P.b + 6}" class="cl"/>
      <text x="${xc}" y="${Hh - 10}" text-anchor="${xc < 70 ? 'start' : xc > W - 70 ? 'end' : 'middle'}" class="ct">Central ${money(r.initial)}</text>
      <line x1="${x50}" x2="${x50}" y1="${Hh - P.b}" y2="${Hh - P.b + 5}" class="tk"><title>Médiane ${money(p50)}</title></line>`;
  };

  const tornado = (sens: any[], base: number) => {
    if (!sens.length) { $('g-tornado').innerHTML = ''; return; }
    const lo = Math.min(base, ...sens.map((s) => s.lo)), hi = Math.max(base, ...sens.map((s) => s.hi));
    const pad = (hi - lo) * 0.03 || 1; const L = lo - pad, R = hi + pad;
    const X = (v: number) => ((v - L) / (R - L)) * 100;
    const xb = X(base);
    $('g-tornado').innerHTML = sens.map((s) => {
      const d0 = Math.min(s.lo, base), u1 = Math.max(s.hi, base);
      return `<div class="tr" title="${esc(s.label)} : valeur nette de ${sMoney(s.lo)} à ${sMoney(s.hi)}">
        <div class="tl"><strong>${esc(s.label)}</strong><span>${esc(s.range)}</span></div>
        <div class="tb"><span class="td" style="left:${X(d0)}%;width:${Math.max(0, xb - X(d0))}%"></span><span class="tu" style="left:${xb}%;width:${Math.max(0, X(u1) - xb)}%"></span><span class="tz" style="left:${xb}%"></span></div>
        <div class="tv"><span>${sMoney(s.lo)}</span><span>${sMoney(s.hi)}</span></div>
      </div>`;
    }).join('') + `<p class="tbase">Scénario central : ${sMoney(base)}</p>`;
  };

  const fmtB = (v: number, f: string) => f === 'money' ? money(v) : f === 'months' ? `${Math.round(v)} mois` : f === 'pct' ? `${String(Math.round(v * 100) / 100).replace('.', ',')} %` : `${v < 10 ? String(Math.round(v * 10) / 10).replace('.', ',') : Math.round(v)} €`;
  const bench = (list: any[]) => {
    $('g-bench').innerHTML = list.map((b) => {
      let L: number, R: number, X: (v: number) => number;
      if (b.log) {
        L = Math.min(b.value, ...b.bands.map((x: any) => x.lo)) / 1.5; R = Math.max(b.value, ...b.bands.map((x: any) => x.hi)) * 1.5;
        X = (v) => (Math.log(v / L) / Math.log(R / L)) * 100;
      } else { L = b.lo; R = b.hi; X = (v) => ((Math.min(R, Math.max(L, v)) - L) / (R - L)) * 100; }
      const xm = X(b.value);
      const rng = (x: any) => (x.lo === x.hi ? fmtB(x.lo, b.fmt) : `${fmtB(x.lo, b.fmt)} à ${fmtB(x.hi, b.fmt)}`);
      const lanes = b.bands.map((x: any, k: number) => `<span class="bl${x.mine ? ' mine' : ''}${x.lo === x.hi ? ' pt' : ''}" style="top:${k * 12}px;left:${X(x.lo)}%;${x.lo === x.hi ? '' : `width:${Math.max(1, X(x.hi) - X(x.lo))}%`}" title="${esc(x.label)} : ${rng(x)}"></span>`).join('');
      const chips = b.bands.map((x: any) => `<span class="bc${x.mine ? ' mine' : ''}"><i></i>${esc(x.label)} : <em>${rng(x)}</em></span>`).join('');
