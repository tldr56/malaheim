  // Comptes clients : première simulation complète offerte, les suivantes avec un crédit, un pack ou le Pass Pro
  const GATED = '.sx-actions,.sx-cscroll';
  const lockbar = $('lockbar'); const gate = $('gate');
  let acct: any = null; let simRec: any = null; let pendingEmail = ''; let lastStart: any = null;
  const setLocked = (on: boolean) => {
