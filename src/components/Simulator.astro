    const a = j.account || acct; const lastTxt = j.last ? ` (${j.last.code}, le ${dfr(j.last.created)})` : '';
    const use = $('g-use') as HTMLButtonElement;
    if (j.need === 'confirm') {
      $('g-paytxt').textContent = `Votre simulation offerte a déjà servi${lastTxt}. Il vous reste ${a.credits} crédit${a.credits > 1 ? 's' : ''} : une nouvelle simulation complète, avec son dossier de décision, en utilise un.`;
      use.hidden = false; use.textContent = 'Utiliser 1 crédit';
    } else {
      $('g-paytxt').textContent = `Votre simulation offerte a déjà servi${lastTxt}. Chaque nouvelle simulation complète est livrée avec son dossier de décision : 10 pages et le modèle de calcul Excel.`;
      use.hidden = true;
    }
    pane('pay');
  };
  const openSim = async (confirm = false) => {
    const j = await api('/api/sim/open', { sim: model.slug, q: qNow(), confirm });
    if (j.status === 401) { acct = null; simRec = null; setLocked(true); pane('sign'); return false; }
    if (!j.ok) return false;
    acct = j.account;
    if (j.access === 'full') { simRec = j.sim; setLocked(false); showAccess(); return true; }
    simRec = null; setLocked(true); payPane(j); return false;
  };
  const checkout = async (product: string, simId: string, back: string, msg: HTMLElement) => {
    const ask = (window as any).mlhConsent; if (ask && !(await ask())) { msg.textContent = ''; return; }
    msg.textContent = 'Ouverture du paiement sécurisé…';
    const j = await api('/api/checkout', { product, simId, back, consent: true });
    if (j.ok && j.url) { location.href = j.url; return; }
    if (j.status === 401) { msg.textContent = 'Connectez-vous d’abord.'; pane('sign'); goGate(); return; }
    msg.innerHTML = j.reason === 'not_configured'
      ? `Le paiement en ligne ouvre très prochainement. En attendant, <a href="/dossier/?exemple=${model.slug}">découvrez l’exemple complet</a> ou écrivez-nous à <a href="mailto:contact@malaheim.com">contact@malaheim.com</a>.`
      : esc(j.error || 'Le paiement n’a pas pu s’ouvrir. Réessayez dans un instant.');
  };

  // Invitation au dossier après un vrai temps de travail sur la simulation
  let engaged = 0, invDone = false;
  try { invDone = sessionStorage.getItem('mlh-inv') === '1'; } catch {}
  const inv = $('sx-inv');
  const closeInv = () => { inv.hidden = true; invDone = true; try { sessionStorage.setItem('mlh-inv', '1'); } catch {} };
  const maybeInvite = () => {
    if (invDone || !V3 || !acct || !simRec || simRec.dossier || acct.pro || root.classList.contains('locked')) return;
    if (engaged < 3) return;
    const d = $('dossier').getBoundingClientRect(); if (d.top < innerHeight && d.bottom > 0) return;
    inv.hidden = false; invDone = true; try { sessionStorage.setItem('mlh-inv', '1'); } catch {}
  };
  $('sx-invx').addEventListener('click', closeInv);
  $('sx-invgo').addEventListener('click', () => { closeInv(); $('dossier').scrollIntoView({ behavior: 'smooth', block: 'start' }); });
  root.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('#sx-pin')) { engaged += 2; setTimeout(maybeInvite, 1200); } });
  root.addEventListener('change', () => {
    engaged++; setTimeout(maybeInvite, 1500);
    if (!acct) return;
    clearTimeout(utmr); utmr = setTimeout(() => sendUsage('simulation'), 25000);
    if (simRec && simRec.active !== false) { clearTimeout(stmr); stmr = setTimeout(() => api('/api/sim/save', { id: simRec.id, q: qNow() }), 2500); }
  });

  // Inscription, connexion et code
  const val = (id: string) => (document.getElementById(id) as HTMLInputElement).value.trim();
  const start = async (payload: any, msg: HTMLElement) => {
    msg.textContent = 'Envoi du code…';
    const j = await api('/api/auth/start', payload);
    if (!j.ok) { msg.innerHTML = esc(j.error || 'Envoi impossible.') + (''); return false; }
    lastStart = payload; pendingEmail = payload.email; msg.textContent = '';
    $('g-sent').textContent = pendingEmail; ($('g-code') as HTMLInputElement).value = j.devCode || '';
    $('code-msg').textContent = j.devCode ? `Mode test, envoi des e-mails non branché : le code est ${j.devCode}.` : '';
    pane('code'); setTimeout(() => ($('g-code') as HTMLInputElement).focus(), 50);
    return true;
  };
  ($('gate-form') as HTMLFormElement).addEventListener('submit', async (e) => {
    e.preventDefault(); const gmsg = $('gate-msg'); const email = val('g-email');
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]{2,}$/.test(email)) { gmsg.textContent = 'Saisissez une adresse e-mail valide.'; return; }
    await start({ email, optin: (document.getElementById('g-optin') as HTMLInputElement).checked, website: val('g-web') }, gmsg);
  });
  $('g-resend').addEventListener('click', () => { if (lastStart) start(lastStart, $('code-msg')); });
  ($('gate-code') as HTMLFormElement).addEventListener('submit', async (e) => {
    e.preventDefault(); const msg = $('code-msg'); const code = val('g-code');
    if (!/^\d{6}$/.test(code)) { msg.textContent = 'Saisissez les 6 chiffres du code.'; return; }
    msg.textContent = 'Vérification…'; clearTimeout(tmr); renderSlow(state.i, state.a, last);
    const c = context();
    const j = await api('/api/auth/verify', { email: pendingEmail, code, sim: c.sim, simCode: c.code, verdict: c.verdict, budget: c.budget, tier: c.tier, summary: c.summary, link: c.link });
    if (!j.ok) { msg.textContent = j.error || 'Code incorrect.'; return; }
    acct = j.account; msg.textContent = '';
    if (await openSim(false)) {
      $('sx-status').textContent = 'Analyse complète débloquée. Elle est enregistrée dans votre espace client.';
      if (V3) setTimeout(() => $('t-verdict').scrollIntoView({ behavior: 'smooth', block: 'start' }), 150);
    } else goGate();
  });
  $('g-use').addEventListener('click', async () => { if (await openSim(true)) $('sx-status').textContent = 'Nouvelle simulation complète ouverte, avec son dossier.'; });
  gate.querySelectorAll<HTMLElement>('[data-buy]').forEach((b) => b.addEventListener('click', () => checkout(b.dataset.buy!, '', location.pathname + location.search, $('pay-msg'))));

  // Dossier de décision
  $('dos-buy').addEventListener('click', async () => {
    const msg = $('dos-msg');
    if (!acct) { msg.textContent = 'Créez d’abord votre accès : la première simulation complète est offerte.'; goGate(); return; }
    if (!simRec) { msg.textContent = 'Ouvrez d’abord une simulation complète sur cette page.'; goGate(); return; }
    sendUsage('dossier');
    await api('/api/sim/save', { id: simRec.id, q: qNow() });
    const j = await api('/api/sim/dossier', { id: simRec.id });
    if (j.ok && j.id) { location.href = `/dossier/?id=${j.id}`; return; }
    if (j.need === 'confirm') {
      msg.innerHTML = `Il vous reste ${j.credits} crédit${j.credits > 1 ? 's' : ''}. <button type="button" class="sx-dinline" id="dos-use">Utiliser 1 crédit pour ce dossier</button>`;
      $('dos-use').addEventListener('click', async () => { const k = await api('/api/sim/dossier', { id: simRec.id, confirm: true }); if (k.ok && k.id) location.href = `/dossier/?id=${k.id}`; else msg.textContent = k.error || 'Opération impossible.'; });
      return;
    }
    checkout('credit', simRec.id, `/dossier/?id=${simRec.id}`, msg);
  });

  (async () => {
    const j = await api('/api/me');
    if (j.account) { acct = j.account; await openSim(false); usageSent = 0; utmr = setTimeout(() => sendUsage('ouverture'), 8000); }
    else pane('sign');
  })();

  render();
</script>

