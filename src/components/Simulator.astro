    const bar = $('sx-nav-p'); const cue = $('sx-cue'); const navl = $('sx-nav-l');
    const firstNext = secs[1];
    let cur = '', tick = false, seen = false;
    const upd = () => {
      tick = false;
      const off = 150; let act = secs[0];
      for (const el of secs) if (el.getBoundingClientRect().top <= off) act = el;
      if (act.id !== cur) {
        cur = act.id;
        links.forEach((a) => { const on = a.dataset.s === cur; a.classList.toggle('on', on); if (on) a.setAttribute('aria-current', 'true'); else a.removeAttribute('aria-current'); });
