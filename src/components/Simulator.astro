    $('s-net').textContent = sMoney(mc.net.p50); $('s-nets').textContent = `De ${sMoney(mc.net.p10)} à ${sMoney(mc.net.p90)}, 8 chances sur 10`;
    hist(r); tornado(sens, r.net);
    $('g-rtab').innerHTML = `<thead><tr><th></th><th>Favorable</th><th>Médian</th><th>Défavorable</th></tr></thead><tbody>
