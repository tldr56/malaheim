  const goGate = () => { gate.scrollIntoView({ behavior: 'smooth', block: 'center' }); setTimeout(() => (gate.querySelector('[data-pane]:not([hidden]) input:not([type=checkbox]):not([tabindex="-1"])') as HTMLInputElement | null)?.focus({ preventScroll: true }), 500); };
  $('lockbar-go').addEventListener('click', goGate);
