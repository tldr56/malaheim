---
import Base from '../layouts/Base.astro';
import { SITE, SOFTWARE, GUIDES, KITS } from '../config';
const kitTotal = KITS.reduce((n, k) => n + k.reqs, 0);
const check = '<svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="5 12.5 10 17 19 7.5"></polyline></svg>';
const bookHref = SITE.bookingUrl || '/accompagnement/#contact';
const short: Record<string, string> = {
  wms: "Mon stock est faux et les erreurs de préparation s'accumulent",
  tms: 'Mes coûts de transport dérapent',
  erp: 'Mes outils de gestion ne se parlent plus',
  'automatisation-wcs': 'Mon entrepôt sature et je manque de bras',
  oms: 'Je vends sur plusieurs canaux et je promets mal les délais',
  'sop-planification': "J'ai des ruptures et des surstocks en même temps",
  'donnees-pilotage': 'Mes données sont fausses, chacun a ses propres chiffres',
};
const pains = [...SOFTWARE.map((s) => ({ slug: s.slug, code: s.code, t: short[s.slug] })), { slug: 'autre', code: '?', t: "J'ai plusieurs problèmes, ou je ne sais pas par où commencer" }];
const ticker = ["Gestion d'entrepôt", 'Transport', 'S&OP', 'ERP', 'Commandes omnicanal', 'Automatisation', 'Données de référence', 'Tour de contrôle', 'Recette', 'Conduite du changement', 'Schéma directeur', 'Intégration d’usines'];
const faq = [
  { q: 'Que propose Malaheim ?', a: "Deux choses : des outils pour choisir le bon logiciel supply chain (guides, simulateurs, kits de consultation) et du conseil en transformation digitale, du diagnostic au déploiement." },
  { q: 'Quels kits de consultation proposez-vous ?', a: "Sept kits, un par famille de logiciels : WMS, TMS, ERP, S&OP et planification, automatisation et WCS, OMS, données et pilotage. Chacun contient un cahier des charges de 130 à 268 exigences, des scénarios de démonstration, une grille de dépouillement, une check-list contractuelle en 30 points et un plan de recette." },
  { q: "Je ne sais pas de quel logiciel j'ai besoin. Par où commencer ?", a: "Cliquez en haut de cette page sur le problème qui vous ressemble le plus. Si plusieurs vous ressemblent, choisissez la dernière case : un appel gratuit de 30 minutes suffit pour trouver le premier chantier." },
  { q: 'Malaheim peut-il accompagner mon entreprise ?', a: "Oui, de la TPE au grand groupe, partout en France et à distance, en français ou en anglais. L'offre s'adapte à votre taille : le kit si vous avancez seul, la relecture pour un second avis, l'accompagnement à l'heure pour un besoin précis ou un projet complet. Vous ne payez que ce que vous utilisez." },
  { q: "Combien coûte l'accompagnement ?", a: `Le kit coûte ${SITE.kitPrice}. La relecture de votre cahier des charges coûte ${SITE.reviewPrice}, prix du kit déduit. Au-delà, l'accompagnement est facturé ${SITE.hourlyRate} de l'heure, au temps réellement passé, avec une estimation écrite avant de commencer.` },
  { q: 'Vos recommandations sont-elles indépendantes ?', a: "Oui. Aucun éditeur ne paie pour être cité ou recommandé, et aucune donnée n'est transmise à des éditeurs ou des intégrateurs." },
  { q: 'Les chiffres sont-ils fiables ?', a: "Ce sont des ordres de grandeur issus de sources publiées, citées sur chaque page. Ils servent à cadrer un budget, pas à remplacer un devis." },
  { q: 'Et si un kit ne me convient pas ?', a: "Vous êtes remboursé sur simple demande dans les 14 jours suivant l'achat, sans justification." },
];
const lags = ['', 'lag1', 'lag2', 'lag3', 'lag4', 'lag5'];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.company,
  url: SITE.url,
  description: 'Choix de logiciels supply chain et conseil en transformation digitale.',
  founder: { '@type': 'Person', name: SITE.author },
};
---
<Base title="Accueil" description="Malaheim Consulting accompagne toutes les entreprises, de la TPE au groupe, dans le choix et le déploiement de leurs logiciels supply chain, à un prix adapté : kits à 149 € HT, expert à l'heure." jsonLd={jsonLd}>

  <section id="orientation" class="wrap hero" aria-labelledby="titre-accueil">
    <div class="stack hero-text">
      <p class="eyebrow rise">Qui que vous soyez, où que vous soyez</p>
      <h1 id="titre-accueil" class="h1 hero-title rise d1">Quel est votre problème&#8239;?</h1>
      <p class="lead rise d2">Quelle que soit la taille de votre entreprise, {SITE.company} vous accompagne, à un prix adapté. Cliquez sur le problème qui vous ressemble : vous voyez tout de suite le logiciel qu'il vous faut, ce qu'il coûte et comment le choisir.</p>
    </div>

    <div class="pick">
      <div class="tiles" role="group" aria-label="Votre problème">
        {pains.map((p, i) => (
          <button type="button" class={`card tile-btn rise d${Math.min(i + 2, 5)}`} data-for={p.slug} aria-pressed="false" aria-controls="reponse">
            <span class="tb-code">{p.code}</span>
            <span class="tb-t">{p.t}</span>
            <span class="tb-go" aria-hidden="true">→</span>
          </button>
        ))}
      </div>

      <div class="card reponse rise d3" id="reponse" aria-live="polite">
        <div class="answer" data-for="none">
          <span class="ans-k">Votre réponse s'affiche ici</span>
          <p class="ans-big">Un clic sur votre problème, et vous savez quoi faire.</p>
          <ul class="ans-steps">
            <li><strong>{SITE.kitPrice}</strong><span>le kit pour choisir seul, sans service achats</span></li>
            <li><strong>{SITE.reviewPrice}</strong><span>la relecture experte de votre cahier des charges</span></li>
            <li><strong>{SITE.hourlyRate} / h</strong><span>un expert à l'heure, au temps réellement passé</span></li>
          </ul>
          <ul class="trust">
            <li><Fragment set:html={check} />Indépendant des éditeurs</li>
            <li><Fragment set:html={check} />Satisfait ou remboursé 14 jours</li>
          </ul>
        </div>
        {SOFTWARE.map((s) => {
          const k = KITS.find((x) => x.sw === s.slug)!;
          return (
            <div class="answer" data-for={s.slug} hidden>
              <span class="ans-k">Il vous faut</span>
              <div class="row" style="align-items: center; gap: 10px">
                <span class="code">{s.code}</span>
                <span class="ans-t">{s.long}</span>
              </div>
              <p class="ans-d">{s.does}.</p>
              <div class="row" style="gap: 10px">
                <div class="tile" style="flex: 1 1 150px"><div class="tile-k">Budget indicatif</div><div class="tile-v small">{s.budget}</div></div>
                <div class="tile" style="flex: 1 1 120px"><div class="tile-k">Délai</div><div class="tile-v small">{s.delay}</div></div>
              </div>
              <a class="btn btn-gold ans-cta" href={`/kits/${k.page}/`}>Le kit pour choisir votre {s.code}, {SITE.kitPrice} <span class="arrow" aria-hidden="true">→</span></a>
              <a class="btn btn-line ans-cta" href={bookHref}>Parler 30 min à un expert, gratuit</a>
              <p class="ans-more"><a href={`/logiciels/${s.slug}/`}>Lire d'abord le guide gratuit</a>{s.status === 'complet' && <> ou <a href="/simulateur-wms/">estimer mon budget</a></>}</p>
            </div>
          );
        })}
        <div class="answer" data-for="autre" hidden>
          <span class="ans-k">Commençons par en parler</span>
          <p class="ans-big">Plusieurs problèmes à la fois, c'est le cas le plus courant.</p>
          <p class="ans-d">En 30 minutes au téléphone, on identifie ce qui coûte le plus cher aujourd'hui et le premier chantier à lancer. Gratuit et sans engagement.</p>
          <a class="btn btn-gold ans-cta" href={bookHref}>Réserver un appel gratuit de 30 min <span class="arrow" aria-hidden="true">→</span></a>
          <a class="btn btn-line ans-cta" href="/conseil/">Voir le conseil à l'heure</a>
        </div>
      </div>
    </div>
  </section>

  <section class="ticker" aria-label="Domaines couverts">
    <p class="sr-only">Domaines couverts : {ticker.join(', ')}.</p>
    <div class="ticker-track" aria-hidden="true">
      {[0, 1].map(() => (
        <div class="ticker-row">
          {ticker.map((t) => <span class="tick">{t}<i class="dot"></i></span>)}
        </div>
      ))}
    </div>
  </section>

  <section class="section pme" aria-labelledby="titre-pme" style="padding-top: 0">
    <div class="wrap stack" style="gap: 32px">
      <div class="stack" style="gap: 12px; max-width: 760px">
        <p class="eyebrow sr-left">Un prix adapté à votre taille</p>
        <h2 id="titre-pme" class="h2 sr-left lag1">Vous ne payez que ce dont vous avez besoin</h2>
        <p class="lead sr-left lag2" style="font-size: 17px">Une TPE n'a pas le budget d'un cabinet, un grand groupe n'a pas besoin d'un forfait de plusieurs semaines pour un besoin précis. Avec Malaheim, chacun monte la marche qui lui convient : le kit pour avancer seul, la relecture pour un second avis, l'expert à l'heure pour le reste.</p>
      </div>
      <div class="row" style="gap: 18px">
        <a class="card card-lift pme-c sr-up" href="/kits/">
          <span class="pme-n">1</span>
          <span class="pme-p">{SITE.kitPrice}</span>
          <h3 class="pme-t">Le kit fait le travail d'une équipe</h3>
          <p>Cahier des charges rédigé, priorités pré-remplies, scénarios, grille de notation, contrat, recette.</p>
        </a>
        <a class="card card-lift pme-c sr-up lag1" href="/accompagnement/">
          <span class="pme-n">2</span>
          <span class="pme-p">{SITE.reviewPrice}</span>
          <h3 class="pme-t">Une relecture experte</h3>
          <p>Votre cahier des charges annoté et une heure de visio avant l'envoi aux éditeurs.</p>
        </a>
        <a class="card card-lift pme-c sr-up lag2" href="/accompagnement/">
          <span class="pme-n">3</span>
          <span class="pme-p">{SITE.hourlyRate} / h</span>
          <h3 class="pme-t">Un expert à l'heure, au réel</h3>
          <p>Démonstrations, analyse des offres, négociation, démarrage : seul le temps passé est facturé.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="titre-conseil" style="padding-top: 0">
    <div class="wrap">
      <a class="card card-lift conseil-band sr-up" href="/conseil/">
        <div class="stack" style="gap: 8px; flex: 1 1 420px; min-width: 0">
          <span class="ans-k">Plutôt une transformation à conduire ?</span>
          <h2 id="titre-conseil" class="h3" style="font-size: 24px">Diagnostic, schéma directeur, direction de projet : un expert à l'heure</h2>
          <p class="ans-d">Pour toutes les tailles d'entreprise, partout en France et à distance. {SITE.hourlyRate} de l'heure, au temps réellement passé, estimation écrite avant de commencer.</p>
        </div>
        <span class="btn btn-amber">Découvrir le conseil <span class="arrow" aria-hidden="true">→</span></span>
      </a>
    </div>
  </section>

  <section class="section" aria-labelledby="titre-outils">
    <div class="wrap stack" style="gap: 40px">
      <div class="row" style="gap: 24px; align-items: flex-end; justify-content: space-between">
        <div class="stack" style="gap: 14px; max-width: 640px">
          <p class="eyebrow sr-left">Les outils</p>
          <h2 id="titre-outils" class="h2 sr-left lag1">De quoi décider seul, ou presque</h2>
        </div>
        <a class="sr-right" href="/kits/" style="font-weight: 600; text-decoration: none">Tous les kits <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <div class="bento">
        <a class="card card-lift b-sim sr-up" href="/simulateur-wms/">
          <span class="b-k">Simulateur gratuit</span>
          <h3 class="b-t">Combien va coûter votre WMS ?</h3>
          <p class="b-d">Gamme, budget, délai et retour sur investissement en 8 questions.</p>
          <div class="b-meter" aria-hidden="true">
            <div class="m-row"><span>Intégration</span><span class="m-bar"><i style="width: 86%"></i></span></div>
            <div class="m-row"><span>Matériel</span><span class="m-bar"><i style="width: 44%"></i></span></div>
            <div class="m-row"><span>Interfaces</span><span class="m-bar"><i style="width: 38%"></i></span></div>
            <div class="m-row"><span>Formation</span><span class="m-bar"><i style="width: 18%"></i></span></div>
          </div>
          <span class="b-go">Lancer le simulateur <span class="arrow" aria-hidden="true">→</span></span>
        </a>
        <a class="card card-lift card-hi b-kit sr-up lag1" href="/kits/">
          <span class="b-k">Kits de consultation</span>
          <h3 class="b-t">Toute la consultation, du cahier des charges au contrat</h3>
          <div class="row" style="gap: 8px">
            {KITS.map((k) => <span class="chip">{k.code}</span>)}
          </div>
          <ul class="b-list">
            <li>{kitTotal.toLocaleString('fr-FR')} exigences commentées sur 7 kits</li>
            <li>Scénarios de démonstration imposés</li>
            <li>Check-list contractuelle en 30 points</li>
            <li>Plans de recette, 40 % de cas d'exception</li>
          </ul>
          <span class="b-price">{SITE.kitFrom} le kit</span>
          <span class="b-go">Voir les 7 kits <span class="arrow" aria-hidden="true">→</span></span>
        </a>
        <a class="card card-lift b-guides sr-up lag2" href="/guides/">
          <span class="b-k">Guides gratuits</span>
          <h3 class="b-t">Prix, étapes, erreurs, gammes, SaaS ou licence</h3>
          <div class="row" style="gap: 8px">
            {GUIDES.map((g) => <span class="chip">{g.figure}</span>)}
          </div>
          <span class="b-go">Lire les guides <span class="arrow" aria-hidden="true">→</span></span>
        </a>
        <a class="card card-lift b-call sr-up lag3" href="/conseil/">
          <span class="b-k">Conseil</span>
          <h3 class="b-t">30 minutes pour y voir clair</h3>
          <p class="b-d">Un appel gratuit pour qualifier le besoin et le bon format d'intervention.</p>
          <span class="b-go">Réserver un appel <span class="arrow" aria-hidden="true">→</span></span>
        </a>
      </div>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="titre-apropos">
    <div class="wrap row about-in">
      <div class="photo card sr-left" role="img" aria-label="Emplacement de la photo de Robin Thomas-Le Déoré">[Votre photo]</div>
      <div class="stack about-text">
        <p class="eyebrow sr-right">Qui est derrière Malaheim</p>
        <h2 id="titre-apropos" class="h2 sr-right lag1">{SITE.author}</h2>
        <p class="lead sr-right lag2">Fondateur de {SITE.company}, consultant supply chain indépendant à Rennes. Je dirige des projets de systèmes d'information logistiques et industriels : sélection et déploiement de WMS et de WCS, intégration d'usines, montées de version, pilotage d'équipes.</p>
        <p class="lead sr-right lag3">Passé par GEODIS et KPMG, j'enseigne aussi la logistique en master.</p>
        <div class="row sr-up lag3" style="gap: 10px">
          <span class="chip">Sélection de logiciels</span>
          <span class="chip">WMS, WCS et automatisation</span>
          <span class="chip">Intégration d'usines</span>
          <span class="chip">Pilotage de projets SI</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="titre-faq">
    <div class="wrap row" style="gap: 56px; align-items: flex-start">
      <div class="stack sr-left" style="flex: 1 1 320px; gap: 16px">
        <p class="eyebrow">Questions fréquentes</p>
        <h2 id="titre-faq" class="h2">Vos questions, nos réponses</h2>
        <p class="lead" style="font-size: 17px">Une autre question ? <a href="/a-propos/#contact">Écrivez-moi</a>, je réponds sous 48 heures.</p>
      </div>
      <div class="card stack faq sr-right" style="flex: 1 1 520px; padding: 8px 28px">
        {faq.map((f) => (
          <details class="faq-item">
            <summary>{f.q}<span class="plus" aria-hidden="true"></span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section aria-labelledby="titre-final" class="final">
    <div class="wrap">
      <div class="final-in stack center sr-zoom">
        <h2 id="titre-final" class="h2" style="max-width: 15em">Votre projet supply chain démarre dans les 12 prochains mois ?</h2>
        <p style="margin: 0; font-size: 19px; max-width: 32em">Commencez par la bonne question. L'orientation prend une minute, l'appel de cadrage trente.</p>
        <div class="row" style="gap: 12px; justify-content: center">
          <a class="btn btn-gold btn-lg" href="#orientation">Choisir mon problème <span class="arrow" aria-hidden="true">→</span></a>
          <a class="btn btn-line btn-lg" href="/conseil/">Être conseillé</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // Orientation directe : un clic sur un problème affiche la réponse
  const btns = Array.from(document.querySelectorAll<HTMLButtonElement>('.tile-btn'));
  const answers = Array.from(document.querySelectorAll<HTMLElement>('.answer'));
  const panel = document.getElementById('reponse');
  const show = (slug: string, scroll: boolean) => {
    answers.forEach((a) => { a.hidden = a.dataset.for !== slug; });
    btns.forEach((b) => { const on = b.dataset.for === slug; b.classList.toggle('is-on', on); b.setAttribute('aria-pressed', String(on)); });
    if (scroll && panel && window.matchMedia('(max-width: 900px)').matches) panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
  };
  btns.forEach((b) => b.addEventListener('click', () => { show(b.dataset.for!, true); history.replaceState(null, '', `#${b.dataset.for}`); }));
  const initial = location.hash.slice(1);
  if (initial && btns.some((b) => b.dataset.for === initial)) show(initial, false);
</script>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .code { align-self: flex-start; font-family: var(--display); font-weight: 600; font-size: 13px; letter-spacing: .04em; color: #111317; background: linear-gradient(135deg, #f0cf7f, #e3a654); border-radius: 8px; padding: 3px 9px; }

  /* Haut de page : orientation directe */
  .hero { display: flex; flex-direction: column; gap: 30px; padding-block: 52px 72px; }
  .hero-text { max-width: 820px; gap: 18px; }
  .hero-title { font-size: clamp(42px, 5.6vw, 76px); line-height: 1.02; }
  .trust { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px 22px; color: var(--muted); font-size: 14.5px; }
  .trust li { display: flex; align-items: center; gap: 8px; }
  .trust :global(svg) { color: var(--good); }
  .pick { display: flex; flex-wrap: wrap; gap: 24px; align-items: flex-start; }
  .tiles { flex: 1 1 560px; min-width: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  @media (max-width: 620px) { .tiles { grid-template-columns: 1fr; } }
  .tile-btn { position: relative; display: flex; align-items: center; gap: 14px; text-align: left; padding: 18px 44px 18px 18px; min-height: 84px; cursor: pointer; font: inherit; color: var(--text-strong); transition: transform .25s var(--ease), border-color .25s, background-color .25s, box-shadow .25s; }
  .tile-btn:hover { transform: translateY(-3px); border-color: rgba(201,162,75,.6); }
  .tile-btn:focus-visible { outline: 2px solid var(--gold-soft); outline-offset: 3px; }
  .tile-btn.is-on { border-color: rgba(201,144,46,.85); background: rgba(255,244,222,.9); box-shadow: 0 0 0 3px rgba(227,166,84,.25), var(--shadow); }
  .tb-code { flex: none; min-width: 52px; text-align: center; font-family: var(--display); font-weight: 600; font-size: 13px; letter-spacing: .04em; color: #111317; background: linear-gradient(135deg, #f0cf7f, #e3a654); border-radius: 8px; padding: 5px 8px; }
  .tb-t { font-weight: 600; font-size: 16px; line-height: 1.35; }
  .tb-go { position: absolute; right: 18px; top: 50%; transform: translateY(-50%); color: var(--gold-soft); font-weight: 700; transition: transform .25s var(--ease); }
  .tile-btn:hover .tb-go, .tile-btn.is-on .tb-go { transform: translate(4px, -50%); }
  .reponse { flex: 1 1 380px; min-width: 0; padding: 26px; position: sticky; top: 96px; scroll-margin-top: 90px; }
  @media (max-width: 900px) { .reponse { position: static; } }
  .ans-k { font-size: 12px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--gold-soft); }
  .ans-big { margin: 0; font-family: var(--display); font-weight: 600; font-size: 22px; line-height: 1.3; letter-spacing: -0.01em; color: var(--text-strong); }
  .ans-steps { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .ans-steps li { display: flex; gap: 12px; align-items: baseline; font-size: 15px; color: var(--muted); }
  .ans-steps strong { flex: none; min-width: 96px; font-family: var(--display); font-size: 18px; color: var(--gold-soft); }
  .ans-cta { justify-content: center; text-align: center; }
  .ans-more { margin: 0; font-size: 14.5px; color: var(--dim); }
  .conseil-band { display: flex; flex-wrap: wrap; gap: 24px; align-items: center; padding: 28px 32px; text-decoration: none; color: var(--text); background: rgba(255,247,234,.66); }
  .code { align-self: flex-start; }

  /* Bandeau defilant */
  .ticker { position: relative; z-index: 1; overflow: hidden; padding-block: 18px; background: rgba(255,255,255,.4); -webkit-backdrop-filter: var(--blur); backdrop-filter: var(--blur); border-block: 1px solid rgba(255,255,255,.8); }
  .ticker-track { display: flex; width: max-content; animation: scroll 40s linear infinite; }
  .ticker-row { display: flex; }
  .tick { display: inline-flex; align-items: center; gap: 28px; padding-right: 28px; font-family: var(--display); font-weight: 600; font-size: 18px; letter-spacing: -0.01em; color: var(--text-strong); white-space: nowrap; }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: linear-gradient(135deg, #e3b553, #d9893f); display: inline-block; }
  @keyframes scroll { to { transform: translateX(-50%); } }
  .ticker:hover .ticker-track { animation-play-state: paused; }

  .answer { display: flex; flex-direction: column; gap: 14px; animation: pop .45s var(--ease); }
  .answer[hidden] { display: none; }
  @keyframes pop { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  .ans-t { font-family: var(--display); font-weight: 600; font-size: 18px; color: var(--text-strong); }
  .ans-d { margin: 0; color: var(--muted); font-size: 15px; }
