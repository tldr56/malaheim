---
import Base from '../layouts/Base.astro';
import { SITE, SOFTWARE, GUIDES, KITS } from '../config';
const kitTotal = KITS.reduce((n, k) => n + k.reqs, 0);
const check = '<svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="5 12.5 10 17 19 7.5"></polyline></svg>';
const bookHref = SITE.bookingUrl || '/accompagnement/#contact';

// Code-barres décoratif, déterministe pour chaque référence
const bars = (ref: string) => {
  let x = 0; let rects = '';
  const seed = Array.from(`MALAHEIM-${ref}-KIT`).map((c) => c.charCodeAt(0));
  for (let i = 0; i < 34; i++) {
    const v = seed[i % seed.length] + i * 7;
    const w = (v % 3) + 1; const gap = ((v >> 2) % 2) + 1;
    rects += `<rect x="${x}" y="0" width="${w}" height="34"/>`;
    x += w + gap;
  }
  return `<svg class="lbl-bars" viewBox="0 0 ${x} 34" preserveAspectRatio="none" aria-hidden="true" fill="currentColor">${rects}</svg>`;
};

const short: Record<string, string> = {
  wms: "Mon stock est faux et les erreurs de préparation s'accumulent",
  tms: 'Mes coûts de transport dérapent',
  erp: 'Mes outils de gestion ne se parlent plus',
  'automatisation-wcs': 'Mon entrepôt sature et je manque de bras',
  oms: 'Je vends sur plusieurs canaux et je promets mal les délais',
  'sop-planification': "J'ai des ruptures et des surstocks en même temps",
  'donnees-pilotage': 'Mes données sont fausses, chacun a ses propres chiffres',
};
const pains = [...SOFTWARE.map((s) => ({ slug: s.slug, code: s.code, t: short[s.slug] })), { slug: 'autre', code: '?', t: "J'ai plusieurs problèmes, ou je ne sais pas par où commencer" }];

// La chaîne logistique animée : chaque étape correspond à un logiciel
const nodes = [
  { slug: 'sop-planification', code: 'S&OP', cap: 'Planification', x: 36, y: 40 },
  { slug: 'erp', code: 'ERP', cap: 'Gestion', x: 36, y: 200 },
  { slug: 'donnees-pilotage', code: 'DATA', cap: 'Données', x: 36, y: 360 },
  { slug: 'wms', code: 'WMS', cap: 'Entrepôt', x: 200, y: 50 },
  { slug: 'automatisation-wcs', code: 'WCS', cap: 'Automatismes', x: 200, y: 180 },
  { slug: 'oms', code: 'OMS', cap: 'Commandes', x: 470, y: 36 },
  { slug: 'tms', code: 'TMS', cap: 'Transport', x: 470, y: 130 },
];
const flows = [
  { id: 'f1', d: 'M102 98 L102 200', dur: 3.2, n: 1 },
  { id: 'f2', d: 'M168 229 C 190 229 180 79 200 79', dur: 3.6, n: 2 },
  { id: 'f3', d: 'M640 65 L602 65', dur: 1.6, n: 1 },
  { id: 'f4', d: 'M470 65 C 410 65 380 72 332 72', dur: 2.8, n: 2 },
  { id: 'f5', d: 'M332 92 C 400 100 420 159 470 159', dur: 3.2, n: 2 },
  { id: 'f6', d: 'M602 159 L640 159', dur: 1.6, n: 1 },
  { id: 'f7', d: 'M266 108 L266 180', dur: 2.4, n: 1 },
  { id: 'f8', d: 'M102 360 L102 258', dur: 3.2, n: 1 },
  { id: 'f9', d: 'M168 389 C 250 389 300 300 300 108', dur: 4.4, n: 1, dash: true },
];
const nodeDelay = (i: number) => `${0.5 + i * 0.12}s`;

const proofs = [
  { n: kitTotal, suffix: '', t: 'exigences rédigées et commentées', d: 'dans les 7 kits de consultation' },
  { n: 7, suffix: '', t: 'familles de logiciels couvertes', d: 'du WMS aux données de référence' },
  { n: 40, suffix: ' %', t: 'de cas d’exception dans chaque recette', d: 'là où naissent les incidents de démarrage' },
  { n: 0, suffix: ' €', t: 'de commission éditeur', d: 'des recommandations sans conflit d’intérêt' },
];

const why = [
  { t: 'Indépendant', d: 'Aucun éditeur ne paie pour être cité ou recommandé. Vos données ne sont transmises à personne.' },
  { t: 'Né du terrain', d: 'Une expertise forgée dans le conseil, la logistique, l’industrie et la banque, sur des projets WMS, automatisation, ERP et données.' },
  { t: 'Méthodique', d: 'Exigences priorisées, démonstrations sur vos données, recette centrée sur les exceptions : la méthode des grands projets, à votre échelle.' },
  { t: 'Au juste prix', d: `Un kit à ${SITE.kitPrice}, une relecture à ${SITE.reviewPrice}, un expert à ${SITE.hourlyRate} de l'heure. Vous payez ce que vous utilisez.` },
];

const ticker = ["Gestion d'entrepôt", 'Transport', 'S&OP', 'ERP', 'Commandes omnicanal', 'Automatisation', 'Données de référence', 'Tour de contrôle', 'Recette', 'Conduite du changement', 'Schéma directeur', 'Intégration d’usines'];
const faq = [
  { q: 'Que propose Malaheim ?', a: "Deux choses : des outils pour choisir le bon logiciel supply chain (guides, simulateur, kits de consultation) et du conseil en transformation digitale, du diagnostic au déploiement." },
  { q: 'Quels kits de consultation proposez-vous ?', a: "Sept kits, un par famille de logiciels : WMS, TMS, ERP, S&OP et planification, automatisation et WCS, OMS, données et pilotage. Chacun contient un cahier des charges de 130 à 268 exigences, des scénarios de démonstration, une grille de dépouillement, une check-list contractuelle en 30 points et un plan de recette." },
  { q: "Je ne sais pas de quel logiciel j'ai besoin. Par où commencer ?", a: "Cliquez en haut de cette page sur le problème qui vous ressemble le plus. Si plusieurs vous ressemblent, choisissez la dernière case : un appel gratuit de 30 minutes suffit pour trouver le premier chantier." },
  { q: 'Malaheim peut-il accompagner mon entreprise ?', a: "Oui, de la TPE au grand groupe, partout en France et à distance, en français ou en anglais. L'offre s'adapte à votre taille : le kit si vous avancez seul, la relecture pour un second avis, l'accompagnement à l'heure pour un besoin précis ou un projet complet." },
  { q: "Combien coûte l'accompagnement ?", a: `Le kit coûte ${SITE.kitPrice}. La relecture de votre cahier des charges coûte ${SITE.reviewPrice}, prix du kit déduit. Au-delà, l'accompagnement est facturé ${SITE.hourlyRate} de l'heure, au temps réellement passé, avec une estimation écrite avant de commencer.` },
  { q: 'Vos recommandations sont-elles indépendantes ?', a: "Oui. Aucun éditeur ne paie pour être cité ou recommandé, et aucune donnée n'est transmise à des éditeurs ou des intégrateurs." },
  { q: 'Les chiffres sont-ils fiables ?', a: "Ce sont des ordres de grandeur issus de sources publiées, citées sur chaque page. Ils servent à cadrer un budget, pas à remplacer un devis." },
  { q: 'Et si un kit ne me convient pas ?', a: "Vous êtes remboursé sur simple demande dans les 14 jours suivant l'achat, sans justification." },
];
const lags = ['', 'lag1', 'lag2', 'lag3', 'lag4', 'lag5'];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.company,
  url: SITE.url,
  description: 'Choix de logiciels supply chain et conseil en transformation digitale.',
};
---
<Base title="Accueil" description="Malaheim Consulting accompagne toutes les entreprises, de la TPE au groupe, dans le choix et le déploiement de leurs logiciels supply chain, à un prix adapté : kits à 149 € HT, expert à l'heure." jsonLd={jsonLd}>

  <section id="orientation" class="wrap hero" aria-labelledby="titre-accueil">
    <div class="hero-head">
      <div class="stack" style="gap: 16px">
        <p class="eyebrow rise">Qui que vous soyez, où que vous soyez</p>
        <h1 id="titre-accueil" class="h1 hero-title rise d1">Quel est votre problème&#8239;?</h1>
      </div>
      <p class="lead hero-lead rise d2">Quelle que soit la taille de votre entreprise, {SITE.company} vous accompagne, à un prix adapté. Choisissez votre problème : la chaîne logistique vous montre où il se situe, et l'étiquette vous dit quoi faire.</p>
    </div>

    <div class="hero-grid">
      <div class="tiles" role="group" aria-label="Votre problème">
        {pains.map((p, i) => (
          <button type="button" class="tile-btn rise" style={`animation-delay: ${0.3 + i * 0.06}s`} data-for={p.slug} aria-pressed="false" aria-controls="reponse">
            <span class="tb-code">{p.code}</span>
            <span class="tb-t">{p.t}</span>
          </button>
        ))}
      </div>

      <div class="scene rise d3">
        <svg class="flow" viewBox="0 0 640 520" role="img" aria-label="Chaîne logistique : planification, gestion, données, entrepôt, automatismes, commandes et transport">
          <defs>
            <filter id="glow" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="3.5" result="b" /><feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge></filter>
          </defs>
          <g class="paths">
            {flows.map((f, i) => <path id={f.id} d={f.d} class={`fl-path ${f.dash ? 'fl-dash' : ''}`} style={`animation-delay: ${0.9 + i * 0.08}s`} />)}
          </g>
          <g class="packets">
            {flows.flatMap((f) => Array.from({ length: f.n }, (_, k) => (
              <circle r="4" class="pk" filter="url(#glow)">
                <animateMotion dur={`${f.dur}s`} begin={`${1.6 + k * (f.dur / f.n)}s`} repeatCount="indefinite" rotate="auto"><mpath href={`#${f.id}`} /></animateMotion>
              </circle>
            )))}
          </g>
          {nodes.map((n, i) => (
            <g class="node" data-node={n.slug} style={`animation-delay: ${nodeDelay(i)}`} tabindex="-1">
              <rect class="nd-pulse" x={n.x} y={n.y} width="132" height="58" rx="10" />
              <rect class="nd-box" x={n.x} y={n.y} width="132" height="58" rx="10" />
              <text class="nd-code" x={n.x + 16} y={n.y + 27}>{n.code}</text>
              <text class="nd-cap" x={n.x + 16} y={n.y + 45}>{n.cap}</text>
            </g>
          ))}
          <text class="fl-legend" x="36" y="486">Flux en temps réel</text>
          <circle class="fl-live" cx="24" cy="482" r="4" />
        </svg>

        <div class="reponse" id="reponse" aria-live="polite">
          <div class="lbl-head" aria-hidden="true">
            <div><span>Expéditeur</span><strong>Malaheim Consulting</strong></div>
            <div><span>Destinataire</span><strong>Votre entreprise</strong></div>
          </div>
          <div class="answer" data-for="none">
            <div class="lbl-code">
              <span class="lbl-big lbl-wait">En attente</span>
              <span class="lbl-ref"><Fragment set:html={bars('attente')} /><span>Choisissez un problème</span></span>
            </div>
            <ul class="ans-steps">
              <li><strong>{SITE.kitPrice}</strong><span>le kit pour choisir seul</span></li>
              <li><strong>{SITE.reviewPrice}</strong><span>la relecture experte</span></li>
              <li><strong>{SITE.hourlyRate} / h</strong><span>un expert, au temps passé</span></li>
            </ul>
          </div>
          {SOFTWARE.map((s) => {
            const k = KITS.find((x) => x.sw === s.slug)!;
            return (
              <div class="answer" data-for={s.slug} hidden>
                <div class="lbl-code">
                  <span class="lbl-big">{s.code}</span>
                  <span class="lbl-ref"><Fragment set:html={bars(s.slug)} /><span>Réf. KIT-{s.code.replace('&', '')}</span></span>
                </div>
                <span class="ans-t">{s.long}</span>
                <dl class="ans-facts">
                  <div><dt>Budget</dt><dd>{s.budget}</dd></div>
                  <div><dt>Délai</dt><dd>{s.delay}</dd></div>
                </dl>
                <a class="btn btn-gold ans-cta" href={`/kits/${k.page}/`}>Le kit {s.code}, {SITE.kitPrice}</a>
                <p class="ans-more"><a href={bookHref}>Parler 30 min à un expert</a> ou <a href={`/logiciels/${s.slug}/`}>lire le guide gratuit</a></p>
              </div>
            );
          })}
          <div class="answer" data-for="autre" hidden>
            <div class="lbl-code">
              <span class="lbl-big">Appel</span>
              <span class="lbl-ref"><Fragment set:html={bars('appel')} /><span>30 min, gratuit</span></span>
            </div>
            <span class="ans-t">Plusieurs problèmes à la fois, c'est le cas le plus courant</span>
            <p class="ans-d">En 30 minutes, on identifie ce qui coûte le plus cher et le premier chantier à lancer.</p>
            <a class="btn btn-gold ans-cta" href={bookHref}>Réserver l'appel gratuit</a>
            <p class="ans-more"><a href="/conseil/">Voir le conseil à l'heure</a></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="proofs" aria-label="Malaheim en chiffres">
    <div class="wrap proofs-in">
      {proofs.map((p, i) => (
        <div class={`proof sr-up ${lags[i]}`}>
          <span class="proof-n"><span class="num" data-to={p.n}>{p.n.toLocaleString('fr-FR')}</span>{p.suffix}</span>
          <span class="proof-t">{p.t}</span>
          <span class="proof-d">{p.d}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="ticker" aria-label="Domaines couverts">
    <div class="ticker-track">
      {[0, 1].map((n) => (
        <div class="ticker-row" aria-hidden={n === 1 ? 'true' : undefined}>
          {ticker.map((t) => <span class="tick">{t}<i class="dot"></i></span>)}
        </div>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="titre-prix">
    <div class="wrap stack" style="gap: 40px">
      <div class="split-head">
        <h2 id="titre-prix" class="h2 sr-left">Vous ne payez que ce dont vous avez besoin</h2>
        <p class="lead sr-right" style="font-size: 18px">Une TPE n'a pas le budget d'un cabinet, un grand groupe n'a pas besoin d'un forfait de plusieurs semaines pour un besoin précis. Chacun monte la marche qui lui convient.</p>
      </div>
      <div class="steps">
        <a class="step sr-up" href="/kits/">
          <span class="step-n">1</span>
          <span class="step-p">{SITE.kitPrice}</span>
          <h3 class="step-t">Le kit fait le travail d'une équipe</h3>
          <p>Cahier des charges rédigé, priorités pré-remplies, scénarios, grille de notation, contrat, recette.</p>
        </a>
        <a class="step sr-up lag1" href="/accompagnement/">
          <span class="step-n">2</span>
          <span class="step-p">{SITE.reviewPrice}</span>
          <h3 class="step-t">Une relecture experte</h3>
          <p>Votre cahier des charges annoté et une heure de visio avant l'envoi aux éditeurs.</p>
        </a>
        <a class="step sr-up lag2" href="/accompagnement/">
          <span class="step-n">3</span>
          <span class="step-p">{SITE.hourlyRate} / h</span>
          <h3 class="step-t">Un expert, au temps réellement passé</h3>
          <p>Démonstrations, analyse des offres, négociation, démarrage : seul le temps passé est facturé.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="titre-outils">
    <div class="wrap stack" style="gap: 40px">
      <div class="split-head">
        <h2 id="titre-outils" class="h2 sr-left">De quoi décider seul, ou presque</h2>
        <a class="sr-right" href="/kits/" style="font-weight: 650; text-decoration: none; align-self: flex-end">Voir les 7 kits</a>
      </div>
      <div class="bento">
        <a class="card card-lift b-sim sr-up" href="/simulateur-wms/">
          <span class="b-k">Simulateur gratuit</span>
          <h3 class="b-t">Combien va coûter votre WMS ?</h3>
          <p class="b-d">Gamme, budget, délai et retour sur investissement en 8 questions.</p>
          <div class="b-meter" aria-hidden="true">
            <div class="m-row"><span>Intégration</span><span class="m-bar"><i style="--w: 86%"></i></span></div>
            <div class="m-row"><span>Matériel</span><span class="m-bar"><i style="--w: 44%"></i></span></div>
            <div class="m-row"><span>Interfaces</span><span class="m-bar"><i style="--w: 38%"></i></span></div>
            <div class="m-row"><span>Formation</span><span class="m-bar"><i style="--w: 18%"></i></span></div>
          </div>
          <span class="b-go">Lancer le simulateur</span>
        </a>
        <a class="card card-lift card-hi b-kit sr-up lag1" href="/kits/">
          <span class="b-k">Kits de consultation</span>
          <h3 class="b-t">Toute la consultation, du cahier des charges au contrat</h3>
          <div class="row" style="gap: 8px">
            {KITS.map((k) => <span class="chip">{k.code}</span>)}
          </div>
          <ul class="b-list">
            <li>{kitTotal.toLocaleString('fr-FR')} exigences commentées</li>
            <li>Scénarios de démonstration imposés</li>
            <li>Check-list contractuelle en 30 points</li>
            <li>Plans de recette, 40 % de cas d'exception</li>
          </ul>
          <span class="b-price">{SITE.kitPrice} le kit</span>
          <span class="b-go">Voir les 7 kits</span>
        </a>
        <a class="card card-lift b-guides sr-up lag2" href="/guides/">
          <span class="b-k">Guides gratuits</span>
          <h3 class="b-t">Prix, étapes, erreurs, gammes, SaaS ou licence</h3>
          <div class="row" style="gap: 8px">
            {GUIDES.map((g) => <span class="chip">{g.figure}</span>)}
          </div>
          <span class="b-go">Lire les guides</span>
        </a>
        <a class="card card-lift b-call sr-up lag3" href="/conseil/">
          <span class="b-k">Conseil</span>
          <h3 class="b-t">Diagnostic, schéma directeur, direction de projet</h3>
          <p class="b-d">Un expert à l'heure, partout en France et à distance, estimation écrite avant de commencer.</p>
          <span class="b-go">Découvrir le conseil</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="titre-pourquoi">
    <div class="wrap stack" style="gap: 40px">
      <div class="split-head">
        <h2 id="titre-pourquoi" class="h2 sr-left">Pourquoi Malaheim</h2>
        <p class="lead sr-right" style="font-size: 18px">La rigueur d'un cabinet, l'indépendance d'un expert, le prix d'un outil.</p>
      </div>
      <div class="why">
        {why.map((w, i) => (
          <div class={`why-i sr-up ${lags[i]}`}>
            <span class="why-bar" aria-hidden="true"></span>
            <h3 class="why-t">{w.t}</h3>
            <p>{w.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="titre-faq">
    <div class="wrap row" style="gap: 56px; align-items: flex-start">
      <div class="stack sr-left" style="flex: 1 1 320px; gap: 16px">
        <h2 id="titre-faq" class="h2">Vos questions, nos réponses</h2>
        <p class="lead" style="font-size: 17px">Une autre question ? <a href="/a-propos/#contact">Écrivez-nous</a>, nous répondons sous 48 heures.</p>
      </div>
      <div class="card stack faq sr-right" style="flex: 1 1 520px; padding: 8px 28px">
        {faq.map((f) => (
          <details class="faq-item">
            <summary>{f.q}<span class="plus" aria-hidden="true"></span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section aria-labelledby="titre-final" class="final">
    <div class="wrap">
      <div class="final-in sr-zoom">
        <div class="stack" style="gap: 18px; flex: 1 1 460px">
          <h2 id="titre-final" class="h2" style="color: #fff">Votre projet supply chain démarre dans les 12 prochains mois ?</h2>
          <p style="margin: 0; font-size: 19px; color: #c8d2ea; max-width: 32em">Commencez par la bonne question. L'orientation prend une minute, l'appel de cadrage trente.</p>
        </div>
        <div class="stack" style="gap: 12px; flex: 0 1 300px">
          <a class="btn btn-gold btn-lg" href="#orientation">Choisir mon problème</a>
          <a class="btn btn-ghost btn-lg" href={bookHref}>Réserver un appel gratuit</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // Orientation : un clic sur un problème allume l'étape de la chaîne et imprime l'étiquette
  const btns = Array.from(document.querySelectorAll<HTMLButtonElement>('.tile-btn'));
  const answers = Array.from(document.querySelectorAll<HTMLElement>('.answer'));
  const nodes = Array.from(document.querySelectorAll<SVGGElement>('.node'));
  const panel = document.getElementById('reponse');
  let demo: number | undefined;
  const light = (slug: string, cls: string) => nodes.forEach((n) => n.classList.toggle(cls, n.dataset.node === slug));
  const show = (slug: string, scroll: boolean) => {
    if (demo) { window.clearInterval(demo); demo = undefined; light('', 'is-demo'); }
    answers.forEach((a) => { a.hidden = a.dataset.for !== slug; });
    btns.forEach((b) => { const on = b.dataset.for === slug; b.classList.toggle('is-on', on); b.setAttribute('aria-pressed', String(on)); });
    light(slug, 'is-on');
    if (scroll && panel && window.matchMedia('(max-width: 1180px)').matches) panel.scrollIntoView({ behavior: 'smooth', block: 'center' });
  };
  btns.forEach((b) => b.addEventListener('click', () => { show(b.dataset.for!, true); history.replaceState(null, '', `#${b.dataset.for}`); }));
  nodes.forEach((n) => n.addEventListener('click', () => { show(n.dataset.node!, false); history.replaceState(null, '', `#${n.dataset.node}`); }));
  btns.forEach((b) => {
    b.addEventListener('mouseenter', () => { if (!demo) light(b.dataset.for!, 'is-hover'); });
    b.addEventListener('mouseleave', () => light('', 'is-hover'));
  });
  const initial = location.hash.slice(1);
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (initial && btns.some((b) => b.dataset.for === initial)) show(initial, false);
  else if (!reduce) {
    // Démonstration discrète tant que le visiteur n'a pas choisi
    let i = 0;
    const order = nodes.map((n) => n.dataset.node!);
    window.setTimeout(() => { if (!btns.some((b) => b.classList.contains('is-on'))) { demo = window.setInterval(() => { light(order[i++ % order.length], 'is-demo'); }, 1700); } }, 2200);
  }

  // Compteurs animés à l'apparition
  const counters = Array.from(document.querySelectorAll<HTMLElement>('.num[data-to]'));
  const run = (el: HTMLElement) => {
    const to = Number(el.dataset.to); const t0 = performance.now(); const dur = 1400;
    const step = (t: number) => { const p = Math.min(1, (t - t0) / dur); const e = 1 - Math.pow(1 - p, 3); el.textContent = Math.round(to * e).toLocaleString('fr-FR'); if (p < 1) requestAnimationFrame(step); };
    requestAnimationFrame(step);
  };
  if (!reduce && 'IntersectionObserver' in window) {
    counters.forEach((c) => { c.textContent = '0'; });
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { run(e.target as HTMLElement); io.unobserve(e.target); } }), { threshold: 0.6 });
    counters.forEach((c) => io.observe(c));
  }
</script>

