---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { SITE, SOFTWARE, GUIDES, KITS } from '../config';
import { SIM_LIST, defaults as simDefaults, simulate as simRun, money as simMoney } from '../lib/sims.js';
const est = Object.fromEntries(SIM_LIST.map((m) => { const d = simDefaults(m); const r = simRun(m, d.i, d.a); return [m.sw, { slug: m.slug, code: m.code, budget: `${simMoney(r.low)} à ${simMoney(r.high)}`, pay: r.breakEven ? `${r.breakEven} mois` : `Au-delà de ${m.horizon} ans` }]; }));
const kitTotal = KITS.reduce((n, k) => n + k.reqs, 0);
const check = '<svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="5 12.5 10 17 19 7.5"></polyline></svg>';
const bookHref = SITE.bookingUrl || '/accompagnement/#contact';

// Code-barres décoratif, déterministe pour chaque référence
const bars = (ref: string) => {
  let x = 0; let rects = '';
  const seed = Array.from(`MALAHEIM-${ref}-KIT`).map((c) => c.charCodeAt(0));
  for (let i = 0; i < 34; i++) {
    const v = seed[i % seed.length] + i * 7;
    const w = (v % 3) + 1; const gap = ((v >> 2) % 2) + 1;
    rects += `<rect x="${x}" y="0" width="${w}" height="34"/>`;
    x += w + gap;
  }
  return `<svg class="lbl-bars" viewBox="0 0 ${x} 34" preserveAspectRatio="none" aria-hidden="true" fill="currentColor">${rects}</svg>`;
};

const short: Record<string, string> = {
  wms: "Mon stock est faux et les erreurs de préparation s'accumulent",
  tms: 'Mes coûts de transport dérapent',
  erp: 'Mes outils de gestion ne se parlent plus',
  'automatisation-wcs': 'Mon entrepôt sature et je manque de bras',
  oms: 'Je vends sur plusieurs canaux et je promets mal les délais',
  'sop-planification': "J'ai des ruptures et des surstocks en même temps",
  'donnees-pilotage': 'Mes données sont fausses, chacun a ses propres chiffres',
};
const pains = [...SOFTWARE.map((s) => ({ slug: s.slug, code: s.code, t: short[s.slug] })), { slug: 'autre', code: '?', t: "J'ai plusieurs problèmes, ou je ne sais pas par où commencer" }];

// La chaîne logistique animée : chaque étape correspond à un logiciel
const nodes = [
  { slug: 'sop-planification', code: 'S&OP', cap: 'Planification', x: 36, y: 40 },
  { slug: 'erp', code: 'ERP', cap: 'Gestion', x: 36, y: 200 },
  { slug: 'donnees-pilotage', code: 'DATA', cap: 'Données', x: 36, y: 360 },
  { slug: 'wms', code: 'WMS', cap: 'Entrepôt', x: 200, y: 50 },
  { slug: 'automatisation-wcs', code: 'WCS', cap: 'Automatismes', x: 200, y: 180 },
  { slug: 'oms', code: 'OMS', cap: 'Commandes', x: 470, y: 36 },
  { slug: 'tms', code: 'TMS', cap: 'Transport', x: 470, y: 130 },
];
const flows = [
  { id: 'f1', d: 'M102 98 L102 200', dur: 3.2, n: 1 },
  { id: 'f2', d: 'M168 229 C 190 229 180 79 200 79', dur: 3.6, n: 2 },
  { id: 'f3', d: 'M640 65 L602 65', dur: 1.6, n: 1 },
  { id: 'f4', d: 'M470 65 C 410 65 380 72 332 72', dur: 2.8, n: 2 },
  { id: 'f5', d: 'M332 92 C 400 100 420 159 470 159', dur: 3.2, n: 2 },
  { id: 'f6', d: 'M602 159 L640 159', dur: 1.6, n: 1 },
  { id: 'f7', d: 'M266 108 L266 180', dur: 2.4, n: 1 },
  { id: 'f8', d: 'M102 360 L102 258', dur: 3.2, n: 1 },
  { id: 'f9', d: 'M168 389 C 250 389 300 300 300 108', dur: 4.4, n: 1, dash: true },
];
const nodeDelay = (i: number) => `${0.5 + i * 0.12}s`;

const proofs = [
  { n: kitTotal, suffix: '', t: 'exigences rédigées et commentées', d: 'dans les 7 kits de consultation' },
  { n: 7, suffix: '', t: 'familles de logiciels couvertes', d: 'du WMS aux données de référence' },
  { n: 40, suffix: ' %', t: 'de cas d’exception dans chaque recette', d: 'là où naissent les incidents de démarrage' },
  { n: 0, suffix: ' €', t: 'de commission éditeur', d: 'des recommandations sans conflit d’intérêt' },
];

const why = [
  { t: 'Indépendant', d: 'Aucun éditeur ne paie pour être cité ou recommandé. Vos données ne sont transmises à personne.' },
  { t: 'Né du terrain', d: 'Une expertise forgée dans le conseil, la logistique, l’industrie et la banque, sur des projets WMS, automatisation, ERP et données.' },
  { t: 'Méthodique', d: 'Exigences priorisées, démonstrations sur vos données, recette centrée sur les exceptions : la méthode des grands projets, à votre échelle.' },
  { t: 'Au juste prix', d: `Un kit à ${SITE.kitPrice}, une relecture à ${SITE.reviewPrice}, un expert à ${SITE.hourlyRate} de l'heure. Vous payez ce que vous utilisez.` },
];

const faq = [
  { q: 'Que propose Malaheim ?', a: "Deux choses : des outils pour choisir le bon logiciel supply chain (guides, simulateurs, kits de consultation) et du conseil en transformation digitale, du diagnostic au déploiement." },
  { q: 'Quels kits de consultation proposez-vous ?', a: "Sept kits, un par famille de logiciels : WMS, TMS, ERP, S&OP et planification, automatisation et WCS, OMS, données et pilotage. Chacun contient un cahier des charges de 130 à 268 exigences, des scénarios de démonstration, une grille de dépouillement, une check-list contractuelle en 30 points et un plan de recette." },
  { q: "Je ne sais pas de quel logiciel j'ai besoin. Par où commencer ?", a: "Cliquez en haut de cette page sur le problème qui vous ressemble le plus. Si plusieurs vous ressemblent, choisissez la dernière case : un appel gratuit de 30 minutes suffit pour trouver le premier chantier." },
  { q: 'Malaheim peut-il accompagner mon entreprise ?', a: "Oui. L'offre est pensée pour les PME et ETI, et s'adapte aussi aux plus petites structures comme aux groupes, partout en France et à distance, en français ou en anglais. Vous ne payez que ce qui sert : le kit si vous avancez seul, la relecture pour un second avis, l'accompagnement à l'heure pour un besoin précis ou un projet complet." },
  { q: "Combien coûte l'accompagnement ?", a: `Le kit coûte ${SITE.kitPrice}. La relecture de votre cahier des charges coûte ${SITE.reviewPrice}, prix du kit déduit. Au-delà, l'accompagnement est facturé ${SITE.hourlyRate} de l'heure, au temps réellement passé, avec une estimation écrite avant de commencer.` },
  { q: 'Vos recommandations sont-elles indépendantes ?', a: "Oui. Aucun éditeur ne paie pour être cité ou recommandé, et aucune donnée n'est transmise à des éditeurs ou des intégrateurs." },
  { q: 'Les chiffres sont-ils fiables ?', a: "Ce sont des ordres de grandeur issus de sources publiées, citées sur chaque page. Ils servent à cadrer un budget, pas à remplacer un devis." },
  { q: 'Et si un kit ne me convient pas ?', a: "Vous êtes remboursé sur simple demande dans les 14 jours suivant l'achat, sans justification." },
];
const lags = ['', 'lag1', 'lag2', 'lag3', 'lag4', 'lag5'];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.company,
  url: SITE.url,
  description: 'Choix de logiciels supply chain et conseil en transformation digitale.',
};
---
<Base title="Accueil" description="MALAHEIM Consulting accompagne les PME et ETI dans le choix et le déploiement de leurs logiciels supply chain, à coût maîtrisé : simulation offerte, dossier de décision à 19 € HT, kits à 149 € HT, expert à l'heure." jsonLd={jsonLd} dock={false}>

  <section id="orientation" class="hero" aria-labelledby="titre-accueil">
    <div class="wrap hero-head">
      <p class="hero-k rise">Malaheim Consulting</p>
      <h1 id="titre-accueil" class="hero-title rise d1">Quel est votre problème&#8239;?</h1>
      <p class="hero-lead rise d2">Le bon logiciel supply chain pour votre PME ou ETI : la méthode des grands projets, à un coût maîtrisé.</p>
    </div>

    <div class="wrap">
      <div class="stage">
        <div class="glow" aria-hidden="true"><i></i><i></i></div>
        <div class="tiles" role="group" aria-label="Votre problème">
          <p class="tiles-k">Choisissez ce qui vous ressemble</p>
          {pains.map((p, i) => (
            <button type="button" class="tile-btn rise" style={`animation-delay: ${0.7 + i * 0.07}s`} data-for={p.slug} aria-pressed="false" aria-controls="reponse">
              <span class="tb-code">{p.code}</span>
              <span class="tb-t">{p.t}</span>
            </button>
          ))}
        </div>

        <div class="scene">
          <svg class="flow" viewBox="0 0 640 520" role="img" aria-label="Chaîne logistique : planification, gestion, données, entrepôt, automatismes, commandes et transport">
            <defs>
              <filter id="glow" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="3.5" result="b" /><feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge></filter>
            </defs>
            <g class="paths">
              {flows.map((f, i) => <path id={f.id} d={f.d} class={`fl-path ${f.dash ? 'fl-dash' : ''}`} style={`animation-delay: ${1.3 + i * 0.08}s`} />)}
            </g>
            <g class="packets">
              {flows.flatMap((f) => Array.from({ length: f.n }, (_, k) => (
                <circle r="3.5" class="pk" opacity="0" filter="url(#glow)">
                  <set attributeName="opacity" to="1" begin={`${2 + k * (f.dur / f.n)}s`} />
                  <animateMotion dur={`${f.dur}s`} begin={`${2 + k * (f.dur / f.n)}s`} repeatCount="indefinite" rotate="auto"><mpath href={`#${f.id}`} /></animateMotion>
                </circle>
              )))}
            </g>
            {nodes.map((n, i) => (
              <g class="node" data-node={n.slug} style={`animation-delay: ${0.9 + i * 0.12}s`}>
                <rect class="nd-pulse" x={n.x} y={n.y} width="132" height="58" rx="14" />
                <rect class="nd-box" x={n.x} y={n.y} width="132" height="58" rx="14" />
                <text class="nd-code" x={n.x + 16} y={n.y + 27}>{n.code}</text>
                <text class="nd-cap" x={n.x + 16} y={n.y + 45}>{n.cap}</text>
              </g>
            ))}
            <circle class="fl-live" cx="24" cy="482" r="4" />
            <text class="fl-legend" x="36" y="486">Flux en temps réel</text>
          </svg>

          <div class="reponse" id="reponse" aria-live="polite">
            <div class="lbl-head" aria-hidden="true">
              <div class="lbl-from"><span>Expéditeur</span><strong><Logo variant="mark" />Malaheim Consulting</strong></div>
              <div><span>Destinataire</span><strong>Votre entreprise</strong></div>
            </div>
            <div class="answer" data-for="none">
              <div class="lbl-code">
                <span class="lbl-big lbl-wait">En attente</span>
                <span class="lbl-ref"><Fragment set:html={bars('attente')} /><span>Choisissez un problème</span></span>
              </div>
              <ul class="ans-steps">
                <li><strong>{SITE.kitPrice}</strong><span>le kit pour choisir seul</span></li>
                <li><strong>{SITE.reviewPrice}</strong><span>la relecture experte</span></li>
                <li><strong>{SITE.hourlyRate} / h</strong><span>un expert, au temps passé</span></li>
              </ul>
            </div>
            {SOFTWARE.map((s) => {
              const k = KITS.find((x) => x.sw === s.slug)!;
              return (
                <div class="answer" data-for={s.slug} hidden>
                  <div class="lbl-code">
                    <span class="lbl-big">{s.code}</span>
                    <span class="lbl-ref"><Fragment set:html={bars(s.slug)} /><span>Réf. KIT-{s.code.replace('&', '')}</span></span>
                  </div>
                  <span class="ans-t">{s.long}</span>
                  <dl class="ans-facts" data-est={est[s.slug].slug}>
                    <div><dt>Budget estimé</dt><dd data-k="budget">{est[s.slug].budget}</dd></div>
                    <div><dt>Rentabilisé en</dt><dd data-k="pay">{est[s.slug].pay}</dd></div>
                  </dl>
                  <a class="ans-adj" href="#simus"><span data-k="note">Profil type.</span> Ajuster à vos volumes</a>
                  <a class="btn btn-gold ans-cta" href={`/kits/${k.page}/`}>Le kit {s.code}, {SITE.kitPrice}</a>
                  <p class="ans-more"><a href={bookHref}>Parler 30 min à un expert</a> ou <a href={`/logiciels/${s.slug}/`}>lire le guide</a></p>
                </div>
              );
            })}
            <div class="answer" data-for="autre" hidden>
              <div class="lbl-code">
                <span class="lbl-big">Appel</span>
                <span class="lbl-ref"><Fragment set:html={bars('appel')} /><span>30 min, gratuit</span></span>
              </div>
              <span class="ans-t">Plusieurs problèmes à la fois, c'est le cas le plus courant</span>
              <p class="ans-d">En 30 minutes, on identifie ce qui coûte le plus cher et le premier chantier à lancer.</p>
              <a class="btn btn-gold ans-cta" href={bookHref}>Réserver l'appel gratuit</a>
              <p class="ans-more"><a href="/conseil/">Voir le conseil à l'heure</a></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="simshow" id="simus" aria-labelledby="titre-simus">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="titre-simus" class="h2 sr-up">Sept simulateurs. Votre budget en deux minutes.</h2>
        <p class="lead sr-up lag1" id="simus-lead">Budget poste par poste, délai et point mort, calculés sur des sources publiées. Essayez ici, affinez ensuite.</p>
      </div>
      <div class="ms-pills sr-up" role="tablist" aria-label="Choisir un simulateur">
        {SIM_LIST.map((m, n) => <button type="button" role="tab" class={`ms-pill ${n === 0 ? 'is-on' : ''}`} data-sim={m.slug} aria-selected={n === 0 ? 'true' : 'false'}>{m.code}</button>)}
      </div>
      <div class="ms-card sr-zoom">
        <div class="ms-in">
          <p class="ms-name" id="ms-name"></p>
          <div id="ms-fields" class="ms-fields"></div>
        </div>
        <div class="ms-out" aria-live="polite">
          <span class="ms-k">Budget de mise en place</span>
          <span class="ms-big" id="ms-budget"></span>
          <span class="ms-tier" id="ms-tier"></span>
          <div class="ms-bar" id="ms-bar" aria-hidden="true"></div>
          <div class="ms-row">
            <div><span class="ms-k">Délai</span><strong id="ms-delay"></strong></div>
            <div><span class="ms-k">Coût annuel</span><strong id="ms-rec"></strong></div>
            <div><span class="ms-k">Rentabilisé en</span><strong id="ms-pay"></strong></div>
          </div>
          <a class="btn ms-cta" id="ms-cta" href="/simulateurs/wms/">Affiner dans le simulateur complet</a>
        </div>
      </div>
      <p class="ms-all sr-up"><a href="/simulateurs/">Voir les 7 simulateurs</a></p>
    </div>
  </section>

  <section class="statement" aria-labelledby="titre-promesse">
    <div class="wrap">
      <h2 id="titre-promesse" class="big-t">
        <span class="sr-up">Choisir comme un grand groupe.</span>
        <span class="sr-up lag1 muted-line">Payer comme une PME.</span>
      </h2>
      <div class="proofs">
        {proofs.map((p, i) => (
          <div class={`proof sr-up ${lags[i]}`}>
            <span class="proof-n"><span class="num" data-to={p.n}>{p.n.toLocaleString('fr-FR')}</span>{p.suffix}</span>
            <span class="proof-t">{p.t}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="titre-prix">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="titre-prix" class="h2 sr-up">Vous ne payez que ce dont vous avez besoin.</h2>
        <p class="lead sr-up lag1">PME ou ETI, vous décidez d’abord, gratuitement, puis vous montez seulement la marche qui vous convient, à un prix connu d’avance.</p>
      </div>
      <a class="decide sr-up" href="/simulateurs/">
        <span class="decide-k">D’abord, décider</span>
        <span class="decide-t">Votre première simulation complète est offerte. Le dossier de décision de 10 pages, prêt pour la direction : {SITE.creditPrice}.</span>
        <span class="decide-go">Lancer un simulateur</span>
      </a>
      <div class="steps">
        <a class="step sr-up" href="/kits/">
          <span class="step-k">Avancer seul</span>
          <span class="step-p">{SITE.kitPrice}</span>
          <h3 class="step-t">Le kit de consultation</h3>
          <p>Cahier des charges rédigé, priorités pré-remplies, scénarios, grille de notation, contrat, recette.</p>
          <span class="step-go">Voir les kits</span>
        </a>
        <a class="step sr-up lag1" href="/accompagnement/">
          <span class="step-k">Un second avis</span>
          <span class="step-p">{SITE.reviewPrice}</span>
          <h3 class="step-t">La relecture experte</h3>
          <p>Votre cahier des charges annoté et une heure de visio avant l'envoi aux éditeurs.</p>
          <span class="step-go">En savoir plus</span>
        </a>
        <a class="step sr-up lag2" href="/accompagnement/">
          <span class="step-k">Être accompagné</span>
          <span class="step-p">{SITE.hourlyRate}<small> / h</small></span>
          <h3 class="step-t">Un expert, au temps passé</h3>
          <p>Démonstrations, analyse des offres, négociation, démarrage : seul le temps réel est facturé.</p>
          <span class="step-go">Voir les tarifs</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="titre-outils">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="titre-outils" class="h2 sr-up">De quoi décider seul. Ou presque.</h2>
      </div>
      <div class="bento">
        <a class="card card-lift b-kit sr-up" href="/kits/">
          <span class="b-k">Kits de consultation</span>
          <h3 class="b-t">Toute la consultation, du cahier des charges au contrat.</h3>
          <div class="b-chips">
            {KITS.map((k) => <span class="b-chip">{k.code}</span>)}
          </div>
          <span class="b-price">{SITE.kitPrice}</span>
          <span class="b-go">Voir les 7 kits</span>
        </a>
        <a class="card card-lift b-sim sr-up lag1" href="/simulateurs/">
          <span class="b-k">7 simulateurs, 1re simulation offerte</span>
          <h3 class="b-t">Combien va coûter votre projet ?</h3>
          <div class="b-meter" aria-hidden="true">
            <div class="m-row"><span>Intégration</span><span class="m-bar"><i style="--w: 86%"></i></span></div>
            <div class="m-row"><span>Matériel</span><span class="m-bar"><i style="--w: 44%"></i></span></div>
            <div class="m-row"><span>Interfaces</span><span class="m-bar"><i style="--w: 38%"></i></span></div>
            <div class="m-row"><span>Formation</span><span class="m-bar"><i style="--w: 18%"></i></span></div>
          </div>
          <span class="b-go">Voir les simulateurs</span>
        </a>
        <a class="card card-lift b-guides sr-up lag2" href="/guides/">
          <span class="b-k">Guides gratuits</span>
          <h3 class="b-t">{GUIDES.length} guides : prix, méthode, pièges et technique, pour les 7 familles.</h3>
          <span class="b-go">Lire les guides</span>
        </a>
        <a class="card card-lift b-call sr-up lag3" href="/conseil/">
          <span class="b-k">Conseil</span>
          <h3 class="b-t">Diagnostic, schéma directeur, direction de projet.</h3>
          <span class="b-go">Découvrir le conseil</span>
        </a>
      </div>
    </div>
  </section>

  <section class="night" aria-labelledby="titre-pourquoi">
    <div class="wrap">
      <h2 id="titre-pourquoi" class="night-t">
        <span class="sr-up">La rigueur d'un cabinet.</span>
        <span class="sr-up lag1">L'indépendance d'un expert.</span>
        <span class="sr-up lag2">Le prix d'un outil.</span>
      </h2>
      <div class="why">
        {why.map((w, i) => (
          <div class={`why-i sr-up ${lags[i]}`}>
            <h3 class="why-t">{w.t}</h3>
            <p>{w.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="titre-faq">
    <div class="wrap faq-wrap">
      <div class="sec-head">
        <h2 id="titre-faq" class="h2 sr-up">Questions fréquentes.</h2>
      </div>
      <div class="faq sr-up">
        {faq.map((f) => (
          <details class="faq-item">
            <summary>{f.q}<span class="plus" aria-hidden="true"></span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
      <p class="faq-more">Une autre question ? <a href="/a-propos/#contact">Écrivez-nous</a>, nous répondons sous 48 heures.</p>
    </div>
  </section>

  <section class="final" aria-labelledby="titre-final">
    <div class="wrap final-in">
      <span class="final-mark sr-zoom" aria-hidden="true"><Logo variant="mark" /></span>
      <h2 id="titre-final" class="h2 sr-up">Votre projet commence par la bonne question.</h2>
      <p class="lead sr-up lag1">L'orientation prend une minute. L'appel de cadrage, trente.</p>
      <div class="final-cta sr-up lag2">
        <a class="btn btn-gold btn-lg" href="#orientation">Choisir mon problème</a>
        <a class="btn btn-line btn-lg" href={bookHref}>Réserver un appel gratuit</a>
      </div>
    </div>
  </section>
</Base>

<script>
  import { SIMS, defaults, simulate, money } from '../lib/sims.js';
  // Démonstration des simulateurs : deux curseurs par modèle, résultat en direct
  const msFields = document.getElementById('ms-fields');
  if (msFields) {
    const nf = new Intl.NumberFormat('fr-FR');
    let cur = 'wms'; let vals: Record<string, number> = {}; const saved: Record<string, Record<string, number>> = {};
    const fromPos = (f: any, p: number) => { if (!f.log) return p; const v = f.min * Math.pow(f.max / f.min, p / 1000); const mag = Math.pow(10, Math.max(0, Math.floor(Math.log10(v)) - 1)); const st = Math.max(f.step, mag); return Math.min(f.max, Math.max(f.min, Math.round(v / st) * st)); };
    const toPos = (f: any, v: number) => (f.log ? Math.round((1000 * Math.log(v / f.min)) / Math.log(f.max / f.min)) : v);
    const draw = () => {
      const m = SIMS[cur]; const d = defaults(m); const i = { ...d.i, ...vals };
      const r = simulate(m, i, d.a);
      document.getElementById('ms-budget')!.textContent = `${money(r.low)} à ${money(r.high)}`;
      document.getElementById('ms-tier')!.textContent = r.tier.name;
      document.getElementById('ms-delay')!.textContent = `${Math.round(r.months[0])} à ${Math.round(r.months[1])} mois`;
      const pay = r.breakEven ? `${r.breakEven} mois` : `Au-delà de ${m.horizon} ans`;
      document.getElementById('ms-pay')!.textContent = pay;
      document.getElementById('ms-rec')!.textContent = r.recurring > 0 ? `${money(r.recurring)} par an` : 'Aucun';
      const cols = ['#2448f5', '#6f8bff', '#a9b8ff', '#d7defd', '#8e8e93', '#48484a', '#c7c7cc'];
      document.getElementById('ms-bar')!.innerHTML = r.parts.filter((p: any) => p[1] > 0).map((p: any, n: number) => `<span title="${p[0]}" style="width:${((p[1] / r.initial) * 100).toFixed(2)}%;background:${cols[n % cols.length]}"></span>`).join('');
      // L'étiquette de l'orientation reprend la même estimation : une seule source de vérité
      const lab = document.querySelector<HTMLElement>(`.ans-facts[data-est="${m.slug}"]`);
      if (lab) {
        lab.querySelector('[data-k="budget"]')!.textContent = `${money(r.low)} à ${money(r.high)}`;
        lab.querySelector('[data-k="pay"]')!.textContent = pay;
        const note = lab.parentElement!.querySelector('[data-k="note"]'); if (note && saved[cur]) note.textContent = 'Selon vos volumes.';
      }
      const q = new URLSearchParams(); Object.entries(vals).forEach(([k, v]) => q.set(k, String(v)));
      (document.getElementById('ms-cta') as HTMLAnchorElement).href = `/simulateurs/${m.slug}/?${q.toString()}`;
    };
    const build = () => {
      const m = SIMS[cur]; vals = { ...(saved[cur] || {}) };
      document.getElementById('ms-name')!.textContent = m.title;
      const fs = m.fields.filter((f: any) => f.type === 'range').slice(0, 2);
      msFields.innerHTML = fs.map((f: any) => `<div class="ms-f"><div class="ms-fh"><label for="ms-${f.id}">${f.label}</label><output id="mo-${f.id}"></output></div><input type="range" id="ms-${f.id}" data-id="${f.id}" min="${f.log ? 0 : f.min}" max="${f.log ? 1000 : f.max}" step="${f.log ? 1 : f.step}" value="${toPos(f, vals[f.id] ?? f.value)}"></div>`).join('');
      const upd = () => { fs.forEach((f: any) => { const v = fromPos(f, Number((document.getElementById(`ms-${f.id}`) as HTMLInputElement).value)); vals[f.id] = v; document.getElementById(`mo-${f.id}`)!.textContent = `${nf.format(v)} ${f.unit}`; }); draw(); };
      msFields.oninput = () => { upd(); saved[cur] = { ...vals }; draw(); }; upd();
    };
    const select = (slug: string) => {
      if (!SIMS[slug]) return;
      document.querySelectorAll('.ms-pill').forEach((x) => { const on = (x as HTMLElement).dataset.sim === slug; x.classList.toggle('is-on', on); x.setAttribute('aria-selected', String(on)); });
      cur = slug; build();
    };
    document.querySelectorAll<HTMLButtonElement>('.ms-pill').forEach((b) => b.addEventListener('click', () => select(b.dataset.sim!)));
    // Le choix fait dans l'orientation prépare le simulateur de la même famille
    const title = document.getElementById('titre-simus')!; const lead = document.getElementById('simus-lead')!;
    document.addEventListener('malaheim:choice', (e: Event) => {
      const sim = (e as CustomEvent).detail as string | null;
      if (!sim || !SIMS[sim]) return;
      select(sim);
      title.textContent = `Votre projet ${SIMS[sim].code}, chiffré en direct.`;
      lead.textContent = 'Ajustez vos volumes : le budget, le délai et le point mort se recalculent, et l’étiquette du haut de page suit. Le simulateur complet détaille chaque poste.';
    });
    build();
  }

  // Orientation : un clic sur un problème allume l'étape de la chaîne et imprime l'étiquette
  const btns = Array.from(document.querySelectorAll<HTMLButtonElement>('.tile-btn'));
  const answers = Array.from(document.querySelectorAll<HTMLElement>('.answer'));
  const nodes = Array.from(document.querySelectorAll<SVGGElement>('.node'));
  const panel = document.getElementById('reponse');
  let demo: number | undefined;
  const light = (slug: string, cls: string) => nodes.forEach((n) => n.classList.toggle(cls, n.dataset.node === slug));
  const show = (slug: string, scroll: boolean) => {
    if (demo) { window.clearInterval(demo); demo = undefined; light('', 'is-demo'); }
    answers.forEach((a) => { a.hidden = a.dataset.for !== slug; });
    btns.forEach((b) => { const on = b.dataset.for === slug; b.classList.toggle('is-on', on); b.setAttribute('aria-pressed', String(on)); });
    light(slug, 'is-on');
    const fact = document.querySelector<HTMLElement>(`.answer[data-for="${slug}"] .ans-facts`);
    document.dispatchEvent(new CustomEvent('malaheim:choice', { detail: fact ? fact.dataset.est : null }));
    if (scroll && panel && window.matchMedia('(max-width: 1180px)').matches) panel.scrollIntoView({ behavior: 'smooth', block: 'center' });
  };
  btns.forEach((b) => b.addEventListener('click', () => { show(b.dataset.for!, true); history.replaceState(null, '', `#${b.dataset.for}`); }));
  nodes.forEach((n) => n.addEventListener('click', () => { show(n.dataset.node!, false); history.replaceState(null, '', `#${n.dataset.node}`); }));
  btns.forEach((b) => {
    b.addEventListener('mouseenter', () => { if (!demo) light(b.dataset.for!, 'is-hover'); });
    b.addEventListener('mouseleave', () => light('', 'is-hover'));
  });
  const initial = location.hash.slice(1);
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (initial && btns.some((b) => b.dataset.for === initial)) show(initial, false);
  else if (!reduce) {
    // Démonstration discrète tant que le visiteur n'a pas choisi
    let i = 0;
    const order = nodes.map((n) => n.dataset.node!);
    window.setTimeout(() => { if (!btns.some((b) => b.classList.contains('is-on'))) { demo = window.setInterval(() => { light(order[i++ % order.length], 'is-demo'); }, 1700); } }, 2200);
  }

  // Compteurs animés à l'apparition
  const counters = Array.from(document.querySelectorAll<HTMLElement>('.num[data-to]'));
  const run = (el: HTMLElement) => {
    const to = Number(el.dataset.to); const t0 = performance.now(); const dur = 1400;
    const step = (t: number) => { const p = Math.min(1, (t - t0) / dur); const e = 1 - Math.pow(1 - p, 3); el.textContent = Math.round(to * e).toLocaleString('fr-FR'); if (p < 1) requestAnimationFrame(step); };
    requestAnimationFrame(step);
  };
  if (!reduce && 'IntersectionObserver' in window) {
    counters.forEach((c) => { c.textContent = '0'; });
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { run(e.target as HTMLElement); io.unobserve(e.target); } }), { threshold: 0.6 });
    counters.forEach((c) => io.observe(c));
  }
</script>

