---
import Base from '../layouts/Base.astro';
import { SITE, SOFTWARE, GUIDES, KITS } from '../config';
const kitTotal = KITS.reduce((n, k) => n + k.reqs, 0);
const check = '<svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="5 12.5 10 17 19 7.5"></polyline></svg>';
const words = ['WMS', 'TMS', 'S&OP', 'ERP', 'OMS', 'data'];
const ticker = ["Gestion d'entrepôt", 'Transport', 'S&OP', 'ERP', 'Commandes omnicanal', 'Automatisation', 'Données de référence', 'Tour de contrôle', 'Recette', 'Conduite du changement', 'Schéma directeur', 'Intégration d’usines'];
const facts = [
  { t: "Un projet WMS coûte de 60 k€ à plus d'un million d'euros, et la licence en représente rarement plus d'un tiers.", s: 'Guide Malaheim, prix d’un WMS', href: '/guides/prix-wms/' },
  { t: 'Sur dix éditeurs de TMS vérifiés en août 2026, aucun ne publiait ses prix.', s: 'Logiciels.pro', href: '/logiciels/tms/' },
  { t: 'Un projet ERP avec intégrateur dure 3 à 6 mois pour une PME simple, 9 à 18 mois pour une ETI multi-sites.', s: 'Cegid', href: '/logiciels/erp/' },
  { t: "La conduite du changement pèse entre 15 et 30 % d'un projet ERP.", s: 'Cegid, d’après Prosci', href: '/logiciels/erp/' },
  { t: "Un projet de 25 robots mobiles représente environ 650 000 €, dont 120 000 € d'intégration et d'ingénierie.", s: 'Cleverence', href: '/logiciels/automatisation-wcs/' },
];
const services = [
  { t: 'Diagnostic digital supply chain', d: 'Ce qui bloque, les gains rapides, les chantiers structurants.' },
  { t: 'Schéma directeur des systèmes', d: 'Quels outils, dans quel ordre, pour quel budget.' },
  { t: 'Sélection de logiciels', d: 'Du cahier des charges au contrat négocié.' },
  { t: 'Direction de projets SI', d: 'Déploiements, intégrations d’usines, montées de version.' },
];
const faq = [
  { q: 'Que propose Malaheim ?', a: "Deux choses : des outils pour choisir le bon logiciel supply chain (guides, simulateurs, kits de consultation) et du conseil en transformation digitale, du diagnostic au déploiement." },
  { q: 'Quels kits de consultation proposez-vous ?', a: "Sept kits, un par famille de logiciels : WMS, TMS, ERP, S&OP et planification, automatisation et WCS, OMS, données et pilotage. Chacun contient un cahier des charges de 130 à 268 exigences, des scénarios de démonstration, une grille de dépouillement, une check-list contractuelle en 30 points et un plan de recette." },
  { q: "Je ne sais pas de quel logiciel j'ai besoin. Par où commencer ?", a: "Par l'orientation de cette page : choisissez la situation qui vous ressemble le plus. Si plusieurs vous ressemblent, réservez un appel gratuit de 30 minutes." },
  { q: "Le site s'adresse-t-il aux grandes entreprises ?", a: "Il est pensé pour les PME. Les grands groupes ont des services achats et des cabinets pour leurs appels d'offres ; une PME doit souvent choisir avec un dirigeant et un responsable logistique. Les kits font ce travail d'équipe, à un prix de PME." },
  { q: "Combien coûte l'accompagnement ?", a: `Le kit coûte ${SITE.kitPrice}. La relecture de votre cahier des charges coûte ${SITE.reviewPrice}, prix du kit déduit. Au-delà, l'accompagnement est facturé ${SITE.hourlyRate} de l'heure, au temps réellement passé, avec une estimation écrite avant de commencer.` },
  { q: 'Vos recommandations sont-elles indépendantes ?', a: "Oui. Aucun éditeur ne paie pour être cité ou recommandé, et aucune donnée n'est transmise à des éditeurs ou des intégrateurs." },
  { q: 'Les chiffres sont-ils fiables ?', a: "Ce sont des ordres de grandeur issus de sources publiées, citées sur chaque page. Ils servent à cadrer un budget, pas à remplacer un devis." },
  { q: 'Et si un kit ne me convient pas ?', a: "Vous êtes remboursé sur simple demande dans les 14 jours suivant l'achat, sans justification." },
];
const lags = ['', 'lag1', 'lag2', 'lag3', 'lag4', 'lag5'];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.company,
  url: SITE.url,
  description: 'Choix de logiciels supply chain et conseil en transformation digitale.',
  founder: { '@type': 'Person', name: SITE.author },
};
---
<Base title="Accueil" description="Malaheim aide les PME à choisir le bon logiciel supply chain (WMS, TMS, S&OP, ERP, OMS, données) sans service achats : budgets réels, kits de consultation à 149 € HT, expert à l'heure." jsonLd={jsonLd}>

  <section class="wrap hero" aria-labelledby="titre-accueil">
    <div class="stack hero-text">
      <p class="eyebrow rise">Pour les PME : logiciels et transformation digitale de la supply chain</p>
      <h1 id="titre-accueil" class="h1 hero-title">
        <span class="sr-only">Votre projet de logiciel supply chain commence ici.</span>
        <span class="line rise d1" aria-hidden="true">Votre projet</span>
        <span class="line rise d2" aria-hidden="true">
          <span class="rotator" id="rotator">
            {words.map((w, i) => <span class={`rot grad ${i === 0 ? 'is-on' : ''}`}>{w}</span>)}
          </span>
        </span>
        <span class="line rise d3" aria-hidden="true">commence ici.</span>
      </h1>
      <p class="lead rise d4">Pas de service achats, pas d'équipe projet ? Malaheim donne aux PME les budgets réels, la méthode et les documents pour choisir seules le bon logiciel supply chain, et un expert à l'heure quand il le faut.</p>
      <div class="doors-cta rise d5">
        <a class="btn btn-gold btn-lg" href="#orientation">Je cherche un logiciel <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn btn-line btn-lg" href="/conseil/">Je veux être conseillé</a>
      </div>
      <ul class="trust rise d5">
        <li><Fragment set:html={check} />Orientation gratuite</li>
        <li><Fragment set:html={check} />Pensé pour les PME</li>
        <li><Fragment set:html={check} />Indépendant des éditeurs</li>
      </ul>
    </div>

    <div class="floats" aria-label="Exemples de résultats">
      <div class="card fl fl-1">
        <span class="fl-k">Estimation WMS, 25 opérateurs</span>
        <span class="fl-big num">171 à 278 k€</span>
        <div class="bar" aria-hidden="true"><span style="width: 43%; background: #d9a441"></span><span style="width: 22%; background: #7fb88a"></span><span style="width: 19%; background: #8fb6d4"></span><span style="width: 16%; background: #e8a06a"></span></div>
        <span class="fl-s">Amorti en 19 mois</span>
      </div>
      <div class="card fl fl-2">
        <span class="code">TMS</span>
        <span class="fl-mid">40 à 120 € HT</span>
        <span class="fl-s">par utilisateur et par mois en PME</span>
      </div>
      <div class="card fl fl-3">
        <div class="row" style="gap: 8px; align-items: center"><span class="code">KIT</span><span class="pill-on">Disponible</span></div>
        <span class="fl-mid">268 exigences</span>
        <span class="fl-s">commentées par un expert</span>
      </div>
      <div class="card fl fl-4">
        <span class="code">S&amp;OP</span>
        <span class="fl-s" style="color: var(--text-strong); font-weight: 600">Processus d'abord, outil ensuite</span>
      </div>
    </div>
  </section>

  <section class="ticker" aria-label="Domaines couverts">
    <p class="sr-only">Domaines couverts : {ticker.join(', ')}.</p>
    <div class="ticker-track" aria-hidden="true">
      {[0, 1].map(() => (
        <div class="ticker-row">
          {ticker.map((t) => <span class="tick">{t}<i class="dot"></i></span>)}
        </div>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="titre-portes">
    <div class="wrap stack" style="gap: 40px">
      <div class="stack center" style="gap: 14px">
        <p class="eyebrow sr-down">Deux portes d'entrée</p>
        <h2 id="titre-portes" class="h2 sr-up" style="max-width: 16em">Un logiciel à choisir, ou une transformation à conduire ?</h2>
      </div>
      <div class="row doors">
        <div class="card door sr-left">
          <span class="door-k">Porte 1</span>
          <h3 class="door-t">Je cherche un logiciel</h3>
          <p class="door-d">Le bon type de logiciel, son budget réel, la méthode pour le choisir et les documents pour consulter les éditeurs.</p>
          <div class="sw-grid">
            {SOFTWARE.map((s) => (
              <a class="sw" href={`/logiciels/${s.slug}/`}>
                <span class="code">{s.code}</span>
                <span class="sw-n">{s.name}</span>
              </a>
            ))}
          </div>
          <a class="btn btn-gold" href="/logiciels/" style="align-self: flex-start">Comparer les logiciels <span class="arrow" aria-hidden="true">→</span></a>
        </div>
        <div class="card door door-2 sr-right">
          <span class="door-k">Porte 2</span>
          <h3 class="door-t">Je veux être conseillé</h3>
          <p class="door-d">Un expert indépendant, à l'heure et au temps réellement passé, pour construire la feuille de route, choisir les outils et les déployer jusqu'à leur adoption.</p>
          <ul class="svc-list">
            {services.map((s, i) => (
              <li><span class="svc-i">{String(i + 1).padStart(2, '0')}</span><span><strong>{s.t}</strong><br /><span class="dim">{s.d}</span></span></li>
            ))}
          </ul>
          <a class="btn btn-amber" href="/conseil/" style="align-self: flex-start">Découvrir le conseil <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section pme" aria-labelledby="titre-pme" style="padding-top: 0">
    <div class="wrap stack" style="gap: 32px">
      <div class="stack" style="gap: 12px; max-width: 760px">
        <p class="eyebrow sr-left">Pensé pour les PME</p>
        <h2 id="titre-pme" class="h2 sr-left lag1">Choisir comme un grand groupe, sans son service achats</h2>
        <p class="lead sr-left lag2" style="font-size: 17px">Les grandes entreprises confient leurs appels d'offres à des équipes achats et à des cabinets. Une PME choisit souvent avec un dirigeant et un responsable logistique. Malaheim leur donne les mêmes armes, à leur échelle.</p>
      </div>
      <div class="row" style="gap: 18px">
        <a class="card card-lift pme-c sr-up" href="/kits/">
          <span class="pme-n">1</span>
          <span class="pme-p">{SITE.kitPrice}</span>
          <h3 class="pme-t">Le kit fait le travail d'une équipe</h3>
          <p>Cahier des charges rédigé, priorités pré-remplies, scénarios, grille de notation, contrat, recette.</p>
        </a>
        <a class="card card-lift pme-c sr-up lag1" href="/accompagnement/">
          <span class="pme-n">2</span>
          <span class="pme-p">{SITE.reviewPrice}</span>
          <h3 class="pme-t">Une relecture experte</h3>
          <p>Votre cahier des charges annoté et une heure de visio avant l'envoi aux éditeurs.</p>
        </a>
        <a class="card card-lift pme-c sr-up lag2" href="/accompagnement/">
          <span class="pme-n">3</span>
          <span class="pme-p">{SITE.hourlyRate} / h</span>
          <h3 class="pme-t">Un expert à l'heure, au réel</h3>
          <p>Démonstrations, analyse des offres, négociation, démarrage : seul le temps passé est facturé.</p>
        </a>
      </div>
    </div>
  </section>

  <section id="orientation" class="section section-alt" aria-labelledby="titre-orient">
    <div class="wrap row orient-in">
      <div class="stack sr-left" style="flex: 1 1 360px; gap: 18px">
        <p class="eyebrow">Orientation en une minute</p>
        <h2 id="titre-orient" class="h2">Que recherchez&#8209;vous ?</h2>
        <p class="lead" style="font-size: 17px">Choisissez la situation qui vous ressemble le plus. Nous vous indiquons le type de logiciel, son budget, son délai et la suite à donner.</p>
        <div class="card fact" id="facts" aria-live="polite">
          <span class="fact-k">Le saviez-vous ?</span>
          {facts.map((f, i) => (
            <div class={`fact-item ${i === 0 ? 'is-on' : ''}`}>
              <p class="fact-t">{f.t}</p>
              <a class="fact-s" href={f.href}>Source : {f.s} <span class="arrow" aria-hidden="true">→</span></a>
            </div>
          ))}
          <div class="fact-dots" role="tablist" aria-label="Changer de fait">
            {facts.map((_, i) => <button type="button" class={`fdot ${i === 0 ? 'is-on' : ''}`} aria-label={`Fait ${i + 1}`} data-i={i}></button>)}
          </div>
        </div>
      </div>

      <div class="card orient sr-right">
        <fieldset class="opts-list">
          <legend class="sr-only">Votre situation</legend>
          {SOFTWARE.map((s, i) => (
            <label class="opt">
              <input type="radio" name="besoin" value={s.slug} checked={i === 0} />
              <span>{s.problem}</span>
            </label>
          ))}
        </fieldset>
        {SOFTWARE.map((s, i) => (
          <div class="answer" data-for={s.slug} hidden={i !== 0}>
            <div class="row" style="align-items: center; gap: 10px">
              <span class="code">{s.code}</span>
              <span class="ans-t">{s.long}</span>
            </div>
            <p class="ans-d">{s.does}.</p>
            <div class="row" style="gap: 10px">
              <div class="tile" style="flex: 1 1 150px"><div class="tile-k">Budget indicatif</div><div class="tile-v small">{s.budget}</div></div>
              <div class="tile" style="flex: 1 1 120px"><div class="tile-k">Délai</div><div class="tile-v small">{s.delay}</div></div>
            </div>
            <div class="row" style="gap: 10px">
              <a class="btn btn-gold btn-sm" href={`/logiciels/${s.slug}/`}>Le guide de choix <span class="arrow" aria-hidden="true">→</span></a>
              {s.status === 'complet'
                ? <a class="btn btn-line btn-sm" href="/simulateur-wms/">Estimer mon budget</a>
                : <a class="btn btn-line btn-sm" href={`/kits/${KITS.find((k) => k.sw === s.slug)!.page}/`}>Voir le kit {s.code}</a>}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="titre-outils">
    <div class="wrap stack" style="gap: 40px">
      <div class="row" style="gap: 24px; align-items: flex-end; justify-content: space-between">
        <div class="stack" style="gap: 14px; max-width: 640px">
          <p class="eyebrow sr-left">Les outils</p>
          <h2 id="titre-outils" class="h2 sr-left lag1">De quoi décider seul, ou presque</h2>
        </div>
        <a class="sr-right" href="/kits/" style="font-weight: 600; text-decoration: none">Tous les kits <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <div class="bento">
        <a class="card card-lift b-sim sr-up" href="/simulateur-wms/">
          <span class="b-k">Simulateur gratuit</span>
          <h3 class="b-t">Combien va coûter votre WMS ?</h3>
          <p class="b-d">Gamme, budget, délai et retour sur investissement en 8 questions.</p>
          <div class="b-meter" aria-hidden="true">
            <div class="m-row"><span>Intégration</span><span class="m-bar"><i style="width: 86%"></i></span></div>
            <div class="m-row"><span>Matériel</span><span class="m-bar"><i style="width: 44%"></i></span></div>
            <div class="m-row"><span>Interfaces</span><span class="m-bar"><i style="width: 38%"></i></span></div>
            <div class="m-row"><span>Formation</span><span class="m-bar"><i style="width: 18%"></i></span></div>
          </div>
          <span class="b-go">Lancer le simulateur <span class="arrow" aria-hidden="true">→</span></span>
        </a>
        <a class="card card-lift card-hi b-kit sr-up lag1" href="/kits/">
          <span class="b-k">Kits de consultation</span>
          <h3 class="b-t">Toute la consultation, du cahier des charges au contrat</h3>
          <div class="row" style="gap: 8px">
            {KITS.map((k) => <span class="chip">{k.code}</span>)}
          </div>
          <ul class="b-list">
            <li>{kitTotal.toLocaleString('fr-FR')} exigences commentées sur 7 kits</li>
            <li>Scénarios de démonstration imposés</li>
            <li>Check-list contractuelle en 30 points</li>
            <li>Plans de recette, 40 % de cas d'exception</li>
          </ul>
          <span class="b-price">{SITE.kitFrom} le kit</span>
          <span class="b-go">Voir les 7 kits <span class="arrow" aria-hidden="true">→</span></span>
        </a>
        <a class="card card-lift b-guides sr-up lag2" href="/guides/">
          <span class="b-k">Guides gratuits</span>
          <h3 class="b-t">Prix, étapes, erreurs, gammes, SaaS ou licence</h3>
          <div class="row" style="gap: 8px">
            {GUIDES.map((g) => <span class="chip">{g.figure}</span>)}
          </div>
          <span class="b-go">Lire les guides <span class="arrow" aria-hidden="true">→</span></span>
        </a>
        <a class="card card-lift b-call sr-up lag3" href="/conseil/">
          <span class="b-k">Conseil</span>
          <h3 class="b-t">30 minutes pour y voir clair</h3>
          <p class="b-d">Un appel gratuit pour qualifier le besoin et le bon format d'intervention.</p>
          <span class="b-go">Réserver un appel <span class="arrow" aria-hidden="true">→</span></span>
        </a>
      </div>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="titre-apropos">
    <div class="wrap row about-in">
      <div class="photo card sr-left" role="img" aria-label="Emplacement de la photo de Robin Thomas-Le Déoré">[Votre photo]</div>
      <div class="stack about-text">
        <p class="eyebrow sr-right">Qui est derrière Malaheim</p>
        <h2 id="titre-apropos" class="h2 sr-right lag1">{SITE.author}</h2>
        <p class="lead sr-right lag2">Fondateur de {SITE.company}, consultant supply chain indépendant à Rennes. Je dirige des projets de systèmes d'information logistiques et industriels : sélection et déploiement de WMS et de WCS, intégration d'usines, montées de version, pilotage d'équipes.</p>
        <p class="lead sr-right lag3">Passé par GEODIS et KPMG, j'enseigne aussi la logistique en master.</p>
        <div class="row sr-up lag3" style="gap: 10px">
          <span class="chip">Sélection de logiciels</span>
          <span class="chip">WMS, WCS et automatisation</span>
          <span class="chip">Intégration d'usines</span>
          <span class="chip">Pilotage de projets SI</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="titre-faq">
    <div class="wrap row" style="gap: 56px; align-items: flex-start">
      <div class="stack sr-left" style="flex: 1 1 320px; gap: 16px">
        <p class="eyebrow">Questions fréquentes</p>
        <h2 id="titre-faq" class="h2">Vos questions, nos réponses</h2>
        <p class="lead" style="font-size: 17px">Une autre question ? <a href="/a-propos/#contact">Écrivez-moi</a>, je réponds sous 48 heures.</p>
      </div>
      <div class="card stack faq sr-right" style="flex: 1 1 520px; padding: 8px 28px">
        {faq.map((f) => (
          <details class="faq-item">
            <summary>{f.q}<span class="plus" aria-hidden="true"></span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section aria-labelledby="titre-final" class="final">
    <div class="wrap">
      <div class="final-in stack center sr-zoom">
        <h2 id="titre-final" class="h2" style="max-width: 15em">Votre projet supply chain démarre dans les 12 prochains mois ?</h2>
        <p style="margin: 0; font-size: 19px; max-width: 32em">Commencez par la bonne question. L'orientation prend une minute, l'appel de cadrage trente.</p>
        <div class="row" style="gap: 12px; justify-content: center">
          <a class="btn btn-gold btn-lg" href="#orientation">Trouver mon logiciel <span class="arrow" aria-hidden="true">→</span></a>
          <a class="btn btn-line btn-lg" href="/conseil/">Être conseillé</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Mot qui change dans le titre
  const rots = Array.from(document.querySelectorAll<HTMLElement>('#rotator .rot'));
  let r = 0;
  if (!reduce && rots.length > 1) {
    setInterval(() => {
      rots[r].classList.remove('is-on');
      rots[r].classList.add('is-off');
      const prev = rots[r];
      setTimeout(() => prev.classList.remove('is-off'), 700);
      r = (r + 1) % rots.length;
      rots[r].classList.add('is-on');
    }, 2200);
  }

  // Faits qui tournent
  const items = Array.from(document.querySelectorAll<HTMLElement>('.fact-item'));
  const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('.fdot'));
  let f = 0;
  const showFact = (i: number) => {
    items.forEach((el, j) => el.classList.toggle('is-on', j === i));
    dots.forEach((el, j) => el.classList.toggle('is-on', j === i));
    f = i;
  };
  dots.forEach((d) => d.addEventListener('click', () => showFact(Number(d.dataset.i))));
  if (!reduce) setInterval(() => showFact((f + 1) % items.length), 6000);

  // Orientation
  const radios = document.querySelectorAll<HTMLInputElement>('input[name="besoin"]');
  const answers = document.querySelectorAll<HTMLElement>('.answer');
  radios.forEach((rd) => rd.addEventListener('change', () => answers.forEach((a) => { a.hidden = a.dataset.for !== rd.value; })));
</script>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .code { align-self: flex-start; font-family: var(--display); font-weight: 600; font-size: 13px; letter-spacing: .04em; color: #111317; background: linear-gradient(135deg, #f0cf7f, #e3a654); border-radius: 8px; padding: 3px 9px; }

  /* Haut de page */
  .hero { display: flex; flex-wrap: wrap; gap: 48px; align-items: center; padding-block: 96px 80px; }
  .hero-text { flex: 1 1 520px; min-width: 0; gap: 26px; }
  .hero-title { font-size: clamp(46px, 6vw, 86px); line-height: 1.0; }
  .line { display: block; }
  .rotator { display: inline-grid; vertical-align: bottom; }
  .rot { grid-area: 1 / 1; opacity: 0; transform: translateY(40%); filter: blur(8px); transition: opacity .6s var(--ease), transform .6s var(--ease), filter .6s var(--ease); padding-bottom: .08em; }
  .rot.is-on { opacity: 1; transform: none; filter: none; }
  .rot.is-off { opacity: 0; transform: translateY(-40%); filter: blur(8px); }
  .doors-cta { display: flex; flex-wrap: wrap; gap: 12px; }
