  @media (max-width: 900px) { .steps { grid-template-columns: 1fr; } }
  .step { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 10px; padding: 48px 32px 40px; background: #fff; border-radius: 28px; text-decoration: none !important; color: var(--text); transition: transform .6s var(--ease), box-shadow .6s var(--ease); }
  .step:hover { transform: scale(1.015); box-shadow: var(--shadow-hover); color: var(--text); }
