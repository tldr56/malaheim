---
import Base from '../../layouts/Base.astro';
import { SITE, SOFTWARE } from '../../config';
const brevo = SITE.brevoFormAction;
const upcoming = SOFTWARE.filter((s) => s.status !== 'complet');
const lags = ['', 'lag1', 'lag2', 'lag3', 'lag4'];
---
<Base title="Kits de consultation" description="Des kits prêts à l'emploi pour choisir un logiciel supply chain : cahier des charges expert, scénarios de démonstration, grille de dépouillement, check-list contractuelle, plan de recette.">
  <section class="dark">
    <div class="wrap stack" style="padding-block: 72px 80px; gap: 18px; max-width: 900px">
      <p class="eyebrow rise">Les kits de consultation</p>
      <h1 class="h1 rise d1" style="font-size: clamp(38px, 4.6vw, 60px)">Tout pour mener votre consultation, prêt à l'emploi</h1>
      <p class="lead rise d2">Chaque kit contient le cahier des charges à envoyer aux éditeurs et les outils pour juger leurs réponses, négocier le contrat et recetter la solution. Satisfait ou remboursé 14 jours.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="titre-dispo">
    <div class="wrap stack" style="gap: 32px">
      <h2 id="titre-dispo" class="h2 sr-up">Disponible</h2>
      <a class="card card-hi card-lift kit-main sr-up" href="/kits/consultation-wms/">
        <div class="stack" style="gap: 14px; flex: 1 1 420px; min-width: 0">
          <div class="row" style="gap: 10px; align-items: center"><span class="code">WMS</span><span class="pill pill-on">Disponible</span></div>
          <h3 class="kit-t">{SITE.kitName}, édition Expert</h3>
          <p class="kit-d">268 exigences commentées, 18 flux d'interface, 12 scénarios de démonstration, grille de dépouillement et coût sur 5 ans, check-list contractuelle en 30 points, plan de recette en 72 cas.</p>
        </div>
        <div class="stack kit-buy">
          <span class="kit-price">{SITE.kitFrom}</span>
          <span class="dim" style="font-size: 14px">Trois formules, jusqu'à l'accompagnement</span>
          <span class="btn btn-gold">Voir le kit <span class="arrow" aria-hidden="true">→</span></span>
        </div>
      </a>
    </div>
  </section>

  <section id="bientot" class="section section-alt" aria-labelledby="titre-bientot">
    <div class="wrap stack" style="gap: 32px">
      <div class="stack" style="gap: 12px; max-width: 760px">
        <h2 id="titre-bientot" class="h2 sr-up">En préparation</h2>
        <p class="lead sr-up lag1" style="font-size: 17px">Les prochains kits suivent la même méthode. Inscrivez-vous pour être prévenu de leur sortie et bénéficier du tarif de lancement.</p>
      </div>
      <div class="row" style="gap: 16px">
        {upcoming.map((s, i) => (
          <div class={`card soon sr-up ${lags[i]}`}>
            <div class="row" style="gap: 10px; align-items: center"><span class="code">{s.code}</span><span class="pill">En préparation</span></div>
            <span class="soon-t">Kit Consultation {s.code}</span>
            <span class="soon-d">{s.name}</span>
          </div>
        ))}
      </div>
      <form id="waitlist" class="card wait sr-up" method="post" action={brevo || undefined} data-brevo={brevo} novalidate>
        <div class="stack" style="gap: 6px; flex: 1 1 260px">
          <label for="w-email">Adresse e-mail professionnelle</label>
          <input id="w-email" name="EMAIL" type="email" autocomplete="email" placeholder="prenom.nom@entreprise.fr">
        </div>
        <div class="stack" style="gap: 6px; flex: 1 1 200px">
          <label for="w-kit">Kit qui vous intéresse</label>
          <select id="w-kit" name="KIT">
            {upcoming.map((s) => <option value={s.code}>Kit {s.code}</option>)}
          </select>
        </div>
        <button class="btn btn-gold" type="submit" style="align-self: flex-end">Être prévenu</button>
        <label class="consent" for="w-ok"><input id="w-ok" name="OPT_IN" value="1" type="checkbox"><span>J'accepte d'être prévenu de la sortie du kit et de recevoir les conseils du site. Désinscription en un clic. <a href="/confidentialite/">Confidentialité</a></span></label>
        <p class="dim" id="w-msg" role="status" style="margin: 0; font-size: 13px; flex-basis: 100%"></p>
      </form>
    </div>
  </section>
</Base>

<script>
  const form = document.getElementById('waitlist') as HTMLFormElement | null;
  const msg = document.getElementById('w-msg');
  form?.addEventListener('submit', (e) => {
    const mail = (document.getElementById('w-email') as HTMLInputElement).value.trim();
    const ok = (document.getElementById('w-ok') as HTMLInputElement).checked;
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(mail)) { e.preventDefault(); if (msg) msg.textContent = 'Saisissez une adresse e-mail valide.'; return; }
    if (!ok) { e.preventDefault(); if (msg) msg.textContent = 'Cochez la case pour être prévenu.'; return; }
    if (!form.dataset.brevo) { e.preventDefault(); if (msg) msg.textContent = "Merci. L'inscription sera active dès la mise en service de l'outil d'emailing."; }
  });
</script>

<style>
  .code { font-family: var(--display); font-size: 15px; letter-spacing: .06em; color: #141619; background: var(--gold); border-radius: 8px; padding: 3px 9px; }
  .pill { font-size: 12px; font-weight: 600; border-radius: 999px; padding: 3px 10px; border: 1px solid var(--line); color: var(--dim); }
  .pill-on { border-color: rgba(63,125,78,.4); color: var(--good); background: rgba(63,125,78,.08); }
  .kit-main { display: flex; flex-wrap: wrap; gap: 32px; align-items: center; padding: 32px; }
  .kit-t { font-size: 28px; }
  .kit-d { margin: 0; color: var(--muted); }
  .kit-buy { flex: 0 1 260px; gap: 10px; }
  .kit-price { font-size: 34px; font-weight: 600; color: var(--gold-soft); }
  .soon { flex: 1 1 200px; padding: 22px; display: flex; flex-direction: column; gap: 8px; }
  .soon-t { font-weight: 600; color: var(--text-strong); font-size: 17px; }
  .soon-d { color: var(--dim); font-size: 14px; }
  .wait { display: flex; flex-wrap: wrap; gap: 16px; padding: 24px; align-items: flex-start; }
  .wait label { font-weight: 500; font-size: 14px; }
  .wait input[type=email], .wait select { background: var(--bg); border: 1px solid var(--line); border-radius: 10px; color: var(--text); padding: 12px 14px; font: inherit; min-height: 48px; }
  .consent { display: flex; gap: 10px; align-items: flex-start; font-size: 12px !important; color: var(--dim); font-weight: 400 !important; flex-basis: 100%; }
  .consent input { margin-top: 3px; accent-color: var(--gold); }
</style>
