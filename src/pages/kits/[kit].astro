---
import { SIM_LIST } from '../../lib/sims.js';
import Base from '../../layouts/Base.astro';
import Trust from '../../components/Trust.astro';
import Offer from '../../components/Offer.astro';
import KitTour from '../../components/KitTour.astro';
import { SITE, KITS, SOFTWARE } from '../../config';

export function getStaticPaths() {
  return KITS.filter((k) => k.page !== 'consultation-wms').map((k) => ({ params: { kit: k.page }, props: { k } }));
}

const { k } = Astro.props;
const sw = SOFTWARE.find((s) => s.slug === k.sw)!;
const title = `Kit Consultation ${k.code}`;
const ready = Boolean(SITE.kitCheckoutUrl);
const buyHref = SITE.kitCheckoutUrl || '/a-propos/#contact';
const check = '<svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="5 12.5 10 17 19 7.5"></polyline></svg>';
const dash = '<svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><line x1="6" y1="12" x2="18" y2="12"></line></svg>';

const kitItems = [`${k.reqs} exigences commentées sur ${k.domains} domaines`, `${k.parts[6].t}, grille de dépouillement`, 'Check-list contractuelle en 30 points', k.code === 'WCS' ? `${k.tests} essais de réception` : `Plan de recette en ${k.tests} cas`, 'Word et PDF, accès immédiat'];
const faq = [
  { q: "En quoi est-ce différent d'un modèle gratuit trouvé en ligne ?", a: "Un modèle gratuit liste des fonctions. Ce kit impose une méthode : priorités pré-remplies, cotation obligatoire par l'éditeur, offre financière décomposée, scénarios imposés et grille de notation. Chaque domaine clé porte un conseil issu de projets réels." },
  { q: 'Le kit convient-il à mon entreprise ?', a: k.audience },
  { q: 'Sous quel format est-il livré ?', a: "En Word, entièrement modifiable, et en PDF. Vous envoyez les parties 1 à 5 aux candidats et gardez les annexes pour vous." },
  { q: 'Combien de temps faut-il pour le remplir ?', a: k.fill },
  { q: 'Et si le kit ne me convient pas ?', a: "Vous le voyez avant d'acheter : le contenu de chaque étape est détaillé sur cette page, avec un extrait réel des exigences. Le kit étant un fichier livré immédiatement, il n'est pas remboursé ; en revanche, s'il comporte une erreur ou un défaut, nous le corrigeons ou le remboursons." },
  { q: "Je n'ai ni service achats ni DSI, est-ce un problème ?", a: "Non, c'est précisément pour vous que le kit est fait. Les exigences sont rédigées, les priorités pré-remplies, les courriers prêts à envoyer. Il faut quelques jours d'un responsable logistique ou d'un dirigeant, pas une équipe." },
  { q: "Et si j'ai besoin d'aide en cours de route ?", a: `Deux options : la relecture de votre cahier des charges (${SITE.reviewPrice}, prix du kit déduit), ou l'accompagnement à l'heure (${SITE.hourlyRate} de l'heure, au temps réellement passé, sans forfait minimum).` },
];
const lags = ['', 'lag1', 'lag2', 'lag3'];
const description = `Le kit expert pour mener une consultation ${k.code} : ${k.short} ${SITE.kitFrom}.`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: title,
  description: k.short,
  brand: { '@type': 'Brand', name: SITE.name },
  offers: { '@type': 'Offer', price: SITE.kitPriceNum, priceCurrency: 'EUR' },
};
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <section class="dark">
    <div class="wrap row" style="gap: 64px; align-items: center; padding-block: 88px 104px">
      <div class="stack" style="flex: 1 1 480px; min-width: 0; gap: 24px">
        <p class="eyebrow rise">{title}, pour PME et ETI</p>
        <h1 class="h1 rise d1" style="font-size: clamp(38px, 4.4vw, 60px)">{k.h1}</h1>
        <p class="lead rise d2">{k.lead} Conçu par des praticiens qui conduisent ces projets.</p>
        <div class="row rise d3" style="align-items: center; gap: 22px">
          <a class="btn btn-gold btn-lg" href={buyHref}>Acheter le kit, {SITE.kitPrice} <span class="arrow" aria-hidden="true">→</span></a>
          <a class="btn btn-line btn-lg" href="#formules">Me faire accompagner</a>
        </div>
        <p class="dim rise d4" style="margin: 0; font-size: 14px">Paiement sécurisé, téléchargement immédiat, facture à votre société, virement possible. <a href={`/simulateurs/${SIM_LIST.find((m) => m.sw === k.sw)!.slug}/`}>Estimer d’abord votre budget avec le simulateur gratuit</a>.</p>
      </div>
      <div class="card slide-in paper">
        <span class="paper-k">{k.extract.k}</span>
        <span class="paper-t">{k.extract.t}</span>
        <table class="extract">
          <thead><tr><th>N°</th><th>Exigence</th><th>Prio.</th><th>Rép.</th></tr></thead>
          <tbody>
            {k.extract.rows.map((r) => <tr><td>{r[0]}</td><td>{r[1]}</td><td>{r[2]}</td><td>{r[3]}</td></tr>)}
          </tbody>
        </table>
        <div class="paper-note"><strong>Conseil d'expert.</strong> {k.extract.tip}</div>
      </div>
    </div>
  </section>

  <section class="figs" aria-label="Le kit en chiffres">
    <div class="wrap row figs-in">
      {k.figures.map((f, i) => (
        <div class={`stack fig sr-up ${lags[i]}`}>
          <span class="fig-n">{f.n}</span>
          <span class="fig-t">{f.t}</span>
          <span class="fig-d">{f.d}</span>
        </div>
      ))}
    </div>
  </section>

  <KitTour code={k.code} reqs={k.reqs} demos={k.demos} tests={k.tests} exceptions={k.exceptions} parts={k.parts} extract={k.extract} fill={k.fill} buyHref={buyHref} />

  <section class="section" aria-labelledby="titre-contenu">
    <div class="wrap stack" style="gap: 48px">
      <div class="stack center" style="gap: 14px">
        <p class="eyebrow sr-down">Ce que vous achetez</p>
        <h2 id="titre-contenu" class="h2 sr-up" style="max-width: 16em">Cinq parties à envoyer, six annexes à garder pour vous</h2>
        <p class="lead sr-up lag1" style="text-align: center">Les parties 1 à 5 partent chez les candidats. Les annexes restent chez vous : les communiquer donnerait votre grille de lecture aux candidats.</p>
      </div>
      <div class="row" style="gap: 16px">
        {k.parts.map((p, i) => (
          <div class={`card part sr-up ${lags[i % 4]} ${p.k.startsWith('Annexe') ? 'part-annex' : ''}`}>
            <span class="part-k">{p.k}</span>
            <h3 class="part-t">{p.t}</h3>
            <p>{p.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="formules" class="section section-alt" aria-labelledby="titre-formules">
    <div class="wrap stack" style="gap: 48px">
      <div class="stack center" style="gap: 14px">
        <p class="eyebrow sr-down">Le prix</p>
        <h2 id="titre-formules" class="h2 sr-up" style="max-width: 18em">Un prix adapté, et de l'aide seulement si vous en avez besoin</h2>
        <p class="lead sr-up lag1" style="text-align: center">{k.ratio}</p>
      </div>
      <Offer kitLabel={title} kitHref={buyHref} kitCta={`Acheter le kit, ${SITE.kitPrice}`} kitItems={kitItems} />
      {!ready && <p class="dim center" style="margin: 0; text-align: center; font-size: 14px">La vente en ligne ouvre très prochainement. Pour réserver votre kit dès maintenant, <a href="/a-propos/#contact">écrivez-nous</a>.</p>}
    </div>
  </section>

  <Trust dark />

  <section class="section" aria-labelledby="titre-faq">
    <div class="wrap row" style="gap: 56px; align-items: flex-start">
      <div class="stack sr-left" style="flex: 1 1 320px; gap: 16px">
        <p class="eyebrow">Questions fréquentes</p>
        <h2 id="titre-faq" class="h2">Avant d'acheter</h2>
        <p class="lead" style="font-size: 17px">Le <a href={`/logiciels/${sw.slug}/`}>guide de choix {sw.code}</a> explique le budget, le délai et les pièges propres à ce type de logiciel.</p>
      </div>
      <div class="stack sr-right" style="flex: 1 1 520px">
        {faq.map((f) => (
          <details class="faq-item">
            <summary>{f.q}<span class="plus" aria-hidden="true"></span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section aria-labelledby="titre-achat" style="padding: 0 0 140px">
    <div class="wrap">
      <div class="stack center sr-zoom" style="background: var(--ink); color: #fff; border-radius: 14px; padding: 64px 40px; gap: 18px">
        <h2 id="titre-achat" class="h2" style="color: #fff; max-width: 16em">Lancez votre consultation sur des bases solides</h2>
        <p style="margin: 0; font-size: 18px; max-width: 32em">Le kit contient tout ce qu'il faut, du premier envoi aux candidats jusqu'à la réception. Et si vous bloquez, un expert prend le relais, à l'heure.</p>
        <a class="btn btn-gold btn-lg" href={buyHref}>Acheter le kit, {SITE.kitPrice} <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .paper { flex: 1 1 420px; min-width: 0; padding: 28px; display: flex; flex-direction: column; gap: 6px; background: #fff; color: var(--ink); border: 1px solid var(--ink); box-shadow: 8px 8px 0 var(--cobalt-tint), 0 30px 60px -30px rgba(19,33,58,.4); }
  .paper-k { font-size: 14px; color: var(--cobalt); font-weight: 600; }
  .paper-t { font-family: var(--display); font-weight: 750; font-stretch: 112%; letter-spacing: -0.02em; font-size: 22px; margin-bottom: 8px; color: var(--ink); }
  .paper-note { margin-top: 12px; padding: 12px 14px; border-left: 3px solid var(--cobalt); background: var(--cobalt-tint); font-size: 13.5px; color: var(--ink); line-height: 1.5; }
  .extract { width: 100%; border-collapse: collapse; font-size: 13px; }
  .extract th { text-align: left; color: var(--dim); font-weight: 600; font-size: 12.5px; letter-spacing: 0; padding: 8px 6px; border-bottom: 1px solid var(--ink); }
  .extract td { padding: 9px 6px; border-bottom: 1px solid var(--line-soft); vertical-align: top; }
  .extract td:first-child { color: var(--cobalt); font-stretch: 80%; font-weight: 600; white-space: nowrap; }
  .extract td:nth-child(3), .extract td:nth-child(4) { font-weight: 600; text-align: center; }

  .figs { background: var(--card); border-bottom: 1px solid var(--line-soft); }
  .figs-in { gap: 32px; padding-block: 48px; justify-content: space-between; }
  .fig { flex: 1 1 220px; gap: 4px; }
  .fig-n { font-family: var(--display); font-weight: 820; font-stretch: 125%; letter-spacing: -0.04em; font-size: 54px; line-height: 1; color: var(--cobalt); }
  .fig-t { font-weight: 600; color: var(--text-strong); font-size: 17px; }
  .fig-d { color: var(--dim); font-size: 14px; }

  .part { flex: 1 1 280px; padding: 22px 24px; display: flex; flex-direction: column; gap: 8px; }
  .part-annex { background: var(--card-2); }
  .part-k { font-size: 12px; font-weight: 600; letter-spacing: 0; color: var(--gold-soft); }
  .part-t { font-family: var(--body); font-size: 18px; font-weight: 600; color: var(--text-strong); }
  .part p { margin: 0; color: var(--muted); font-size: 15px; }

  .tiers { gap: 22px; align-items: stretch; }
  .tier { position: relative; flex: 1 1 300px; padding: 32px 28px; display: flex; flex-direction: column; gap: 14px; }
  .tier-hi { transform: translateY(-8px); }
  .tier-name { font-size: 26px; }
  .tier-price { font-size: 38px; font-weight: 600; color: var(--gold-soft); line-height: 1; }
  .tier-pitch { margin: 0; color: var(--muted); font-size: 15px; min-height: 3em; }
  .tier-list { list-style: none; margin: 4px 0 8px; padding: 0; display: flex; flex-direction: column; gap: 10px; font-size: 15px; }
  .tier-list li { display: flex; gap: 10px; align-items: flex-start; }
  .tier-list li :global(svg) { flex: none; margin-top: 3px; }
  .tier-list .on { color: var(--text); }
  .tier-list .on :global(svg) { color: var(--good); }
  .tier-list .off { color: var(--line-btn); }
  .tier .btn { margin-top: auto; }
  .ribbon { position: absolute; top: -14px; right: 20px; background: var(--ink); color: #fff; font-size: 12px; font-weight: 600; padding: 6px 12px; border-radius: 999px; }
  .assure { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 22px; justify-content: center; color: var(--dim); font-size: 14px; }
  .assure li::before { content: ''; display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--gold); margin-right: 8px; vertical-align: middle; }

  .faq-item { border-bottom: 1px solid var(--line); }
  .faq-item summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 20px 0; font-weight: 600; font-size: 17px; color: var(--text-strong); min-height: 44px; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item p { margin: 0 0 20px; color: var(--muted); max-width: 60ch; }
  .plus { position: relative; width: 16px; height: 16px; flex: none; }
  .plus::before, .plus::after { content: ''; position: absolute; left: 0; top: 7px; width: 16px; height: 2px; background: var(--gold); transition: transform .3s var(--ease); }
  .plus::after { transform: rotate(90deg); }
  .faq-item[open] .plus::after { transform: rotate(0deg); }
  @media (max-width: 520px) { .extract th:nth-child(4), .extract td:nth-child(4) { display: none; } .tier-hi { transform: none; } }
</style>
