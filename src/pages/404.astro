---
import Base from '../layouts/Base.astro';
---
<Base title="Page introuvable" description="Cette page n'existe pas ou a été déplacée." dock={false}>
  <section class="wrap stack center" style="padding-block: 140px; gap: 20px">
    <p class="eyebrow">Erreur 404</p>
    <h1 class="h2">Cette page n'existe pas ou a été déplacée</h1>
    <p class="lead" style="text-align: center">Les guides et les outils restent à portée de clic.</p>
    <div class="row" style="gap: 14px; justify-content: center">
      <a class="btn btn-gold" href="/#orientation">Trouver mon logiciel</a>
      <a class="btn btn-line" href="/logiciels/">Voir les logiciels</a>
    </div>
  </section>
</Base>
