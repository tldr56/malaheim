---
import Base from '../layouts/Base.astro';
import Offer from '../components/Offer.astro';
import { SITE } from '../config';
const bookHref = SITE.bookingUrl || '/a-propos/#contact';
const eur = (n: number) => `${n.toLocaleString('fr-FR')} €`;
const estimates = [
  { t: 'Valider le besoin et le bon type de logiciel', h: [2, 4] },
  { t: 'Préparer et animer les démonstrations de 3 éditeurs', h: [6, 10] },
  { t: 'Analyser 3 offres et préparer la négociation', h: [6, 10] },
  { t: 'Accompagner toute la consultation, du kit au contrat', h: [20, 35] },
  { t: 'Piloter le démarrage après la signature', h: [4, 8], unit: 'par mois' },
].map((e) => ({ ...e, cost: `${eur(e.h[0] * SITE.hourlyNum)} à ${eur(e.h[1] * SITE.hourlyNum)} HT${e.unit ? ' ' + e.unit : ''}` }));
const why = [
  { t: 'Vous faites le gros du travail', d: 'Le kit remplace le travail d’une équipe achats : exigences rédigées, priorités pré-remplies, courriers prêts.' },
  { t: 'Vous achetez seulement l’expertise', d: 'Les heures servent aux moments qui décident : démonstrations, analyse des offres, négociation, démarrage.' },
  { t: 'Vous gardez la main sur le budget', d: 'Estimation écrite avant de commencer, décompte au quart d’heure, aucun dépassement sans votre accord.' },
];
const lags = ['', 'lag1', 'lag2'];
---
<Base title="Tarifs" description={`Kit de consultation à ${SITE.kitPrice}, relecture de cahier des charges à ${SITE.reviewPrice}, accompagnement à ${SITE.hourlyRate} de l'heure au temps réellement passé. Simulation offerte, dossier de décision à ${SITE.creditPrice}. Une offre pensée pour les PME et ETI.`}>
  <section class="wrap stack" style="padding-block: 72px 56px; gap: 18px; max-width: 900px; margin-inline: auto">
    <p class="eyebrow rise">Tarifs</p>
    <h1 class="h1 rise d1" style="font-size: clamp(40px, 5vw, 64px)">Un coût connu à chaque étape</h1>
    <p class="lead rise d2">Pensé pour les PME et ETI qui n’ont pas d’équipe dédiée aux projets logiciels. Vous décidez d’abord avec les simulateurs, puis vous ne payez que ce dont vous avez besoin : le kit pour avancer seul, une relecture pour un second avis, un expert à l’heure pour les moments qui comptent.</p>
  </section>

  <section class="wrap tf" aria-labelledby="titre-decider" style="padding-bottom: 72px">
    <div class="tf-head">
      <p class="eyebrow">Étape 1, décider</p>
      <h2 id="titre-decider" class="h2">Savoir si le projet tient, avant d’engager un euro</h2>
      <p class="lead" style="font-size: 17px">Budget poste par poste, risque chiffré sur 1 000 simulations, comparaison au marché et scénarios, pour votre cas. Le dossier de décision en fait un document de 10 pages prêt pour la direction.</p>
    </div>
    <div class="tf-grid">
      <a class="tf-c" href="/simulateurs/"><span class="tf-k">Pour commencer</span><b class="tf-p">Offerte</b><strong>Votre première simulation complète</strong><span>Avec un compte gratuit, par simple e-mail. Réglable pendant 7 jours.</span></a>
      <a class="tf-c tf-on" href="/simulateurs/"><span class="tf-k">Pour décider</span><b class="tf-p">{SITE.creditPrice}</b><strong>Une simulation et son dossier de décision</strong><span>PDF de 10 pages et modèle Excel. Déduits du kit de la même famille.</span></a>
      <a class="tf-c" href="/compte/"><span class="tf-k">Pour comparer</span><b class="tf-p">{SITE.packPrice}</b><strong>Pack de 5 simulations avec dossiers</strong><span>Plusieurs projets ou plusieurs sites, valable 12 mois.</span></a>
      <a class="tf-c" href="/compte/"><span class="tf-k">Cabinets et intégrateurs</span><b class="tf-p">{SITE.proPrice.replace(' par an', '')}<small> / an</small></b><strong>Pass Pro</strong><span>Simulations et dossiers illimités, à votre nom et à votre logo.</span></a>
    </div>
    <p class="tf-g">Satisfait ou remboursé pendant 14 jours, sans justification, sur toutes les offres en ligne.</p>
  </section>

  <section class="wrap" style="padding-bottom: 96px">
    <p class="eyebrow" style="text-align: center; margin-bottom: 24px">Étape 2, choisir et déployer</p>
    <Offer />
  </section>

  <section class="section section-alt" aria-labelledby="titre-heures">
    <div class="wrap row" style="gap: 56px; align-items: flex-start">
      <div class="stack sr-left" style="flex: 1 1 340px; gap: 16px">
        <p class="eyebrow">L'accompagnement à l'heure</p>
        <h2 id="titre-heures" class="h2">Combien d'heures pour quoi ?</h2>
        <p class="lead" style="font-size: 17px">Des ordres de grandeur pour un projet courant, à {SITE.hourlyRate} de l'heure. Vous recevez une estimation écrite avant de commencer, puis un relevé détaillé chaque mois. Seul le temps réellement passé est facturé.</p>
      </div>
      <div class="card sr-right est" style="flex: 1 1 560px">
        <table>
          <thead><tr><th>Mission</th><th>Heures</th><th>Soit environ</th></tr></thead>
          <tbody>
            {estimates.map((e) => (
              <tr><td>{e.t}</td><td class="num">{e.h[0]} à {e.h[1]} h{e.unit ? ' ' + e.unit : ''}</td><td class="num">{e.cost}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="titre-pourquoi">
    <div class="wrap stack" style="gap: 36px">
      <h2 id="titre-pourquoi" class="h2 sr-up" style="max-width: 18em">Pourquoi à l'heure plutôt qu'au forfait ?</h2>
      <div class="row" style="gap: 20px">
        {why.map((w, i) => (
          <div class={`card sr-up ${lags[i]}`} style="flex: 1 1 280px; padding: 26px; display: flex; flex-direction: column; gap: 10px">
            <h3 class="h3" style="font-size: 20px">{w.t}</h3>
            <p style="margin: 0; color: var(--muted); font-size: 15px">{w.d}</p>
          </div>
        ))}
      </div>
      <p class="dim sr-up" style="margin: 0; font-size: 15px">Le même taux horaire s'applique au <a href="/conseil/">conseil</a> : diagnostic, schéma directeur, direction de projet.</p>
    </div>
  </section>

  <section id="contact" aria-labelledby="titre-contact" style="padding: 0 0 140px">
    <div class="wrap">
      <div class="stack center sr-zoom" style="background: var(--ink); color: #fff; border-radius: 14px; padding: 64px 40px; gap: 18px">
        <h2 id="titre-contact" class="h2" style="color: #fff">Parlons de votre projet en 30 minutes</h2>
        <p style="margin: 0; font-size: 18px; max-width: 32em">Un appel gratuit pour cadrer votre besoin, savoir si le kit suffit, et estimer les heures si vous voulez être accompagné. Sans engagement.</p>
        <a class="btn btn-gold btn-lg" href={bookHref}>Réserver un appel <span class="arrow" aria-hidden="true">→</span></a>
        <p style="margin: 0; font-size: 15px">Ou écrivez à <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a></p>
      </div>
    </div>
  </section>
</Base>

<style>
  .tf-head { max-width: 760px; display: grid; gap: 14px; margin-bottom: 32px; }
  .tf-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
  @media (max-width: 1000px) { .tf-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .tf-grid { grid-template-columns: 1fr; } }
  .tf-c { display: flex; flex-direction: column; gap: 8px; padding: 24px 22px; border-radius: 22px; background: var(--pearl); color: var(--ink); text-decoration: none !important; transition: transform .3s var(--ease); }
  .tf-c:hover { transform: translateY(-3px); }
  .tf-c.tf-on { background: #000; color: #fff; }
  .tf-k { font-size: 12.5px; font-weight: 600; color: var(--muted); } .tf-on .tf-k { color: rgba(255,255,255,.6); }
  .tf-p { font-size: 30px; letter-spacing: -0.04em; line-height: 1.1; } .tf-p small { font-size: 15px; font-weight: 500; letter-spacing: 0; }
  .tf-c strong { font-size: 16px; letter-spacing: -0.01em; }
  .tf-c > span:last-child { font-size: 14px; line-height: 1.45; color: var(--muted); } .tf-on > span:last-child { color: rgba(255,255,255,.7); }
  .tf-g { margin: 18px 0 0; font-size: 14px; color: var(--muted); }

  .est { padding: 8px 22px; overflow-x: auto; }
  .est table { width: 100%; border-collapse: collapse; font-size: 15px; min-width: 460px; }
  .est th { text-align: left; font-size: 12px; letter-spacing: 0; color: var(--dim); font-weight: 600; padding: 12px 8px; border-bottom: 1px solid var(--line); }
  .est td { padding: 13px 8px; border-bottom: 1px solid var(--line-soft); vertical-align: top; }
  .est td.num { white-space: nowrap; font-weight: 600; color: var(--text-strong); }
  .est tr:last-child td { border-bottom: 0; }
</style>
