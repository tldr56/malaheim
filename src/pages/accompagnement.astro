---
import Base from '../layouts/Base.astro';
import Offer from '../components/Offer.astro';
import { SITE } from '../config';
const bookHref = SITE.bookingUrl || '/a-propos/#contact';
const eur = (n: number) => `${n.toLocaleString('fr-FR')} €`;
const estimates = [
  { t: 'Valider le besoin et le bon type de logiciel', h: [2, 4] },
  { t: 'Préparer et animer les démonstrations de 3 éditeurs', h: [6, 10] },
  { t: 'Analyser 3 offres et préparer la négociation', h: [6, 10] },
  { t: 'Accompagner toute la consultation, du kit au contrat', h: [20, 35] },
  { t: 'Piloter le démarrage après la signature', h: [4, 8], unit: 'par mois' },
].map((e) => ({ ...e, cost: `${eur(e.h[0] * SITE.hourlyNum)} à ${eur(e.h[1] * SITE.hourlyNum)} HT${e.unit ? ' ' + e.unit : ''}` }));
const why = [
  { t: 'Vous faites le gros du travail', d: 'Le kit remplace le travail d’une équipe achats : exigences rédigées, priorités pré-remplies, courriers prêts.' },
  { t: 'Vous achetez seulement l’expertise', d: 'Les heures servent aux moments qui décident : démonstrations, analyse des offres, négociation, démarrage.' },
  { t: 'Vous gardez la main sur le budget', d: 'Estimation écrite avant de commencer, décompte au quart d’heure, aucun dépassement sans votre accord.' },
];
const lags = ['', 'lag1', 'lag2'];
---
<Base title="Tarifs" description={`Kit de consultation à ${SITE.kitPrice}, relecture de cahier des charges à ${SITE.reviewPrice}, accompagnement à ${SITE.hourlyRate} de l'heure au temps réellement passé. Une offre adaptée à toutes les tailles d'entreprise.`}>
  <section class="wrap stack" style="padding-block: 72px 56px; gap: 18px; max-width: 900px; margin-inline: auto">
    <p class="eyebrow rise">Tarifs</p>
    <h1 class="h1 rise d1" style="font-size: clamp(40px, 5vw, 64px)">Trois marches, vous ne montez que si besoin</h1>
    <p class="lead rise d2">Qui que vous soyez, quelle que soit la taille de votre entreprise, vous ne payez que ce dont vous avez besoin. Vous commencez seul avec le kit, vous demandez une relecture si vous voulez un second avis, et vous faites appel à moi à l'heure pour les moments qui comptent.</p>
  </section>

  <section class="wrap" style="padding-bottom: 96px">
    <Offer />
  </section>

  <section class="section section-alt" aria-labelledby="titre-heures">
    <div class="wrap row" style="gap: 56px; align-items: flex-start">
      <div class="stack sr-left" style="flex: 1 1 340px; gap: 16px">
        <p class="eyebrow">L'accompagnement à l'heure</p>
        <h2 id="titre-heures" class="h2">Combien d'heures pour quoi ?</h2>
        <p class="lead" style="font-size: 17px">Des ordres de grandeur pour un projet courant, à {SITE.hourlyRate} de l'heure. Vous recevez une estimation écrite avant de commencer, puis un relevé détaillé chaque mois. Seul le temps réellement passé est facturé.</p>
      </div>
      <div class="card sr-right est" style="flex: 1 1 560px">
        <table>
          <thead><tr><th>Mission</th><th>Heures</th><th>Soit environ</th></tr></thead>
          <tbody>
            {estimates.map((e) => (
              <tr><td>{e.t}</td><td class="num">{e.h[0]} à {e.h[1]} h{e.unit ? ' ' + e.unit : ''}</td><td class="num">{e.cost}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="titre-pourquoi">
    <div class="wrap stack" style="gap: 36px">
      <h2 id="titre-pourquoi" class="h2 sr-up" style="max-width: 18em">Pourquoi à l'heure plutôt qu'au forfait ?</h2>
      <div class="row" style="gap: 20px">
        {why.map((w, i) => (
          <div class={`card sr-up ${lags[i]}`} style="flex: 1 1 280px; padding: 26px; display: flex; flex-direction: column; gap: 10px">
            <h3 class="h3" style="font-size: 20px">{w.t}</h3>
            <p style="margin: 0; color: var(--muted); font-size: 15px">{w.d}</p>
          </div>
        ))}
      </div>
      <p class="dim sr-up" style="margin: 0; font-size: 15px">Le même taux horaire s'applique au <a href="/conseil/">conseil</a> : diagnostic, schéma directeur, direction de projet.</p>
    </div>
  </section>

  <section id="contact" aria-labelledby="titre-contact" style="padding: 0 0 140px">
    <div class="wrap">
      <div class="stack center sr-zoom" style="background: var(--gold); color: #141619; border-radius: 32px; padding: 64px 40px; gap: 18px">
        <h2 id="titre-contact" class="h2" style="color: #141619">Parlons de votre projet en 30 minutes</h2>
        <p style="margin: 0; font-size: 18px; max-width: 32em">Un appel gratuit pour cadrer votre besoin, savoir si le kit suffit, et estimer les heures si vous voulez être accompagné. Sans engagement.</p>
        <a class="btn btn-dark btn-lg" href={bookHref}>Réserver un appel <span class="arrow" aria-hidden="true">→</span></a>
        <p style="margin: 0; font-size: 15px">Ou écrivez à {SITE.contactEmail}</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .est { padding: 8px 22px; overflow-x: auto; }
  .est table { width: 100%; border-collapse: collapse; font-size: 15px; min-width: 460px; }
  .est th { text-align: left; font-size: 12px; text-transform: uppercase; letter-spacing: .05em; color: var(--dim); font-weight: 600; padding: 12px 8px; border-bottom: 1px solid var(--line); }
  .est td { padding: 13px 8px; border-bottom: 1px solid var(--line-soft); vertical-align: top; }
  .est td.num { white-space: nowrap; font-weight: 600; color: var(--text-strong); }
  .est tr:last-child td { border-bottom: 0; }
</style>
