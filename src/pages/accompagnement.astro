---
import Base from '../layouts/Base.astro';
import { SITE } from '../config';
const bookHref = SITE.bookingUrl || '/a-propos/#contact';
const offers = [
  {
    k: 'Relecture',
    t: 'Revue de votre cahier des charges',
    p: SITE.reviewPrice,
    d: "Vous m'envoyez votre cahier des charges. Je le relis et je l'annote : exigences floues, volumétrie manquante, pièges contractuels. Puis une heure de visio pour corriger le tir avant l'envoi aux éditeurs.",
    items: ['Annotations sous 5 jours ouvrés', 'Une heure de visio', 'Prix du kit déduit si vous l\'avez acheté'],
    hi: true,
  },
  {
    k: 'Consultation',
    t: 'Accompagnement du choix',
    p: 'Sur devis',
    d: "Je conduis la consultation avec vous, du cahier des charges au choix de l'éditeur : présélection, démonstrations sur vos scénarios, analyse des offres, négociation.",
    items: ['Cahier des charges finalisé', 'Démonstrations scénarisées', 'Analyse comparée des offres', 'Appui à la négociation'],
    hi: false,
  },
  {
    k: 'Projet',
    t: 'Pilotage du déploiement',
    p: 'Sur devis',
    d: "Je pilote le projet côté client après la signature : conception, données de référence, recette, formation et démarrage.",
    items: ['Arbitrage du spécifique', 'Campagne de recette', 'Préparation du démarrage'],
    hi: false,
  },
];
const lags = ['', 'lag1', 'lag2'];
---
<Base title="Accompagnement WMS" description="Revue de cahier des charges WMS, accompagnement du choix de l'éditeur et pilotage du déploiement, par un consultant WMS indépendant basé à Rennes.">
  <section class="wrap stack" style="padding-block: 72px 56px; gap: 18px; max-width: 900px; margin-inline: auto">
    <p class="eyebrow rise">Accompagnement</p>
    <h1 class="h1 rise d1" style="font-size: clamp(40px, 5vw, 64px)">Un regard expérimenté là où une erreur coûte cher</h1>
    <p class="lead rise d2">Les outils du site suffisent pour avancer seul. Quand l'enjeu dépasse quelques centaines de milliers d'euros, un second avis sur le cahier des charges ou sur les offres se rembourse vite.</p>
  </section>

  <section class="wrap" style="padding-bottom: 104px">
    <div class="row" style="gap: 22px; align-items: stretch">
      {offers.map((o, i) => (
        <div class={`card card-lift sr-up ${lags[i]} ${o.hi ? 'card-hi' : ''}`} style="flex: 1 1 320px; padding: 30px; display: flex; flex-direction: column; gap: 14px">
          <span class={o.hi ? 'eyebrow' : 'dim'} style="font-size: 13px; text-transform: uppercase; letter-spacing: .08em">{o.k}</span>
          <h2 class="h3">{o.t}</h2>
          <span style="font-size: 32px; font-weight: 600" class="gold">{o.p}</span>
          <p style="margin: 0; color: var(--muted); font-size: 15px">{o.d}</p>
          <ul style="margin: 0; padding-left: 1.2em; color: var(--text); font-size: 15px; display: flex; flex-direction: column; gap: 6px">
            {o.items.map((it) => <li>{it}</li>)}
          </ul>
          <a class={`btn ${o.hi ? 'btn-gold' : 'btn-line'}`} href="#contact" style="margin-top: auto; align-self: flex-start">{o.hi ? 'Demander une relecture' : 'En parler'}</a>
        </div>
      ))}
    </div>
  </section>

  <section id="contact" aria-labelledby="titre-contact" style="padding: 0 0 140px">
    <div class="wrap">
      <div class="stack center sr-zoom" style="background: var(--gold); color: var(--bg); border-radius: 32px; padding: 64px 40px; gap: 18px">
        <h2 id="titre-contact" class="h2" style="color: var(--bg)">Parlons de votre projet en 30 minutes</h2>
        <p style="margin: 0; font-size: 18px; max-width: 32em">Un appel gratuit pour cadrer votre besoin et savoir si un accompagnement est utile. Sans engagement.</p>
        <a class="btn btn-dark btn-lg" href={bookHref}>Réserver un appel <span class="arrow" aria-hidden="true">→</span></a>
        <p style="margin: 0; font-size: 15px">Ou écrivez à {SITE.contactEmail}</p>
      </div>
    </div>
  </section>
</Base>
