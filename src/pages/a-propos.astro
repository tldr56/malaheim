---
import Base from '../layouts/Base.astro';
import { SITE } from '../config';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.author,
  jobTitle: 'Consultant supply chain indépendant',
  address: { '@type': 'PostalAddress', addressLocality: 'Rennes', addressCountry: 'FR' },
  knowsAbout: ['WMS', 'WCS', 'TMS', 'ERP', 'Automatisation logistique', 'Intégration d\'usines', 'Données de référence', 'Recette', 'Conduite du changement'],
  worksFor: { '@type': 'Organization', name: SITE.company },
};
---
<Base title="À propos" description="Robin Thomas-Le Déoré, fondateur de MALAHEIM Consulting, consultant supply chain indépendant à Rennes : sélection de logiciels, WMS et WCS, intégration d'usines, pilotage de projets SI." jsonLd={jsonLd}>
  <section class="wrap row" style="gap: 64px; align-items: center; padding-block: 88px">
    <div class="photo slide-in" role="img" aria-label="Emplacement de la photo de Robin Thomas-Le Déoré">[Votre photo]</div>
    <div class="stack" style="flex: 1 1 480px; min-width: 0; gap: 20px">
      <p class="eyebrow rise">À propos</p>
      <h1 class="h2 rise d1">{SITE.author}</h1>
      <p class="lead rise d2">Consultant supply chain indépendant à Rennes, fondateur de {SITE.company}. Je dirige des projets de systèmes d'information logistiques et industriels : sélection et déploiement de WMS et de WCS, intégration d'usines, montées de version, pilotage d'équipes, données de référence et campagnes de recette.</p>
      <p class="lead rise d3">Passé par GEODIS et KPMG, j'ai aussi mené des projets de maintenance prédictive et de direction de projets digitaux dans l'industrie. J'enseigne la logistique en master.</p>
      <p class="lead rise d4">Malaheim rassemble ce que j'aurais aimé trouver au début de chaque projet : des ordres de grandeur honnêtes, une méthode, et des outils prêts à servir, pour tous les logiciels de la supply chain.</p>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="titre-engagements">
    <div class="wrap stack" style="gap: 40px">
      <h2 id="titre-engagements" class="h2 sr-up">Trois engagements</h2>
      <div class="row" style="gap: 20px">
        <div class="card sr-up" style="flex: 1 1 300px; padding: 26px; display: flex; flex-direction: column; gap: 10px">
          <h3 class="h3 gold">Indépendance</h3>
          <p style="margin: 0; color: var(--muted)">Aucun éditeur ne paie pour être cité ou recommandé. Tout partenariat commercial éventuel est affiché sur la page concernée.</p>
        </div>
        <div class="card sr-up lag1" style="flex: 1 1 300px; padding: 26px; display: flex; flex-direction: column; gap: 10px">
          <h3 class="h3 gold">Chiffres sourcés</h3>
          <p style="margin: 0; color: var(--muted)">Les fourchettes du simulateur et des guides reposent sur des sources publiées, listées sous le simulateur, et sont révisées à chaque retour de projet.</p>
        </div>
        <div class="card sr-up lag2" style="flex: 1 1 300px; padding: 26px; display: flex; flex-direction: column; gap: 10px">
          <h3 class="h3 gold">Confidentialité</h3>
          <p style="margin: 0; color: var(--muted)">Les documents que vous me confiez ne servent qu'à votre projet. Aucun livrable client n'est réutilisé sans anonymisation complète.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="contact" aria-labelledby="titre-contact" class="section">
    <div class="wrap stack center" style="gap: 18px">
      <h2 id="titre-contact" class="h2 sr-up">Me contacter</h2>
      <p class="lead sr-up lag1" style="text-align: center">Une question sur un projet, un retour sur le simulateur, une proposition de partenariat : écrivez-moi à {SITE.contactEmail}.</p>
      <a class="btn btn-gold sr-up lag2" href="/accompagnement/#contact">Réserver un appel de 30 min</a>
    </div>
  </section>
</Base>

<style>
  .photo { flex: 0 1 340px; aspect-ratio: 4 / 5; background: var(--card); border: 1px dashed #b9b0a0; border-radius: 24px; display: flex; align-items: center; justify-content: center; color: var(--dim); }
</style>
