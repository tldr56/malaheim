---
import Base from '../layouts/Base.astro';
import { SITE, KITS, SOFTWARE } from '../config';
const kitTotal = KITS.reduce((n, k) => n + k.reqs, 0);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: SITE.company,
  url: SITE.url,
  description: 'Cabinet de conseil indépendant en logiciels supply chain et transformation digitale.',
  address: { '@type': 'PostalAddress', addressLocality: 'Rennes', addressCountry: 'FR' },
  areaServed: 'FR',
  knowsAbout: ['WMS', 'WCS', 'TMS', 'ERP', 'OMS', 'S&OP', 'Automatisation logistique', "Intégration d'usines", 'Données de référence', 'Recette', 'Conduite du changement'],
};
const facts = [
  { n: String(SOFTWARE.length), t: 'familles de logiciels' },
  { n: kitTotal.toLocaleString('fr-FR'), t: 'exigences rédigées' },
  { n: '0 €', t: 'de commission éditeur' },
  { n: '48 h', t: 'pour vous répondre' },
];
---
<Base title="Le cabinet" description="MALAHEIM Consulting, cabinet de conseil indépendant en logiciels supply chain : sélection et déploiement de WMS, TMS, ERP, OMS, S&OP, automatisation et données, pour toutes les entreprises, à un prix adapté." jsonLd={jsonLd}>
  <section class="wrap row" style="gap: 64px; align-items: center; padding-block: 88px">
    <div class="stack" style="flex: 1 1 520px; min-width: 0; gap: 20px">
      <p class="eyebrow rise">Le cabinet</p>
      <h1 class="h1 rise d1" style="font-size: clamp(40px, 5vw, 68px)">La méthode des grands projets, à la taille du vôtre</h1>
      <p class="lead rise d2">{SITE.company} est un cabinet de conseil indépendant en systèmes d'information supply chain. Il accompagne les entreprises dans le choix et le déploiement de leurs logiciels : gestion d'entrepôt, transport, gestion, commandes, planification, automatismes et données de référence.</p>
      <p class="lead rise d3">Son expertise s'est forgée dans le conseil, la logistique, l'industrie et la banque, sur des projets de sélection de WMS et de WCS, d'intégration d'usines, de montées de version, de données de référence et de recette.</p>
      <p class="lead rise d4">Malaheim rassemble ce qui manque au début de chaque projet : des ordres de grandeur honnêtes, une méthode éprouvée et des outils prêts à servir, vendus au juste prix.</p>
    </div>
    <div class="facts sr-right" aria-label="Le cabinet en chiffres">
      {facts.map((f) => (
        <div class="fact"><span class="fact-n">{f.n}</span><span class="fact-t">{f.t}</span></div>
      ))}
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="titre-engagements">
    <div class="wrap stack" style="gap: 40px">
      <h2 id="titre-engagements" class="h2 sr-up">Trois engagements</h2>
      <div class="row" style="gap: 20px">
        <div class="card sr-up" style="flex: 1 1 300px; padding: 26px; display: flex; flex-direction: column; gap: 10px">
          <h3 class="h3 gold">Indépendance</h3>
          <p style="margin: 0; color: var(--muted)">Aucun éditeur ne paie pour être cité ou recommandé. Tout partenariat commercial éventuel est affiché sur la page concernée.</p>
        </div>
        <div class="card sr-up lag1" style="flex: 1 1 300px; padding: 26px; display: flex; flex-direction: column; gap: 10px">
          <h3 class="h3 gold">Chiffres sourcés</h3>
          <p style="margin: 0; color: var(--muted)">Les fourchettes du simulateur et des guides reposent sur des sources publiées, listées sous le simulateur, et sont révisées à chaque retour de projet.</p>
        </div>
        <div class="card sr-up lag2" style="flex: 1 1 300px; padding: 26px; display: flex; flex-direction: column; gap: 10px">
          <h3 class="h3 gold">Confidentialité</h3>
          <p style="margin: 0; color: var(--muted)">Les documents que vous nous confiez ne servent qu'à votre projet. Aucun livrable client n'est réutilisé sans anonymisation complète.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="contact" aria-labelledby="titre-contact" class="section">
    <div class="wrap stack center" style="gap: 18px">
      <h2 id="titre-contact" class="h2 sr-up">Nous contacter</h2>
      <p class="lead sr-up lag1" style="text-align: center">Une question sur un projet, un retour sur le simulateur, une proposition de partenariat : écrivez-nous à <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>.</p>
      <a class="btn btn-gold sr-up lag2" href="/accompagnement/#contact">Réserver un appel de 30 min</a>
    </div>
  </section>
</Base>

<style>
  .facts { flex: 0 1 400px; display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: rgba(255,255,255,.14); border-radius: 28px; overflow: hidden; box-shadow: 0 40px 80px -40px rgba(19,33,58,.7); }
  .fact { display: flex; flex-direction: column; gap: 6px; padding: 30px 26px; background: #000; }
  .fact-n { font-family: var(--display); font-weight: 700; letter-spacing: -0.045em; font-size: 44px; line-height: 1; color: #fff; }
  .fact-t { color: rgba(255,255,255,.6); font-size: 14.5px; }
</style>
