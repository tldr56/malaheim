---
import Base from './Base.astro';
import { SITE, GUIDES, KITS, SOFTWARE } from '../config';
import { SIM_LIST } from '../lib/sims.js';

const { frontmatter } = Astro.props;
const { title, description, slug, updated, readingTime, cta, sw = 'wms' } = frontmatter;
const transverse = sw === 'transverse';
const soft = SOFTWARE.find((x) => x.slug === sw) ?? { code: 'Technique', slug: 'transverse', name: 'Socle technique' };
const kit = KITS.find((k) => k.sw === sw);
const sim = SIM_LIST.find((m) => m.sw === sw);
const me = GUIDES.find((g) => g.slug === slug);
const family = GUIDES.filter((g) => g.sw === sw && g.slug !== slug);
const others = transverse ? GUIDES.filter((g) => g.kind === 'Technique' && g.sw !== 'transverse').slice(0, 4) : [...family, ...GUIDES.filter((g) => g.slug === 'exigences-techniques-communes'), ...GUIDES.filter((g) => g.sw !== sw && g.kind === 'Prix')].slice(0, 4);
const useSim = sim && (cta === 'simulateur' || me?.kind === 'Prix' || me?.kind === 'Choix');
const c = useSim
  ? { title: sim.card, text: `${sim.lead}`, href: `/simulateurs/${sim.slug}/`, label: `Lancer le simulateur ${sim.code}` }
  : !kit ? { title: 'Les 7 kits de consultation', text: 'Chaque kit contient un cahier des charges complet, exigences techniques comprises, les scénarios de démonstration, la grille de dépouillement et la check-list contractuelle.', href: '/kits/', label: `Voir les kits, ${SITE.kitPrice}` }
  : { title: `Le kit de consultation ${soft.code}`, text: `${kit.reqs} exigences commentées, scénarios de démonstration imposés, grille de dépouillement, check-list contractuelle et plan de recette.`, href: `/kits/${kit.page}/`, label: `Voir le kit, ${SITE.kitPrice}` };
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  inLanguage: 'fr-FR',
  dateModified: updated,
  author: { '@type': 'Organization', name: SITE.company, url: SITE.url },
  publisher: { '@type': 'Organization', name: SITE.name },
};
const updatedLabel = new Date(updated).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <article class="wrap guide-page">
    <nav class="crumbs rise" aria-label="Fil d'Ariane"><a href="/">Accueil</a><span aria-hidden="true">/</span><a href="/guides/">Guides</a><span aria-hidden="true">/</span><a href={transverse ? '/guides/' : `/guides/#${sw}`}>{soft.code}</a></nav>
    <header class="stack guide-head">
      <p class="eyebrow rise d1">{transverse ? 'Guide technique' : `Guide ${soft.code}`}</p>
      <h1 class="h2 rise d2">{title}</h1>
      <p class="lead rise d3">{description}</p>
      <p class="byline rise d4">Par {SITE.company}. Mis à jour le {updatedLabel}. Lecture : {readingTime} min.</p>
    </header>
    <div class="guide-body">
      <div class="prose rise d4"><slot /></div>
      <aside class="guide-side">
        <div class="card card-hi side-cta">
          <span class="eyebrow" style="font-size: 12px">Passez à l'action</span>
          <h2 class="h3">{c.title}</h2>
          <p>{c.text}</p>
          <a class="btn btn-gold btn-sm" href={c.href}>{c.label}</a>
          {useSim && kit && <a class="side-more" href={`/kits/${kit.page}/`}>Le kit de consultation {soft.code}, {SITE.kitPrice}</a>}
          {!useSim && sim && <a class="side-more" href={`/simulateurs/${sim.slug}/`}>Estimer votre budget avec le simulateur {soft.code}</a>}
        </div>
      </aside>
    </div>
    <section class="more" aria-labelledby="titre-autres">
      <h2 id="titre-autres" class="h3 sr-up">À lire ensuite</h2>
      <div class="row more-list">
        {others.map((g, i) => (
          <a class={`card card-lift more-item sr-up ${['', 'lag1', 'lag2', 'lag3'][i]}`} href={`/guides/${g.slug}/`}>
            <span class="more-k">{SOFTWARE.find((x) => x.slug === g.sw)?.code ?? 'Socle commun'}, {g.kind.toLowerCase()}</span>
            <span style="font-weight: 600">{g.title}</span>
            <span class="gold" style="font-size: 14px; margin-top: auto">Lire</span>
          </a>
        ))}
      </div>
    </section>
  </article>
</Base>

<style>
  .guide-page { padding-block: 48px 120px; display: flex; flex-direction: column; gap: 40px; }
  .crumbs { display: flex; gap: 10px; font-size: 14px; color: var(--dim); }
  .crumbs a { color: var(--dim); text-decoration: none; }
  .crumbs a:hover { color: var(--text); }
  .guide-head { gap: 18px; max-width: 820px; }
  .byline { margin: 0; color: var(--dim); font-size: 14px; }
  .guide-body { display: flex; flex-wrap: wrap; gap: 56px; align-items: flex-start; }
  .guide-body .prose { flex: 1 1 560px; min-width: 0; }
  .guide-side { flex: 0 1 320px; position: sticky; top: 96px; }
  @media (max-width: 960px) { .guide-side { position: static; flex-basis: 100%; } }
  .side-cta { padding: 24px; display: flex; flex-direction: column; gap: 12px; }
  .side-cta p { margin: 0; color: var(--muted); font-size: 15px; }
  .side-cta .btn { align-self: flex-start; }
  .more { display: flex; flex-direction: column; gap: 20px; padding-top: 40px; border-top: 1px solid var(--line-soft); }
  .more-list { gap: 16px; }
  .more-item { flex: 1 1 240px; padding: 24px; display: flex; flex-direction: column; gap: 8px; text-decoration: none !important; color: var(--text); }
  .more-k { font-size: 13px; color: var(--dim); font-weight: 600; }
  .side-more { font-size: 14px; }
</style>
