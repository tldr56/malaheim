---
import '@fontsource-variable/archivo/wdth.css';
import '../styles/global.css';
import { SITE } from '../config';

interface Props {
  title: string;
  description: string;
  dock?: boolean;
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}
const { title, description, dock = true, jsonLd, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const fullTitle = path === '/' ? `${SITE.name} | Choisir son logiciel supply chain : WMS, TMS, ERP` : `${title} | ${SITE.name}`;
const nav = [
  { href: '/logiciels/', label: 'Logiciels' },
  { href: '/simulateurs/', label: 'Simulateurs' },
  { href: '/conseil/', label: 'Conseil' },
  { href: '/kits/', label: 'Kits' },
  { href: '/guides/', label: 'Guides' },
  { href: '/a-propos/', label: 'À propos' },
];
import Logo from '../components/Logo.astro';
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  {noindex && <meta name="robots" content="noindex">}
  <link rel="canonical" href={canonical}>
  <meta property="og:type" content="website">
  <meta property="og:locale" content="fr_FR">
  <meta property="og:site_name" content={SITE.name}>
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta name="theme-color" content="#eef1f4">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  <script is:inline>
    (function () {
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var native = window.CSS && CSS.supports && CSS.supports('animation-timeline: view()');
      if (!reduce && !native && 'IntersectionObserver' in window) document.documentElement.classList.add('io');
    })();
  </script>
</head>
<body>
  <a class="skip" href="#contenu">Aller au contenu</a>
  <header class="topbar">
    <div class="wrap topbar-in">
      <a class="brand" href="/" aria-label="Malaheim Consulting, accueil">
        <Logo variant="lockup" />
      </a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="nav">Menu</button>
      <nav class="nav" id="nav" aria-label="Navigation principale">
        {nav.map((n) => (
          <a class="navlink" href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>
        ))}
        <a class="btn btn-gold btn-sm" href="/#orientation">Trouver mon logiciel</a>
      </nav>
    </div>
  </header>

  <main id="contenu">
    <slot />
  </main>

  <footer class="footer">
    <div class="wrap footer-in">
      <div class="foot-brand"><Logo variant="full" /><span>© {new Date().getFullYear()} {SITE.company}. Chiffrages indicatifs en euros hors taxes.</span></div>
      <nav aria-label="Liens légaux">
        <a href="/compte/">Mon espace client</a>
        <a href="/accompagnement/">Tarifs</a>
        <a href="/mentions-legales/">Mentions légales</a>
        <a href="/confidentialite/">Confidentialité</a>
        <a href="/conditions-de-vente/">Conditions de vente</a>
        <a href="/a-propos/#contact">Contact</a>
      </nav>
    </div>
  </footer>

  {dock && (
    <div class="dock" id="dock" role="complementary" aria-label="Accès rapide à l'orientation">
      <span class="dock-text">Quel logiciel vous faut-il ?</span>
      <a class="btn btn-gold btn-sm" href="/#orientation">Trouver mon logiciel <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  )}

  <script is:inline>
    (function () {
      var btn = document.querySelector('.menu-btn'), nav = document.getElementById('nav');
      if (btn && nav) btn.addEventListener('click', function () {
        var open = nav.classList.toggle('open');
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
      var dock = document.getElementById('dock');
      if (dock) {
        var onScroll = function () { dock.classList.toggle('on', window.scrollY > 600); };
        window.addEventListener('scroll', onScroll, { passive: true }); onScroll();
      }
      if (document.documentElement.classList.contains('io')) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
        }, { rootMargin: '0px 0px -12% 0px' });
        document.querySelectorAll('.sr-up,.sr-down,.sr-left,.sr-right,.sr-zoom,.track-fill').forEach(function (el) { io.observe(el); });
      }
    })();
  </script>
</body>
</html>
